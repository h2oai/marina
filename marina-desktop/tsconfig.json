{
  "extends": ["./.hutch/tsconfig.sdk.json", "../tsconfig.json"],
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "electrobun.config.ts",
    "hutch.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
