{
  "name": "marina-desktop",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electrobun build --env=dev --run",
    "build:canary": "electrobun build --env=canary",
    "build:stable": "electrobun build --env=stable",
    "build:dashboard": "bunx vite build --config vite.desktop.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "electrobun": "^1.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "1.3.14",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "^8.0.16"
  }
}
