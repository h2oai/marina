# Marina Server Configuration
# Copy this file to .env and customize as needed.
# All variables are optional — sensible defaults are used if not set.

# ─── Network ────────────────────────────────────────────────────────────────

# WebSocket + web chat port. 0 = pick a free ephemeral port (announced in the
# boot banner) — the WS/HTTP server is the primary surface and can't be disabled.
WS_PORT=3300

# Telnet port. 0 = disabled (lets many Marina instances share one machine).
TELNET_PORT=4000

# MCP (Model Context Protocol) server port. 0 = disabled.
MCP_PORT=3301

# Log server port (real-time event viewer). 0 = disabled.
LOG_PORT=3302

# OpenAI / Ollama drop-in clients connect on WS_PORT above — Marina serves
# /v1/chat/completions, /v1/responses, /v1/models, /v1/health, and the /api/*
# Ollama routes there. Compatibility is by model-id alias (MARINA_COMPAT
# below), not a separate port. Point OpenWebUI/LobeChat/any OpenAI SDK at WS_PORT.

# Max concurrent WebSocket connections allowed per client IP. Default: 100.
# WS_MAX_CONNECTIONS_PER_IP=100

# When NODE_ENV=production and neither HTTPS_PROXY nor REVERSE_PROXY is set,
# Marina logs a startup hint that TLS wasn't detected. Set either var (their
# value is not used — only their presence) to acknowledge a TLS-terminating
# proxy is in front and silence the hint.
# REVERSE_PROXY=1

# ─── API Authentication ──────────────────────────────────────────────────
# By default, API endpoints require authentication. For local development,
# set MARINA_OPEN_API=true to accept unauthenticated requests. This also
# relaxes the dashboard/asset/canvas API auth gate, so admin actions (e.g.
# adding API keys in the dashboard) work without an interactive login.
# A valid session token is still honored when present. Do NOT enable in
# production — it exposes admin endpoints to anyone who can reach the port.
# MARINA_OPEN_API=true

# Comma-separated bearer tokens for the /v1/* and /api/* LLM endpoints.
# MODEL_API_KEYS=sk-marina-abc123,sk-marina-def456

# Comma-separated secret:agent pairs for the /mem REST endpoint.
# MEM_API_KEYS=sk-agent-1:scout,sk-agent-2:archivist

# Encrypt provider API keys stored via the Admin → Keys panel at rest
# (AES-256-GCM). >= 16 chars; generate with `openssl rand -base64 32`. Without
# it, DB-stored keys are plaintext — prefer the provider env vars below, which
# are never persisted. WARNING: losing/changing this secret orphans stored keys
# (they must be re-entered). Admin → Security shows the live state.
# MARINA_KEY_SECRET=

# ─── Optional External Auth (better-auth) ──────────────────────────────────
# OFF by default. When set to "better-auth", human sign-in is required on the
# webchat/dashboard (email/password + any configured social providers), and the
# unsafe passwordless name-login is rejected. The verified identity is BRIDGED
# to a *named* Marina entity (the artilect) — the entity stays the in-world
# identity. Agents are unaffected: they keep authenticating with session tokens
# (and internal room/crew agents with the internal token). Requires the optional
# `better-auth` dependency (installed via optionalDependencies).
# MARINA_AUTH=better-auth

# Required when MARINA_AUTH=better-auth. >= 32 chars; generate with `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# Public base URL of this instance (defaults to http://localhost:$WS_PORT).
# BETTER_AUTH_URL=https://marina.example.com
# Dedicated sqlite file for the auth tables (kept separate from the main DB).
# BETTER_AUTH_DB_PATH=marina-auth.db

# Admin allowlist by VERIFIED email (replaces name-based MARINA_ADMINS when auth
# is on). Only verified identities (OAuth, or email/password with verification)
# can be promoted — closes the name-based admin hole.
# MARINA_AUTH_ADMIN_EMAILS=you@company.com,ops@company.com

# Social OAuth providers (Phase 1) — set both id+secret to enable each.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Dashboard / API Security ────────────────────────────────────────────
# Comma-separated allowed origins for CORS.
# When unset, no Access-Control-Allow-Origin header is sent (same-origin only).
# Set this if your dashboard or clients run on a different origin.
# ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.example.com

# ─── Gateway Federation ──────────────────────────────────────────────────
# Shared secret for gateway-to-gateway authentication.
# When set, outgoing gateway connections send this secret on connect,
# and incoming gateway connections must present it within 5 seconds or be dropped.
# Both sides must use the same value. Leave unset for open federation.
# GATEWAY_SECRET=

# ── Instance Identity ────────────────────────────────────────────────────────
# Human-readable name for this instance (shown in dashboard topbar).
# Defaults to the world name if not set.
# MARINA_NAME=Marina

# ─── World & Engine ─────────────────────────────────────────────────────────

# World definition to load (see worlds/ directory)
# Available: default (reactive Workbench), showcase (full 25-room world),
#            prediction-lab, deep-research, red-team, due-diligence,
#            data-investigation, commons, research, personal, evolve, craft,
#            markets, demos, empty
# MARINA_WORLD=default

# Model for the default Workbench's Host/Builder/Critic/Chronicler population.
# When unset, Marina prefers OPENAI_API_KEY, then OPENROUTER_API_KEY, then its
# normal marina/default route. MARINA_CREW_MODEL is also honored as a shared
# override across Workbench and Showcase.
# MARINA_WORKBENCH_MODEL=openai/gpt-4o-mini

# Verified binary arithmetic can return immediately from marina:answerer while
# ambiguous/complex requests still route through the autonomous crew.
# MARINA_MODEL_FAST_PATH=false

# Token/activity controls. Request-driven agents default to 2048 output tokens;
# one run yields after 8 tool calls (16 for autonomous agents); quiet autonomous
# cycles wait at least 60s. Override only when a workload proves it needs more.
# AGENT_CREW_MAX_TOKENS=2048
# AGENT_COMPACT_MAX_TOKENS=4096
# AGENT_MAX_TOOL_CALLS_PER_RUN=8
# AGENT_IDLE_TICK_MS=60000
# AGENT_ACTIVE_TICK_MS=15000
# AGENT_CHANNEL_REPLY_COOLDOWN_MS=30000

# Comma-separated allow-list of drop-in compatibility profiles whose model-id
# aliases surface in /v1/models (ships with one profile: "openai", which exposes
# the "assistant" alias). Default: all registered profiles. Set to "none" to
# disable compat aliases entirely.
# MARINA_COMPAT=openai

# Set to "false" to disable LLM synthesis in the `ask` command, leaving it as a
# retrieval-only pull (personal + guide + pool + world-search context, no model
# call). Any other value (or unset) keeps synthesis on.
# MARINA_ASK_MODEL=false

# Engine tick interval in milliseconds (how often rooms update)
TICK_MS=1000

# Room where new players spawn (defaults to world definition's startRoom)
# START_ROOM=hub/crossroads

# Set to "false" to suppress all room-agent auto-spawn (LLM-connected agents that
# rooms spawn on first entry). Use for cost-controlled demos or explicit-only
# populations. Any other value (or unset) leaves auto-spawn enabled.
# MARINA_ROOM_AGENTS=false

# Native evolution protocols — optional, passive experiment lineage and robust
# evidence analysis layered over the existing experiment command. OFF by
# default. Enabling this does not auto-run, auto-prompt, or auto-promote work.
# MARINA_EVOLUTION_PROTOCOLS=true

# Which orchestration coordinator endpoints to seed beyond marina:answerer.
# Each of Councilor/Debater/Decomposer is an AUTONOMOUS loop that spends tokens
# even when its marina:council / marina:debate / marina:decompose endpoint is
# never called. If you only consume marina:answerer, seed fewer (or none) to
# stop the idle burn. Unset = all three (backward-compatible). Comma list seeds
# exactly those; empty or "none" seeds none. Specialists (Historian/Scholar/
# Skeptic/Verifier) and the answerer crew are unaffected (cheap crew-responders;
# answerer count is MARINA_ANSWERER_COUNT). Disabling removes the coordinator's
# saved config so it won't respawn.
# MARINA_ENDPOINTS=decompose

# Unified Canvas — a heavy alternate dashboard interface (ReactFlow world graph),
# retired from the standard dashboard. OFF by default. Set to "true" to make it
# reachable as a standalone surface at /?unified; when unset/false that URL
# redirects back to the standard dashboard. Surfaced via the open /api/ui-config.
# MARINA_UNIFIED_CANVAS=true

# SQLite database file path
DB_PATH=marina.db

# ─── Code Mode (the `code` command) ────────────────────────────────────────
# Code Mode lets entities run path-confined coding sessions against a local
# workspace (inspect, diff, run allowlisted commands, propose/apply patches,
# checkpoint/revert). Two env vars bound where sessions may operate:
#
#   MARINA_CODE_ROOTS         Comma-separated list of allowed workspace root
#                             dirs. Sessions are confined to these.
#   MARINA_CODE_DEFAULT_ROOT  Default root for new sessions (must be inside
#                             MARINA_CODE_ROOTS).
#
# If BOTH are unset, Code Mode falls back to the process CWD (in the Docker
# image that's /app — Marina's own code). `code doctor` flags this as a cwd
# fallback and warns to configure roots for production. Point these at a
# dedicated, mountable workspace dir rather than letting agents target /app.
# git + ripgrep are installed in the image so checkpoint/revert/diff and
# `code search` work; without git those git-backed features are unavailable.
# MARINA_CODE_ROOTS=/workspaces/project-a,/workspaces/project-b
# MARINA_CODE_DEFAULT_ROOT=/workspaces/project-a

# ─── Logging ────────────────────────────────────────────────────────────────

# Log format: "text" (human-readable) or "json" (structured)
# LOG_FORMAT=text

# Minimum log level: debug, info, warn, error
# LOG_LEVEL=info

# ─── Admin Bootstrap ───────────────────────────────────────────────────────

# Comma-separated entity names that auto-promote to admin (rank 4) on login.
# Use this to bootstrap the first admin without editing the database.
# MARINA_ADMINS=YourName,AnotherAdmin

# ─── Assets ─────────────────────────────────────────────────────────────────

# Directory for uploaded asset files (images, documents, etc.)
# ASSETS_DIR=data/assets

# ─── Login Limits ──────────────────────────────────────────────────────────

# Instance-wide concurrent login cap (total entity-bound connections).
# 0 or unset = unlimited. Internal room/crew agents are exempt and don't
# consume slots — they're capped separately by MAX_AGENTS.
# MARINA_MAX_LOGINS=0

# Login/reconnect attempts allowed per minute, keyed per client IP (falls
# back to connection id when IP is unavailable, e.g. MCP sessions).
# 0 = disabled. Default: 10.
# MARINA_LOGIN_ATTEMPTS_PER_MIN=10

# ─── Agent Runtime ─────────────────────────────────────────────────────────

# Default model ("provider/model-id") for agents spawned without an explicit
# model, and the fallback when a requested model isn't recognized. Set this to a
# provider you hold a key for (e.g. anthropic/claude-sonnet-4-6, openai/gpt-4o).
# MARINA_DEFAULT_MODEL=google/gemini-2.0-flash

# Maximum number of concurrently running agents
# MAX_AGENTS=30

# Maximum agent uptime in milliseconds before auto-stop (default: 24 hours)
# MAX_AGENT_UPTIME_MS=86400000

# Renewable lease for newly claimed tasks (default: 15 minutes). Active workers
# renew with `task heartbeat <id>`; engine ticks reopen expired ordinary work.
# MARINA_TASK_LEASE_MS=900000

# Auto-respawn saved agents on server boot. Default: false.
# When true, all agents from previous sessions resume immediately on startup.
# When false, agents must be manually spawned with `agent spawn`.
#
# This ALSO gates world-seeded agents — most notably the Chronicler. The
# default world seeds a persistent Chronicler config, but a config is not a
# running agent: it only starts on boot when AGENT_AUTORESPAWN=true (and a
# provider key exists), or when spawned manually:
#   agent spawn Chronicler model marina/default role chronicler
# Chronicle READS (`chronicle`, `chronicle since/about/pending`) and the auto
# `event` rows the engine emits on canonical happenings work regardless — but
# narrative/digest SYNTHESIS needs the Chronicler agent actually running.
# Run `readiness` in-world (or see docs/operations.md) to check what's live.
# AGENT_AUTORESPAWN=true

# Retire system-seeded entities so they DON'T come back. By default the world
# seed re-creates its agents on every boot (Chronicler, the Answerer/orchestration
# crews) and room hosts respawn on room entry (Meridian, Oracle, evolve/demos
# NPCs) — so `agent stop` only lasts until the next reseed/entry. To make a
# removal stick, either run `agent disable <name>` in-world (persisted), or list
# names here (comma-separated). Both are honored by the seeders, autorespawn,
# and the room-agent spawn path. Re-enable with `agent enable <name>` (and remove
# from this list).
# MARINA_DISABLED_AGENTS=Chronicler,Decomposer

# ─── LLM Provider API Keys (optional — needed for agent spawning) ──────────
# At least one key is required to use the agent runtime.
# Keys can also be managed at runtime via the `key` admin command / Admin → Keys.
#
# TWO KEY PATHS — important when agents can't reach an LLM:
#  1. `marina/default` agents (room agents, and any agent left on the default
#     model) route through Marina's own model API, which proxies upstream using
#     ONLY the env vars below. Admin-panel / `key` command keys are NOT consulted
#     on this path — a missing env var here yields "No upstream LLM providers
#     configured" (503). For Docker, set the key here (it flows in via env_file).
#  2. Agents on an explicit provider model (e.g. openrouter/…, anthropic/…) call
#     the provider directly and accept either an Admin-panel key OR the env var.
# Setting the env var below satisfies BOTH paths and survives DB/volume resets,
# so it's the recommended way to key a Docker deployment.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# ─── Local LLM runtimes (no cloud key required) ────────────────────────────
# Self-hosted, OpenAI-compatible servers. Address models as `<provider>/<id>`
# (e.g. `ollama/llama3`, `llama/local-model`) when spawning an agent, or leave
# agents on `marina/default` and these become the preferred fallback provider.
# The id after the slash must match a model the server has loaded/pulled.
#
# Base URLs default to LOCALHOST (native / bare-metal install). In Docker
# compose, set them to the service name (docker-compose.yml does this for you).
#
# llama.cpp (default http://localhost:8080/v1):
# LLAMA_BASE_URL=http://localhost:8080/v1
# LLAMA_API_KEY=               # only if the server runs with --api-key
#
# Ollama (default http://localhost:11434/v1) — typically keyless:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=              # only if you front Ollama with an auth proxy
#
# VibeThinker (WeiboAI reasoning model, 1.5B/3B) — no GGUF, so served by vLLM/
# SGLang (default http://localhost:8000/v1). In compose it's the optional
# `vibethinker` service (`docker compose --profile vibethinker up`). Address
# models as `vibethinker/<id>`. VIBETHINKER_MODEL is the HF id or a /models path
# the vLLM service loads; VIBETHINKER_API_KEY is shared by the server and marina.
# VIBETHINKER_BASE_URL=http://localhost:8000/v1
# VIBETHINKER_API_KEY=
# VIBETHINKER_MODEL=WeiboAI/VibeThinker-3B   # or WeiboAI/VibeThinker-1.5B
# VIBETHINKER_CTX=40960
# VIBETHINKER_MODELS_DIR=/opt/models   # optional local model dir (mounted read-only)
#
# Context window (tokens) the agent compactor budgets against. For local models
# this is normally AUTODETECTED at launch (llama.cpp /props, Ollama /api/show),
# so you usually don't need to set it. These envs PIN the value and take
# precedence over autodetect — use them when the probe can't reach the server or
# you want a smaller budget than the server's full window. If neither is set and
# autodetect fails, a conservative default applies (llama 16384, ollama 8192).
# The compactor also self-calibrates downward if the server still rejects a
# request, so a too-high value self-corrects.
# LLAMA_CONTEXT_WINDOW=16384
# OLLAMA_CONTEXT_WINDOW=8192
#
# When agents run on `marina/default` and that proxies to a LOCAL model, pin the
# window here too (otherwise it assumes a 128k cloud window):
# MARINA_DEFAULT_CONTEXT_WINDOW=16384
#
# Completion budget for local models (llama.cpp / Ollama) and the marina/default
# self-proxy when it routes to one. Reasoning models (e.g. Qwen3) spend output
# tokens on <think> before the tool call — too small a budget truncates
# mid-reasoning and the agent returns no action ("connected but nothing
# happens"). The budget is HALF the context window by default (the compactor
# reserves at most half the window for output, so half is the natural split).
# IMPORTANT: it scales with the *configured* window — set LLAMA_CONTEXT_WINDOW to
# your server's real size (e.g. 262144) or the 16384 default keeps it small.
#
# Tune the fraction (0 < f <= 0.5; values above 0.5 are clamped because the
# compactor won't reserve more than half):
# MARINA_LOCAL_OUTPUT_FRACTION=0.5
# Optional hard cap in tokens (unset = pure fraction) for a shared/cost box:
# MARINA_LOCAL_MAX_OUTPUT_TOKENS=32768
#
# Characters-per-token used by the compactor's prompt-size estimate. Default 3
# (conservative for the code/JSON/reasoning that dominates transcripts). Lower =
# more conservative (compacts earlier, never overflows); raise toward 4 only for
# text-heavy workloads where you've confirmed the estimate over-counts. Setting
# it too high re-creates the silent oversized-prompt rejection ("wedged" turns).
# MARINA_TOKEN_CHARS_PER_TOKEN=3

# ─── Direct-upstream Fallback Models (optional) ────────────────────────────
# When no model agent is online for the requested channel, Marina proxies
# directly to the provider keyed above. These envs override the built-in
# default model id per provider. Use them to track newer releases or pin
# legacy models without editing the source. Provider name = the API_KEY env
# above with `_API_KEY` removed.
# MARINA_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# MARINA_DEFAULT_OPENAI_MODEL=gpt-4o
# MARINA_DEFAULT_GEMINI_MODEL=gemini-2.0-flash
# MARINA_DEFAULT_OPENROUTER_MODEL=anthropic/claude-sonnet-4
# MARINA_DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
# MARINA_DEFAULT_LLAMA_MODEL=local-model   # match the GGUF loaded by llama.cpp
# MARINA_DEFAULT_OLLAMA_MODEL=llama3       # match a model you've `ollama pull`ed

# Timeout in milliseconds for upstream model requests on the /v1/* endpoints.
# Default: 600000 (10 minutes).
# MODEL_REQUEST_TIMEOUT_MS=600000

# ─── Media Generation (optional — images & video) ──────────────────────────
# Generate images/video from chat (`image generate <prompt>` / `video generate
# <prompt>`) or via media-capable agents. Results appear inline in the Rich web
# chat — click to pop out and view. See docs/guides/media.md.
#   Image: OpenAI (reuses OPENAI_API_KEY), Stability (STABILITY_API_KEY),
#          Google Imagen (reuses GEMINI_API_KEY), Flux/Black Forest Labs
#          (BFL_API_KEY). Default openai/gpt-image-1.
#   Video: Runway (RUNWAY_API_KEY), default runway/gen3-alpha; Google Veo
#          (reuses GEMINI_API_KEY) — `google/veo-3.0-generate-preview`;
#          Luma Dream Machine (LUMA_API_KEY) — `luma/ray-2`.
# STABILITY_API_KEY=
# BFL_API_KEY=
# RUNWAY_API_KEY=
# LUMA_API_KEY=
#
# Local / custom image models (no code change — see docs/guides/media.md):
#   Automatic1111 / SD.Next (local SD WebUI), keyless — `automatic1111/<checkpoint>`:
# A1111_BASE_URL=http://localhost:7860
# A1111_API_KEY=
#   Any OpenAI-compatible image server (Together/Fireworks/DeepInfra/LocalAI/…):
#   set <PROVIDER>_IMAGE_BASE_URL (+ <PROVIDER>_API_KEY) and use `<provider>/<model>`:
# TOGETHER_IMAGE_BASE_URL=https://api.together.xyz/v1
# TOGETHER_API_KEY=
# Daily caps per type (0 = unlimited):
# MAX_IMAGE_JOBS_PER_DAY=0
# MAX_VIDEO_JOBS_PER_DAY=0

# ─── Search Providers (optional — DuckDuckGo + academic search work with no keys) ──
# Search is zero-config: DuckDuckGo and academic APIs (arXiv, Semantic Scholar)
# are always available. Adding a key below upgrades search quality.

# Tavily — AI-native search, highest quality (1000 free searches/month)
# TAVILY_API_KEY=tvly-...

# SearXNG — self-hosted meta-search aggregating 150+ engines
# SEARXNG_URL=http://localhost:8080

# ─── External Adapters (optional) ──────────────────────────────────────────

# Telegram bot token (from @BotFather)
# TELEGRAM_TOKEN=

# Discord bot token (from Discord Developer Portal)
# DISCORD_TOKEN=

# Discord channel IDs where the bot should operate (comma-separated)
# DISCORD_CHANNEL_IDS=

# ─── Flywheel Isolated Execution (optional) ─────────────────────────────
# Enables the identity-scoped `flywheel` MCP tool and Code Mode's optional
# sandbox/project/service workflow. Keep this operator token server-side;
# Marina mints a short-lived, session-bound capability per entity.
# FLYWHEEL_TOKEN=
# FLYWHEEL_RPC_URL=http://localhost:8088/rpc
# FLYWHEEL_IMAGE=localhost/h2oai/flywheel-agentd:latest

# ─── Civic Substrate ───────────────────────────────────────────────────────
# Standing decay half-life in days (min 1, default 60). Shorter = faster
# reputation churn, so rank derived from standing demotes more aggressively.
# STANDING_HALF_LIFE_DAYS=60

# ─── TabH2O Forecasting (optional) ─────────────────────────────────────────
# H2O.ai's hosted tabular foundation model, used by `market forecast`. Without a
# key the connector is seeded but inactive (graceful degradation).
# TABH2O_API_KEY=
# Endpoint override for self-hosted deployments.
# Default: https://tabh2o.h2oai.com/api/v1/predict
# TABH2O_ENDPOINT=

# ─── Prediction Markets & Trading (optional) ───────────────────────────────
# The `position` command defaults to paper trading. Set this to "true" to allow
# live order placement on Kalshi / Polymarket — requires venue credentials below.
# MARINA_TRADING_ENABLED=true

# Kalshi credentials (live trading). API key is a UUID; the secret is an
# RSA-SHA256 private key (PEM, base64-encoded into the env var).
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
# API base override. Default: https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE=

# Polymarket: PAPER MODE ONLY. Market data (read) works, but live order
# placement is NOT implemented — the CLOB EIP-712 wallet-signing path is a stub
# that returns an error. These credentials are reserved for that future path.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PRIVATE_KEY=
# Gamma (market data) base override. Default: https://gamma-api.polymarket.com
# POLYMARKET_GAMMA_BASE=

# ─── Benchmark Tooling (optional) ──────────────────────────────────────────
# Hugging Face token used by the dataset download scripts in benchmarks/ for
# gated datasets. Not read by the running server — only the benchmark harness.
# HF_TOKEN=

# ─── Orchestration Provider Examples (optional) ────────────────────────────
# The example LLM-provider scripts in src/sdk/examples/ (nsed, debate, foundry,
# pipeline, blackboard, synthesis, adaptive, meta-agent) read their own pattern-
# specific overrides — e.g. NSED_SUBSTRATES, DEBATE_JUDGE, FOUNDRY_WORKER,
# PIPELINE_REASON, BLACKBOARD_ROLES, SYNTH_COUNCIL, plus *_TEMPERATURE / *_TRACE.
# These are scoped to those scripts, not the server. See each file's header for
# the variables it honors.
# Optional Flywheel public-service lease in milliseconds (minimum 60000; default 3600000).
# MARINA_FLYWHEEL_PUBLICATION_TTL_MS=3600000
# Standing-neutral Flywheel fleet policy. Marina controls admission/lifecycle;
# Flywheel remains responsible for VM CPU, RAM, and disk sizing.
# MARINA_FLYWHEEL_MAX_SANDBOXES=100
# MARINA_FLYWHEEL_MAX_RUNNING_SANDBOXES=50
# MARINA_FLYWHEEL_IDLE_HIBERNATE_MS=3600000
# MARINA_FLYWHEEL_ABSOLUTE_LIFETIME_MS=86400000
# MARINA_FLYWHEEL_TELEMETRY_RETENTION_MS=604800000

# ── Serving & proxies ─────────────────────────────────────────────────────────
# Trust X-Forwarded-For from a reverse proxy when rate-limiting the Model API
# by client IP. Only enable when Marina is actually behind a trusted proxy.
# MARINA_TRUST_PROXY=true

# Base URL the ACP bridge (scripts/acp.ts) uses to reach this Marina server.
# MARINA_URL=ws://localhost:3300

# Set to "off" to omit the tools-prose section from the lean agent system prompt.
# MARINA_SYSTEM_TOOLS_PROSE=off

# ── Qualification & trial harnesses (scripts/, not the server) ───────────────
# bun run qualify:flywheel — live Flywheel qualification gates:
# MARINA_FLYWHEEL_LIVE_REQUIRED=false     # fail (not skip) when live config is missing
# MARINA_FLYWHEEL_LIVE_FULL=false         # require clone/service/screenshot/publish/hibernate
# MARINA_FLYWHEEL_LIVE_CLONE_URL=         # credential-free public fixture repo for full runs
# MARINA_FLYWHEEL_LIVE_ALLOW_PUBLISH=false # permit temporary public exposure during the run
# MARINA_FLYWHEEL_EVIDENCE_DIR=           # where qualification evidence artifacts are written
# MARINA_FLYWHEEL_DEPLOYMENT_MODE=        # deployment-mode label recorded in evidence
# bun run trial:evolution — local evolution trial overrides:
# MARINA_TRIAL_MODEL=
# MARINA_TRIAL_TIMEOUT_MS=
