# Marina starter configuration. Copy to .env and uncomment what you need.
#
# Everything is optional: with no .env, `bun run start` serves a working world,
# dashboard, search and an OpenAI-compatible API on loopback (the ungated
# `local` profile). `bun run init` can write this file for you.
# Every setting: config/environment.reference (also Admin → Settings, and
# docs/reference/environment.md).

# ── Instance ──
# MARINA_NAME=Marina
# MARINA_WORLD=default
# DB_PATH=marina.db
# WS_PORT=3300

# ── One model provider key (agents need one to think) ──
# OpenRouter is the most versatile: it also enables `forecast`.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# HUGGINGFACE_API_KEY=
# Or a local runtime (setting its URL opts in):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLAMA_BASE_URL=http://localhost:8080/v1

# ── Agents ──
# Start saved and world-seeded agents (the Workbench population) at boot.
# AGENT_AUTORESPAWN=true
# Daily USD ceiling on everything this world pays upstream (unset = no cap).
# MARINA_DAILY_SPEND_CAP_USD=10
# MARINA_DEFAULT_MODEL=marina/default
# MARINA_ROOM_AGENTS=true
# Directories the `code` command may edit and run commands in.
# MARINA_CODE_ROOTS=/path/to/project

# ── Search (works without a key; these improve results) ──
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# ── Chat adapters ──
# TELEGRAM_TOKEN=
# DISCORD_TOKEN=
# Empty means every channel the bot can read.
# DISCORD_CHANNEL_IDS=

# ── Beyond one machine (read docs/guides/deployment.md first) ──
# A non-loopback bind needs sign-in (or an explicit risk acknowledgement).
# WS_HOST=0.0.0.0
# MARINA_AUTH=better-auth
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://marina.example.com
# MARINA_AUTH_ADMIN_EMAILS=you@example.com
# Bearer tokens for /v1 and MCP (local runs generate one automatically).
# MODEL_API_KEYS=sk-marina-change-me
# Encrypts provider keys saved in Admin → Keys.
# MARINA_KEY_SECRET=
# MARINA_PROFILE=shared

# ── Optional features (off by default; see the reference) ──
# Live trading stays off unless this is true and venue keys are set.
# MARINA_TRADING_ENABLED=false
# Harness decisions start with MARINA_DECISIONS; the Social Simulation Arena
# with MARINA_ARENA_ENTRANT (docs/guides/arena.md).
# LOG_LEVEL=info
