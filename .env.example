# ═══════════════════════════════════════════════════════════════════════════
# Marina Server Configuration
#
# Copy this file to .env and customize as needed.
# All variables are optional — sensible defaults are used if not set.
#
# Contents:
#   - Network & Ports
#   - API Authentication & Security
#   - External Auth (better-auth)
#   - Admin Bootstrap & Login Limits
#   - World & Engine
#   - Agent Runtime
#   - LLM Provider API Keys
#   - Local LLM Runtimes
#   - Direct-Upstream Fallback Models
#   - Code Mode (the `code` command)
#   - Flywheel Isolated Execution
#   - Media Generation
#   - Search Providers
#   - External Adapters
#   - Gateway Federation
#   - Civic Substrate
#   - TabH2O Forecasting
#   - Prediction Markets & Trading
#   - Logging & OpenTelemetry
#   - Script Harnesses (not the server)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Network & Ports ─────────────────────────────────────────────────────────

# WebSocket + web chat port. 0 = pick a free ephemeral port (announced in the
# boot banner) — the WS/HTTP server is the primary surface and can't be disabled.
WS_PORT=3300

# Bind interface (SECURE BY DEFAULT: loopback-only).
# Marina is desktop-first: with nothing set below it binds 127.0.0.1 ONLY, so a
# fresh node is reachable only from the local machine (localhost clients — the
# dashboard, the `marina` CLI, OpenAI SDKs on localhost — all work with ZERO
# config). Both the WebSocket/HTTP surface and the MCP surface honor this.
#
# Public exposure is a DELIBERATE, authenticated opt-in — never the default:
#   WS_HOST=0.0.0.0        # bind all interfaces (explicit host wins over PUBLIC)
#   MARINA_PUBLIC=true     # bind 0.0.0.0 without naming an interface
# WS_HOST=127.0.0.1
# MARINA_HOST=127.0.0.1
# MARINA_PUBLIC=false

# A NON-LOOPBACK bind is a FATAL startup error when passwordless login is in
# effect (MARINA_AUTH is not "better-auth"), OR when MARINA_OPEN_API=true. To run
# public, fix ONE of: enable MARINA_AUTH=better-auth (recommended), or explicitly
# accept the risk with the ack flag below. This protects you from accidentally
# exposing an unauthenticated node to the network.
# MARINA_ALLOW_INSECURE_PUBLIC=true

# Telnet port. OFF BY DEFAULT (0) — telnet is plaintext and unauthenticated.
# Set to a port (e.g. 4000) to enable, and only on a trusted local network.
# Telnet-origin entities are additionally barred from host code execution.
TELNET_PORT=0

# MCP (Model Context Protocol) server port. 0 = disabled.
MCP_PORT=3301

# Log server port (real-time event viewer). 0 = disabled.
LOG_PORT=3302

# OpenAI / Ollama drop-in clients connect on WS_PORT above — Marina serves
# /v1/chat/completions, /v1/responses, /v1/models, /v1/health, and the /api/*
# Ollama routes there. Compatibility is by model-id alias (MARINA_COMPAT under
# World & Engine), not a separate port. Point OpenWebUI/LobeChat/any OpenAI SDK
# at WS_PORT.

# Max concurrent WebSocket connections allowed per client IP. Default: 100.
# WS_MAX_CONNECTIONS_PER_IP=100

# Trust X-Forwarded-For from a reverse proxy when rate-limiting the Model API
# by client IP. Only enable when Marina is actually behind a trusted proxy.
# MARINA_TRUST_PROXY=true

# When NODE_ENV=production and neither HTTPS_PROXY nor REVERSE_PROXY is set,
# Marina logs a startup hint that TLS wasn't detected. Set either var (their
# value is not used — only their presence) to acknowledge a TLS-terminating
# proxy is in front and silence the hint.
# REVERSE_PROXY=1

# Base URL the ACP bridge (scripts/acp.ts) and the `marina connect` / `marina status`
# CLI use to reach this Marina server.
# MARINA_URL=ws://localhost:3300

# Bearer token `marina status` sends to GET /api/readiness (the route is
# authenticated). Unset = reuse the newest cached `marina connect` session for
# MARINA_URL; the health line still prints without it.
# MARINA_TOKEN=

# Human-readable name for this instance (shown in dashboard topbar).
# Defaults to the world name if not set.
# MARINA_NAME=Marina

# ─── API Authentication & Security ───────────────────────────────────────────

# By default, API endpoints require authentication. For local development,
# set MARINA_OPEN_API=true to accept unauthenticated requests. This also
# relaxes the dashboard/asset/canvas API auth gate, so admin actions (e.g.
# adding API keys in the dashboard) work without an interactive login.
# A valid session token is still honored when present. Do NOT enable in
# production — it exposes admin endpoints to anyone who can reach the port.
# Safe on the loopback-only default; combining it with a NON-LOOPBACK bind is a
# FATAL startup error unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# MARINA_OPEN_API=true

# Comma-separated bearer tokens for the /v1/* and /api/* LLM endpoints.
# MODEL_API_KEYS=sk-marina-abc123,sk-marina-def456

# Comma-separated secret:agent pairs for the /mem REST endpoint.
# MEM_API_KEYS=sk-agent-1:scout,sk-agent-2:archivist

# Encrypt provider API keys stored via the Admin → Keys panel at rest
# (AES-256-GCM). >= 16 chars; generate with `openssl rand -base64 32`. Without
# it, DB-stored keys are plaintext — prefer the provider env vars below, which
# are never persisted. WARNING: losing/changing this secret orphans stored keys
# (they must be re-entered). Admin → Security shows the live state.
# MARINA_KEY_SECRET=

# Process-scoped desktop capability token (>= 32 chars, sent via the
# X-Marina-Desktop-Token header). Normally minted at random by the desktop app
# at boot — you rarely set this by hand. Requests presenting it are treated as
# a trusted local OPERATOR (privileged/destructive dashboard operations),
# unlike MARINA_OPEN_API which only opens reads for development.
# MARINA_DESKTOP_API_TOKEN=

# Comma-separated allowed origins for CORS.
# When unset, no Access-Control-Allow-Origin header is sent (same-origin only).
# Set this if your dashboard or clients run on a different origin.
# ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.example.com

# ─── External Auth (better-auth) ─────────────────────────────────────────────

# OFF by default. When set to "better-auth", human sign-in is required on the
# webchat/dashboard (email/password + any configured social providers), and the
# unsafe passwordless name-login is rejected. The verified identity is BRIDGED
# to a *named* Marina entity (the artilect) — the entity stays the in-world
# identity. Agents are unaffected: they keep authenticating with session tokens
# (and internal room/crew agents with the internal token). Requires the optional
# `better-auth` dependency (installed via optionalDependencies).
# MARINA_AUTH=better-auth

# Required when MARINA_AUTH=better-auth. >= 32 chars; generate with `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# Public base URL of this instance (defaults to http://localhost:$WS_PORT).
# BETTER_AUTH_URL=https://marina.example.com
# Dedicated sqlite file for the auth tables (kept separate from the main DB).
# BETTER_AUTH_DB_PATH=marina-auth.db

# Admin allowlist by VERIFIED email (replaces name-based MARINA_ADMINS when auth
# is on). Only verified identities (OAuth, or email/password with verification)
# can be promoted — closes the name-based admin hole.
# MARINA_AUTH_ADMIN_EMAILS=you@company.com,ops@company.com

# Social OAuth providers (Phase 1) — set both id+secret to enable each.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Admin Bootstrap & Login Limits ──────────────────────────────────────────

# Comma-separated entity names that auto-promote to sovereign on login.
# Use this to bootstrap the first admin without editing the database.
# SECURITY: a name is not proof of identity under passwordless login, so this is
# honored ONLY for a genuine LOCAL operator (a loopback / in-process connection)
# — the desktop-first path. A REMOTE connection claiming an admin name is refused
# with a loud log. For network admin access enable MARINA_AUTH=better-auth and
# use MARINA_AUTH_ADMIN_EMAILS (verified-email based) instead. Ignored entirely
# when MARINA_AUTH=better-auth is set.
# MARINA_ADMINS=YourName,AnotherAdmin

# Autonomy posture — how much of the capability ceiling is open to agents.
#   guarded (default) — supervised gate attempts need a witness-granted window
#                       (`witness request <gate>` / `witness grant <entity> <gate>`);
#                       unattended use is earned via attested demonstrations or
#                       operator grants.
#   earned            — agents with sufficient standing run supervised operations
#                       freely; each run records a pending demonstration that a
#                       qualified witness attests afterwards (`witness queue`,
#                       `witness attest <id>`). Practice is free; the unattended
#                       flip is confirmed by review.
#   open              — "YOLO": standing is purely descriptive; every gate
#                       auto-passes EXCEPT the destructive core (key.manage,
#                       admin.destructive, shell.exec, code.exec.unrestricted —
#                       the last also keeps its exec-approver chain). For
#                       radical, aggressive Marinas by explicit operator choice.
# Env-only by design — no command or API can change it (an agent must never be
# able to open its own cage). `open` + a non-loopback bind + passwordless login
# is a FATAL startup error (same pattern as MARINA_ALLOW_INSECURE_PUBLIC).
# Under earned/open, gated commands defer their legacy minRank to the gate, and
# agents are told about the open-ended command surface (associations, meshes,
# intellects, labs) in their tool roster.
# MARINA_AUTONOMY=guarded

# ─── Trust profile ───────────────────────────────────────────────────────────
# WHO this Marina is for. Derived when unset: `local` when every listener binds
# loopback and MARINA_AUTH is off (one operator, their own machine); `shared`
# when MARINA_AUTH=better-auth is on; `public` for any non-loopback bind.
#   local   — UNGATED for speed and usability: all ten safety gates auto-pass
#             (including key.manage / admin.destructive / shell.exec /
#             code.exec.unrestricted), witness ladder bypassed, loopback logins
#             are sovereign (no MARINA_ADMINS needed), `code exec-mode auto` by
#             default, rate limits / login caps / memory admission budgets off,
#             MARINA_DB_DURABILITY defaults to `normal`, a failed durable
#             archive falls back to a summary note, passthru memory injection is
#             on for identified clients. Audit stays ON: exec decisions, the
#             cognitive ledger, memory receipts, trusted/unverified labels.
#             Realistic risk: a poisoned shared-pool note can lead an agent to
#             run a host command without a prompt. MARINA_AUTONOMY=guarded or
#             MARINA_PROFILE=shared brings every gate back.
#   shared  — gates, ranks and limits enforced; sign-in identifies people.
#   public  — everything enforced; passwordless names carry no authority.
# `local` + a non-loopback bind + passwordless login is a FATAL startup error
# (same pattern as MARINA_AUTONOMY=open) unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# MARINA_PROFILE=local

# Instance-wide concurrent login cap (total entity-bound connections).
# 0 or unset = unlimited. Internal room/crew agents are exempt and don't
# consume slots — they're capped separately by MAX_AGENTS.
# MARINA_MAX_LOGINS=0

# Login/reconnect attempts allowed per minute, keyed per client IP. MCP sessions
# now record their peer IP too, so a flood of new MCP sessions from one host
# shares a bucket instead of each getting a fresh one (closes the throttle
# bypass). Falls back to connection id only when the peer IP is truly unknown.
# 0 = disabled. Default: 10 (a sane non-zero default — leave it on).
# MARINA_LOGIN_ATTEMPTS_PER_MIN=10

# Absolute maximum lifetime of a session token, in milliseconds. A session's
# sliding idle TTL (24h) is refreshed on activity, but only up to
# createdAt + MARINA_SESSION_MAX_AGE_MS — past this cap validate() rejects the
# token regardless of recent use, so it can't be renewed indefinitely. A
# reconnect mints a fresh session (new cap). Default: 604800000 (7 days).
# MARINA_SESSION_MAX_AGE_MS=604800000

# ─── World & Engine ──────────────────────────────────────────────────────────

# World definition to load (see worlds/ directory)
# Available: default (reactive Workbench), showcase (full 25-room world),
#            prediction-lab, deep-research, red-team, due-diligence,
#            data-investigation, commons, research, personal, evolve, craft,
#            markets, demos, empty
# MARINA_WORLD=default

# Model for the default Workbench's Host/Builder/Critic/Chronicler population.
# When unset, Marina prefers OPENAI_API_KEY, then OPENROUTER_API_KEY, then its
# normal marina/default route. MARINA_CREW_MODEL is also honored as a shared
# override across Workbench and Showcase.
# MARINA_WORKBENCH_MODEL=openai/gpt-5.6-luna

# Shared crew-model override honored across worlds (Workbench, Showcase, the
# focused single-outcome worlds). Per-crew overrides below win over it in the
# showcase world. MARINA_ANSWERER_COUNT sizes the answerer crew (default 4).
# MARINA_CREW_MODEL=marina/default
# MARINA_ANSWERER_COUNT=4
# MARINA_ANSWERER_MODEL=
# MARINA_MATH_MODEL=
# MARINA_REFLECTOR_MODEL=

# Verified binary arithmetic can return immediately from marina:answerer while
# ambiguous/complex requests still route through the autonomous crew.
# MARINA_MODEL_FAST_PATH=false

# Token/activity controls. Request-driven agents default to 2048 output tokens;
# one run yields after 8 tool calls (16 for autonomous agents); quiet autonomous
# cycles wait at least 60s. Override only when a workload proves it needs more.
# AGENT_CREW_MAX_TOKENS=2048
# AGENT_COMPACT_MAX_TOKENS=4096
# AGENT_MAX_TOOL_CALLS_PER_RUN=8
# AGENT_IDLE_TICK_MS=60000
# AGENT_ACTIVE_TICK_MS=15000
# AGENT_CHANNEL_REPLY_COOLDOWN_MS=30000

# Comma-separated allow-list of drop-in compatibility profiles whose model-id
# aliases surface in /v1/models (ships with one profile: "openai", which exposes
# the "assistant" alias). Default: all registered profiles. Set to "none" to
# disable compat aliases entirely.
# MARINA_COMPAT=openai

# Comma-separated pool names shared with passthru clients (external OpenAI-SDK
# style callers). Empty by default — passthru identities see no shared pools
# unless listed here.
# MARINA_PASSTHRU_SHARED_POOLS=

# Set to "false" to disable LLM synthesis in the `ask` command, leaving it as a
# retrieval-only pull (personal + guide + pool + world-search context, no model
# call). Any other value (or unset) keeps synthesis on.
# MARINA_ASK_MODEL=false

# Engine tick interval in milliseconds (how often rooms update)
TICK_MS=1000

# Room where new players spawn (defaults to world definition's startRoom)
# START_ROOM=hub/crossroads

# Set to "false" to suppress all room-agent auto-spawn (LLM-connected agents that
# rooms spawn on first entry). Use for cost-controlled demos or explicit-only
# populations. Any other value (or unset) leaves auto-spawn enabled.
# MARINA_ROOM_AGENTS=false

# Native evolution protocols — optional, passive experiment lineage and robust
# evidence analysis layered over the existing experiment command. OFF by
# default. Enabling this does not auto-run, auto-prompt, or auto-promote work.
# MARINA_EVOLUTION_PROTOCOLS=true

# Which orchestration coordinator endpoints to seed beyond marina:answerer.
# Each of Councilor/Debater/Decomposer is an AUTONOMOUS loop that spends tokens
# even when its marina:council / marina:debate / marina:decompose endpoint is
# never called. If you only consume marina:answerer, seed fewer (or none) to
# stop the idle burn. Unset = all three (backward-compatible). Comma list seeds
# exactly those; empty or "none" seeds none. Specialists (Historian/Scholar/
# Skeptic/Verifier) and the answerer crew are unaffected (cheap crew-responders;
# answerer count is MARINA_ANSWERER_COUNT). Disabling removes the coordinator's
# saved config so it won't respawn.
# MARINA_ENDPOINTS=decompose

# Set to "true" to seed the universal skill packages in the showcase world.
# MARINA_SEED_SKILLS=true

# Unified Canvas — a heavy alternate dashboard interface (ReactFlow world graph),
# retired from the standard dashboard. OFF by default. Set to "true" to make it
# reachable as a standalone surface at /?unified; when unset/false that URL
# redirects back to the standard dashboard. Surfaced via the open /api/ui-config.
# MARINA_UNIFIED_CANVAS=true

# SQLite database file path
DB_PATH=marina.db
# World database durability: full (default) or explicitly normal for fewer fsyncs.
# MARINA_DB_DURABILITY=full

# Directory for uploaded asset files (images, documents, etc.)
# ASSETS_DIR=data/assets

# ─── Agent Runtime ───────────────────────────────────────────────────────────

# Default model ("provider/model-id") for agents spawned without an explicit
# model, and the fallback when a requested model isn't recognized. The default
# is the self-referential Marina loopback ("marina/default"): agents call this
# instance's own /v1 endpoint, which routes to whichever upstream provider
# actually has a key — no vendor is hardcoded. Set a concrete
# "provider/model-id" (e.g. anthropic/claude-sonnet-4-6, openai/gpt-5.6-luna) to pin
# every default-model agent to one provider instead.
# MARINA_DEFAULT_MODEL=marina/default

# Maximum number of concurrently running agents
# MAX_AGENTS=30

# Maximum agent uptime in milliseconds before auto-stop (default: 24 hours)
# MAX_AGENT_UPTIME_MS=86400000

# Renewable lease for newly claimed tasks (default: 15 minutes). Active workers
# renew with `task heartbeat <id>`; engine ticks reopen expired ordinary work.
# MARINA_TASK_LEASE_MS=900000

# Auto-respawn saved agents on server boot. Default: false.
# When true, all agents from previous sessions resume immediately on startup.
# When false, agents must be manually spawned with `agent spawn`.
#
# This ALSO gates world-seeded agents — most notably the Chronicler. The
# default world seeds a persistent Chronicler config, but a config is not a
# running agent: it only starts on boot when AGENT_AUTORESPAWN=true (and a
# provider key exists), or when spawned manually:
#   agent spawn Chronicler model marina/default role chronicler
# Chronicle READS (`chronicle`, `chronicle since/about/pending`) and the auto
# `event` rows the engine emits on canonical happenings work regardless — but
# narrative/digest SYNTHESIS needs the Chronicler agent actually running.
# Run `readiness` in-world (or see docs/operations.md) to check what's live.
# AGENT_AUTORESPAWN=true

# Retire system-seeded entities so they DON'T come back. By default the world
# seed re-creates its agents on every boot (Chronicler, the Answerer/orchestration
# crews) and room hosts respawn on room entry (Meridian, Oracle, evolve/demos
# NPCs) — so `agent stop` only lasts until the next reseed/entry. To make a
# removal stick, either run `agent disable <name>` in-world (persisted), or list
# names here (comma-separated). Both are honored by the seeders, autorespawn,
# and the room-agent spawn path. Re-enable with `agent enable <name>` (and remove
# from this list).
# MARINA_DISABLED_AGENTS=Chronicler,Decomposer

# Set to "off" to omit the tools-prose section from the lean agent system prompt.
# MARINA_SYSTEM_TOOLS_PROSE=off

# ─── LLM Provider API Keys (optional — needed for agent spawning) ────────────
# At least one key is required to use the agent runtime.
# Keys can also be managed at runtime via the `key` admin command / Admin → Keys.
#
# TWO KEY PATHS — important when agents can't reach an LLM:
#   - `marina/default` agents (room agents, and any agent left on the default
#     model) route through Marina's own model API, which proxies upstream using
#     ONLY the env vars below. Admin-panel / `key` command keys are NOT consulted
#     on this path — a missing env var here yields "No upstream LLM providers
#     configured" (503). For Docker, set the key here (it flows in via env_file).
#   - Agents on an explicit provider model (e.g. openrouter/…, anthropic/…) call
#     the provider directly and accept either an Admin-panel key OR the env var.
# Setting the env var below satisfies BOTH paths and survives DB/volume resets,
# so it's the recommended way to key a Docker deployment.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# ─── Local LLM Runtimes (no cloud key required) ──────────────────────────────
# Self-hosted, OpenAI-compatible servers. Address models as `<provider>/<id>`
# (e.g. `ollama/llama3`, `llama/local-model`) when spawning an agent, or leave
# agents on `marina/default` and these become the preferred fallback provider.
# The id after the slash must match a model the server has loaded/pulled.
#
# Base URLs default to LOCALHOST (native / bare-metal install). In Docker
# compose, set them to the service name (docker-compose.yml does this for you).
#
# COMPATIBILITY — verify a local server before enabling it, especially in
# production. Setting a key OR a base URL below makes the provider "configured",
# so the production smoke gate (scripts/smoke-production.ts --providers) probes
# it, and an unreachable or incompatible server then fails the whole gate. Two
# gotchas seen in practice:
#   - Marina injects retrieved memory/context as a SECOND system message. A GGUF
#     whose chat template requires a single leading system message (some Qwen
#     builds) rejects this with HTTP 400
#     ("raise_exception('System message must be at the beginning')"). Send a
#     request carrying two system messages and confirm a 200 before relying on
#     the server.
#   - The server's context window must exceed Marina's largest agent prompt, or
#     requests fail with HTTP 400/500 "exceeds the available context size".
#
# llama.cpp (default http://localhost:8080/v1):
# LLAMA_BASE_URL=http://localhost:8080/v1
# LLAMA_API_KEY=               # only if the server runs with --api-key
#
# Ollama (default http://localhost:11434/v1) — typically keyless:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=              # only if you front Ollama with an auth proxy
#
# VibeThinker (WeiboAI reasoning model, 1.5B/3B) — no GGUF, so served by vLLM/
# SGLang (default http://localhost:8000/v1). In compose it's the optional
# `vibethinker` service (`docker compose --profile vibethinker up`). Address
# models as `vibethinker/<id>`. VIBETHINKER_MODEL is the HF id or a /models path
# the vLLM service loads; VIBETHINKER_API_KEY is shared by the server and marina.
# VIBETHINKER_BASE_URL=http://localhost:8000/v1
# VIBETHINKER_API_KEY=
# VIBETHINKER_MODEL=WeiboAI/VibeThinker-3B   # or WeiboAI/VibeThinker-1.5B
# VIBETHINKER_CTX=40960
# VIBETHINKER_MODELS_DIR=/opt/models   # optional local model dir (mounted read-only)
#
# Context window (tokens) the agent compactor budgets against. For local models
# this is normally AUTODETECTED at launch (llama.cpp /props, Ollama /api/show),
# so you usually don't need to set it. These envs PIN the value and take
# precedence over autodetect — use them when the probe can't reach the server or
# you want a smaller budget than the server's full window. If neither is set and
# autodetect fails, a conservative default applies (llama 16384, ollama 8192).
# The compactor also self-calibrates downward if the server still rejects a
# request, so a too-high value self-corrects.
# LLAMA_CONTEXT_WINDOW=16384
# OLLAMA_CONTEXT_WINDOW=8192
#
# When agents run on `marina/default` and that proxies to a LOCAL model, pin the
# window here too (otherwise it assumes a 128k cloud window):
# MARINA_DEFAULT_CONTEXT_WINDOW=16384
#
# Completion budget for local models (llama.cpp / Ollama) and the marina/default
# self-proxy when it routes to one. Reasoning models (e.g. Qwen3) spend output
# tokens on <think> before the tool call — too small a budget truncates
# mid-reasoning and the agent returns no action ("connected but nothing
# happens"). The budget is HALF the context window by default (the compactor
# reserves at most half the window for output, so half is the natural split).
# IMPORTANT: it scales with the *configured* window — set LLAMA_CONTEXT_WINDOW to
# your server's real size (e.g. 262144) or the 16384 default keeps it small.
#
# Tune the fraction (0 < f <= 0.5; values above 0.5 are clamped because the
# compactor won't reserve more than half):
# MARINA_LOCAL_OUTPUT_FRACTION=0.5
# Optional hard cap in tokens (unset = pure fraction) for a shared/cost box:
# MARINA_LOCAL_MAX_OUTPUT_TOKENS=32768
#
# Characters-per-token used by the compactor's prompt-size estimate. Default 3
# (conservative for the code/JSON/reasoning that dominates transcripts). Lower =
# more conservative (compacts earlier, never overflows); raise toward 4 only for
# text-heavy workloads where you've confirmed the estimate over-counts. Setting
# it too high re-creates the silent oversized-prompt rejection ("wedged" turns).
# MARINA_TOKEN_CHARS_PER_TOKEN=3

# ─── Direct-Upstream Fallback Models (optional) ──────────────────────────────
# When no model agent is online for the requested channel, Marina proxies
# directly to the provider keyed above. These envs override the built-in
# default model id per provider. Use them to track newer releases or pin
# legacy models without editing the source. Provider name = the API_KEY env
# above with `_API_KEY` removed.
# MARINA_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# MARINA_DEFAULT_OPENAI_MODEL=gpt-5.6-luna
# MARINA_DEFAULT_GEMINI_MODEL=gemini-2.0-flash
# MARINA_DEFAULT_OPENROUTER_MODEL=openai/gpt-5.6-luna
# MARINA_DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
# MARINA_DEFAULT_LLAMA_MODEL=local-model   # match the GGUF loaded by llama.cpp
# MARINA_DEFAULT_OLLAMA_MODEL=llama3       # match a model you've `ollama pull`ed
# Luna on a default route uses reasoning_effort=none unless the caller supplies
# reasoning settings. Direct model requests preserve the provider's default.
# OpenAI Luna requests translate legacy max_tokens to max_completion_tokens;
# explicit modern token limits and per-provider/DB model overrides are preserved.

# Timeout in milliseconds for upstream model requests on the /v1/* endpoints.
# Default: 600000 (10 minutes).
# MODEL_REQUEST_TIMEOUT_MS=600000

# Pending-request reminders (the coordinator-drift backstop): while a routed
# model_request is unanswered, the engine re-posts it as a reminder at 25% and
# 60% of the timeout so the target re-perceives it and can still answer.
# Set to 0 to disable.
# MODEL_REQUEST_REMINDERS=1

# ─── Code Mode (the `code` command) ──────────────────────────────────────────
# Code Mode lets entities run path-confined coding sessions against a local
# workspace (inspect, diff, run allowlisted commands, propose/apply patches,
# checkpoint/revert). Two env vars bound where sessions may operate:
#
#   MARINA_CODE_ROOTS         Comma-separated list of allowed workspace root
#                             dirs. Sessions are confined to these.
#   MARINA_CODE_DEFAULT_ROOT  Default root for new sessions (must be inside
#                             MARINA_CODE_ROOTS).
#
# If BOTH are unset, Code Mode falls back to the process CWD (in the Docker
# image that's /app — Marina's own code). `code doctor` flags this as a cwd
# fallback and warns to configure roots for production. Point these at a
# dedicated, mountable workspace dir rather than letting agents target /app.
# git + ripgrep are installed in the image so checkpoint/revert/diff and
# `code search` work; without git those git-backed features are unavailable.
# MARINA_CODE_ROOTS=/workspaces/project-a,/workspaces/project-b
# MARINA_CODE_DEFAULT_ROOT=/workspaces/project-a

# Arbitrary (non-allowlisted) host command execution. OFF unless configured —
# the `code` command's allowlist is the default. Comma-listed entity ids/names
# here are eligible for HEADLESS (non-interactive) approval of arbitrary exec,
# and only when the entity ALSO holds the `code.exec.unrestricted` safety gate
# unsupervised AND identity is trustworthy (MARINA_AUTH=better-auth or a
# loopback-only bind). Every approve/deny is audited as an exec_decision
# artifact. Interactive approval (`code exec-mode prompt`) is independent of
# this list and prompts the loopback sovereign session creator.
# MARINA_CODE_EXEC_UNRESTRICTED=

# Interactive exec-approval prompt timeout in ms. Default: 120000 (2 minutes).
# MARINA_CODE_EXEC_APPROVAL_TIMEOUT_MS=120000

# The folder-scoped launcher (`marina [dir]` / `bun run code`) additionally reads:
#
#   MARINA_CODE_FRESH            "1"/"true" = throwaway DB deleted on exit,
#                                instead of the persistent per-folder default at
#                                ~/.marina/projects/<slug>/marina.db (same as --fresh).
#   MARINA_CODE_TASK_TIMEOUT_MS  One-shot (`marina -p "<task>"`) completion timeout
#                                in ms (default 600000). On timeout the launcher
#                                sends `code stop` and exits 2.
# MARINA_CODE_FRESH=1
# MARINA_CODE_TASK_TIMEOUT_MS=600000

# ─── Flywheel Isolated Execution (optional) ──────────────────────────────────
# Enables the identity-scoped `flywheel` MCP tool and Code Mode's optional
# sandbox/project/service workflow. Keep this operator token server-side;
# Marina mints a short-lived, session-bound capability per entity.
# FLYWHEEL_TOKEN=
# FLYWHEEL_RPC_URL=http://localhost:8088/rpc
# FLYWHEEL_IMAGE=localhost/h2oai/flywheel-agentd:latest

# Optional Flywheel public-service lease in milliseconds (minimum 60000; default 3600000).
# MARINA_FLYWHEEL_PUBLICATION_TTL_MS=3600000

# Standing-neutral Flywheel fleet policy. Marina controls admission/lifecycle;
# Flywheel remains responsible for VM CPU, RAM, and disk sizing.
# MARINA_FLYWHEEL_MAX_SANDBOXES=100
# MARINA_FLYWHEEL_MAX_RUNNING_SANDBOXES=50
# MARINA_FLYWHEEL_IDLE_HIBERNATE_MS=3600000
# MARINA_FLYWHEEL_ABSOLUTE_LIFETIME_MS=86400000
# MARINA_FLYWHEEL_TELEMETRY_RETENTION_MS=604800000

# ─── Media Generation (optional — images & video) ────────────────────────────
# Generate images/video from chat (`image generate <prompt>` / `video generate
# <prompt>`) or via media-capable agents. Results appear inline in the Rich web
# chat — click to pop out and view. See docs/guides/media.md.
#   Image: OpenAI (reuses OPENAI_API_KEY), Stability (STABILITY_API_KEY),
#          Google Imagen (reuses GEMINI_API_KEY), Flux/Black Forest Labs
#          (BFL_API_KEY, base override BFL_BASE_URL). Default openai/gpt-image-1.
#   Video: Runway (RUNWAY_API_KEY), default runway/gen3-alpha; Google Veo
#          (reuses GEMINI_API_KEY) — `google/veo-3.0-generate-preview`;
#          Luma Dream Machine (LUMA_API_KEY) — `luma/ray-2`.
# STABILITY_API_KEY=
# BFL_API_KEY=
# BFL_BASE_URL=
# RUNWAY_API_KEY=
# LUMA_API_KEY=
#
# Local / custom image models (no code change — see docs/guides/media.md):
#   Automatic1111 / SD.Next (local SD WebUI), keyless — `automatic1111/<checkpoint>`
#   (AUTOMATIC1111_BASE_URL is accepted as an alias):
# A1111_BASE_URL=http://localhost:7860
# (AUTOMATIC1111_BASE_URL is accepted as a long-form alias of A1111_BASE_URL.)
# A1111_API_KEY=
#   Any OpenAI-compatible image server (Together/Fireworks/DeepInfra/LocalAI/…):
#   set <PROVIDER>_IMAGE_BASE_URL (+ <PROVIDER>_API_KEY) and use `<provider>/<model>`:
# TOGETHER_IMAGE_BASE_URL=https://api.together.xyz/v1
# TOGETHER_API_KEY=
# Daily caps per type (0 = unlimited):
# MAX_IMAGE_JOBS_PER_DAY=0
# MAX_VIDEO_JOBS_PER_DAY=0

# ─── Search Providers (optional — zero-config search works with no keys) ─────
# Search is zero-config: DuckDuckGo and academic APIs (arXiv, Semantic Scholar)
# are always available. Adding a key below upgrades search quality.

# Tavily — AI-native search, highest quality (1000 free searches/month)
# TAVILY_API_KEY=tvly-...

# SearXNG — self-hosted meta-search aggregating 150+ engines
# SEARXNG_URL=http://localhost:8080

# ─── External Adapters (optional) ────────────────────────────────────────────

# Telegram bot token (from @BotFather)
# TELEGRAM_TOKEN=

# Discord bot token (from Discord Developer Portal)
# DISCORD_TOKEN=

# Discord channel IDs where the bot should operate (comma-separated)
# DISCORD_CHANNEL_IDS=

# ─── Gateway Federation ──────────────────────────────────────────────────────

# Shared secret for gateway-to-gateway authentication.
# When set, outgoing gateway connections send this secret on connect,
# and incoming gateway connections must present it within 5 seconds or be dropped.
# Both sides must use the same value. Leave unset for open federation.
# GATEWAY_SECRET=

# Optional Ed25519 federation identity. When unset, Marina remains fully usable
# and publishes the backwards-compatible unsigned v1 manifest/checkpoint. Set
# this to a base64 PKCS#8 DER private key (or PEM with escaped newlines) to
# publish signed v2 documents. The private key never appears in manifests.
# MARINA_FEDERATION_SIGNING_KEY=

# Accept UNSIGNED cross-world mesh events on `mesh replicate`. Off by default:
# an unsigned event's originWorldId is an unverifiable claim, so any logged-in
# entity could otherwise inject evidence attributed to any world. Enable only
# between dev instances on a trusted network. Signed events are always
# verified, and additionally checked against the origin peer's pinned
# public key / trust status in federation_peers when one is registered.
# MARINA_FEDERATION_ALLOW_UNSIGNED=true

# ─── Civic Substrate ─────────────────────────────────────────────────────────

# Standing decay half-life in days (min 1, default 60). Shorter = faster
# reputation churn, so rank derived from standing demotes more aggressively.
# STANDING_HALF_LIFE_DAYS=60

# ─── TabH2O Forecasting (optional) ───────────────────────────────────────────
# H2O.ai's hosted tabular foundation model, used by `market forecast`. Without a
# key the connector is seeded but inactive (graceful degradation).
# TABH2O_API_KEY=
# Endpoint override for self-hosted deployments.
# Default: https://tabh2o.h2oai.com/api/v1/predict
# TABH2O_ENDPOINT=

# ─── Harness Decisions (optional — route / gate / verify) ────────────────────
# Cheap per-step judgement calls answered with numbers (noul = yes/no probability,
# choice, score) — see src/decisions/. OFF by default: the backend receives tool
# names + redacted arguments (and, via /v1/decisions, whatever callers send).
# decisions-api  : a purpose-built decision model over the Decisions API
#                  (Jev family on OpenRouter — pin a version, e.g. typesafe/jev-1.13,
#                  or a sibling such as nanojev / kev; or a self-hosted OpenJev).
# typesafe       : TypeSafe's own API (https://api.typesafe.ai/v1/systemone, model
#                  jev-latest, key TYPESAFE_API_KEY) — same wire format.
# chat-classifier: ANY OpenAI-compatible chat model used as a classifier
#                  (less calibrated, works with every model Marina can reach).
# Marina serves the same API at POST /v1/decisions and /v1/systemone, so
# `langchain-typesafe` works unchanged with TYPESAFE_BASE_URL=http://<marina>:3300
# and a MODEL_API_KEYS token as TYPESAFE_API_KEY.
# MARINA_DECISIONS=off
# MARINA_DECISION_MODEL=typesafe/jev-1.13
# MARINA_DECISION_BASE_URL=https://openrouter.ai/api/alpha
# MARINA_DECISION_API_KEY=            # else OPENROUTER_API_KEY (openrouter.ai) / TYPESAFE_API_KEY (api.typesafe.ai)
# MARINA_DECISION_PATH=/decisions     # Decisions API path; typesafe preset uses /v1/systemone
# TYPESAFE_API_KEY=
# MARINA_DECISION_TIMEOUT_MS=2000     # 8000 default for chat-classifier
# Score mutating agent tool calls before they run (fail-closed; reads and
# messages are never sent). Needs MARINA_DECISIONS.
# MARINA_DECISION_GATE=off
# With the gate on, each call also carries the agent's operator-set intent (goal,
# role, focus, active task) and the trust LABELS of what fed its prompt (never the
# content), and the gate asks whether the call follows from that purpose or from
# untrusted content. `off` sends the call only.
# MARINA_DECISION_GATE_CONTEXT=on
# "Ask a person" verdicts hold the call for the agent's owner (`decision approve|deny
# <token>`); no answer by this deadline blocks it (fail-closed).
# MARINA_DECISION_APPROVAL_TIMEOUT_MS=120000
# Spawn-time routing: `agent spawn <name> model:route goal:<…>` asks the router
# ONCE (before the conversation exists) and picks one of these tiers; the pick is
# persisted so respawns keep it. No backend / no goal ⇒ the powerful tier.
# MARINA_ROUTE_FAST_MODEL=openai/gpt-4o-mini
# MARINA_ROUTE_POWERFUL_MODEL=anthropic/claude-opus-4-6
# Or a route TABLE (wins over the two tiers): each route's criteria become one
# option of a single `choice` question; low pick confidence (< 0.6), no backend
# or an error use the fallback route (default `powerful`, else the last route).
# MARINA_ROUTES={"cheap":{"model":"openai/gpt-4o-mini","criteria":"Direct lookups, extraction and localized changes."},"coder":{"model":"anthropic/claude-sonnet-4-6","criteria":"Writing or reviewing code across several files."},"powerful":{"model":"anthropic/claude-opus-4-6","criteria":"Architecture, unclear failures and high-stakes decisions."}}
# MARINA_ROUTE_INSTRUCTIONS=Choose the least costly model that can complete the task.
# MARINA_ROUTE_FALLBACK=powerful
# Verify `task submit` deliverables before they are recorded: below the bar on the
# first attempt ⇒ bounced once with the scores; the second attempt is recorded as
# is. Advisory — the task creator still approves/rejects. Needs MARINA_DECISIONS.
# MARINA_DECISION_VERIFY=off

# ─── Prediction Markets & Trading (optional) ─────────────────────────────────
# The `position` command defaults to paper trading. Set this to "true" to allow
# live order placement on Kalshi / Polymarket — requires venue credentials below.
# MARINA_TRADING_ENABLED=true

# Kalshi credentials (live trading). API key is a UUID; the secret is an
# RSA-SHA256 private key (PEM, base64-encoded into the env var).
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
# API base override. Default: https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE=

# Polymarket: PAPER MODE ONLY. Market data (read) works, but live order
# placement is NOT implemented — the CLOB EIP-712 wallet-signing path is a stub
# that returns an error. These credentials are reserved for that future path.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PRIVATE_KEY=
# Gamma (market data) base override. Default: https://gamma-api.polymarket.com
# POLYMARKET_GAMMA_BASE=

# ─── Logging & OpenTelemetry ─────────────────────────────────────────────────

# Log format: "text" (human-readable) or "json" (structured)
# LOG_FORMAT=text

# Minimum log level: debug, info, warn, error
# LOG_LEVEL=info

# Durable structured application logs retained in SQLite (newest rows kept).
# MARINA_LOG_RETENTION=10000

# Durable event_log row retention (pruned hourly on the engine tick). Sized
# well above the 5,000-row trace-projection window so pruning never truncates
# a trace a consumer can still request. Default 100000, min 10000.
# MARINA_EVENT_RETENTION=100000

# OpenTelemetry trace export (optional, off by default).
# Push completed structural execution spans to an OTLP/HTTP JSON collector.
# Prompts, outputs, thinking text, tool arguments, provider error detail, and
# collector credentials are excluded. A collector outage never blocks agents.
# MARINA_OTLP_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
# Signal-specific endpoint is used exactly as written:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
# Or set the shared base; Marina appends /v1/traces:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example
# Comma-separated, percent-encoded key=value pairs (never displayed):
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10s
# OTEL_SERVICE_NAME=marina
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.namespace=h2oai
# Plaintext non-loopback collectors are refused unless explicitly acknowledged:
# MARINA_OTLP_ALLOW_INSECURE=false
# MARINA_OTLP_BATCH_DELAY_MS=2000

# OTLP log push is independently opt-in; HTTP/JSON is currently supported.
# MARINA_OTLP_LOGS_ENABLED=true
# OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://collector.example/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=10s
# MARINA_OTLP_LOGS_BATCH_DELAY_MS=2000
# MARINA_OTLP_LOGS_MAX_QUEUE=2000

# ─── Script Harnesses (scripts/ and src/sdk/examples/, not the server) ───────

# Hugging Face token used by the dataset download scripts in benchmarks/ for
# gated datasets. Not read by the running server — only the benchmark harness.
# HF_TOKEN=

# The example LLM-provider scripts in src/sdk/examples/ (ensemble, debate, foundry,
# pipeline, blackboard, synthesis, adaptive, meta-agent) read their own pattern-
# specific overrides — e.g. ENSEMBLE_SUBSTRATES, DEBATE_JUDGE, FOUNDRY_WORKER,
# PIPELINE_REASON, BLACKBOARD_ROLES, SYNTH_COUNCIL, plus *_TEMPERATURE / *_TRACE.
# These are scoped to those scripts, not the server. See each file's header for
# the variables it honors.

# bun run qualify:flywheel — live Flywheel qualification gates:
# MARINA_FLYWHEEL_LIVE_REQUIRED=false     # fail (not skip) when live config is missing
# MARINA_FLYWHEEL_LIVE_FULL=false         # require clone/service/screenshot/publish/hibernate
# MARINA_FLYWHEEL_LIVE_CLONE_URL=         # credential-free public fixture repo for full runs
# MARINA_FLYWHEEL_LIVE_ALLOW_PUBLISH=false # permit temporary public exposure during the run
# MARINA_FLYWHEEL_EVIDENCE_DIR=           # where qualification evidence artifacts are written
# MARINA_FLYWHEEL_DEPLOYMENT_MODE=        # deployment-mode label recorded in evidence

# bun run trial:evolution — local evolution trial overrides:
# MARINA_TRIAL_MODEL=
# MARINA_TRIAL_TIMEOUT_MS=
# Opt in to full, payload-bearing cognitive provenance. Off by default.
MARINA_COGNITIVE_PROVENANCE=false

# ─── Durable Memory Storage Admission ─────────────────────────────────────────
# Applies to both the world and standalone memory service. Positive integers.
# Limits are per space owner, aggregated across spaces and credentials; shared
# writers consume the owner's budget. Existing data is never automatically evicted.
# Logical bytes count UTF-8 payloads plus row allowances, including receipts and
# revisions. These are admission budgets, NOT physical SQLite/WAL/disk quotas.
# Reads, explicit forgetting and revocation remain available at the limit.
# MARINA_MEMORY_MAX_BYTES=1073741824
# MARINA_MEMORY_MAX_SOURCES=100000
# MARINA_MEMORY_MAX_REVISIONS=100000
# MARINA_MEMORY_MAX_SPACES=256

# ─── Explicit Memory Federation ──────────────────────────────────────────────
# Optional operator-owned JSON file. Each mount binds one local principal to a
# peer URL, peer space and an environment variable containing a PEER credential.
# No credentials are forwarded from callers; agents explicitly select aliases.
# MARINA_MEMORY_FEDERATION_CONFIG=/secure/config/memory-mounts.json
# Example entry (file contains an array):
# {"owner_principal_id":"LOCAL_PRINCIPAL","alias":"research","url":"https://peer.example",
#  "space_id":"PEER_SPACE","token_env":"RESEARCH_MEMORY_TOKEN"}
# RESEARCH_MEMORY_TOKEN=   # set through your deployment's secret configuration

# Optional model-directed memory plans. Omit these for deterministic, model-free plans.
# MARINA_MEMORY_PLANNER_URL=http://127.0.0.1:3300/v1
# MARINA_MEMORY_PLANNER_MODEL=marina
# MARINA_MEMORY_PLANNER_TOKEN=  # authorized model-router credential

# ─── Memory Embeddings (world server) ─────────────────────────────────────────
# Off by default: both memory silos stay lexical (FTS5, porter-stemmed since
# migration 112) and `mode:"hybrid"` is always an explicit caller request.
# Turning this on is evidence-gated — run `bun run qualify:paraphrase` first.
# none   → lexical only (default)
# local  → pinned MiniLM via the optional extension:
#          bun install --cwd extensions/local-embeddings --frozen-lockfile
# ollama → operator-run Ollama /api/embed; MODEL and an immutable REVISION are required
# MARINA_MEMORY_EMBEDDINGS=none
# MARINA_MEMORY_EMBEDDING_CACHE=data/memory-models   # local: model cache directory
# MARINA_MEMORY_EMBEDDING_LOCAL_ONLY=false           # local: refuse first-use downloads
# MARINA_MEMORY_EMBEDDING_URL=http://127.0.0.1:11434 # ollama
# MARINA_MEMORY_EMBEDDING_MODEL=                     # ollama, e.g. nomic-embed-text
# MARINA_MEMORY_EMBEDDING_REVISION=                  # ollama, immutable model revision

# ─── Passthru memory gateway (all four proxy surfaces) ─────────────────────────
# Total bytes of memory context injected into a proxied request for an identified
# passthru caller (framing lines included). Override per bound key with the
# entity property `passthruInjectBytes`. Default 2048; clamped to 256–65536.
# MARINA_PASSTHRU_INJECT_BYTES=2048

# Exact-match response cache for identified passthru callers, stored on the
# durable memory service's pinned result cache. Under the LOCAL trust profile,
# "on" enables it for every identified caller; in other profiles a caller opts
# in per bound key with the entity property `passthruResponseCache: true`.
# Never caches streaming, tool-call or non-2xx responses, nor the shared
# anonymous identity. Semantic caching is out of scope by design.
# MARINA_PASSTHRU_RESPONSE_CACHE=off
# Cache entry lifetime in milliseconds (default 3600000 = 1h).
# MARINA_PASSTHRU_RESPONSE_CACHE_TTL_MS=3600000

# ─── Agent Spend Ceiling & Failure Breaker ───────────────────────────────────
# Rolling one-hour USD caps on agent model spend (provider-reported cost; models
# that report no cost — e.g. local runtimes — count as $0). Both default to
# unlimited (unset or 0). When a cap is hit the agent's autonomous loop pauses
# (no more model calls), tells its spawner, and `agent status <name>` shows the
# reason; it resumes on its own once the last-hour spend drops below the cap.
# Global cap across every agent in this runtime:
# MARINA_MAX_COST_USD_PER_HOUR=5
# Per-agent cap:
# MARINA_MAX_AGENT_COST_USD_PER_HOUR=1

# Consecutive upstream/loop errors (429s, 5xx, timeouts) before an agent stops
# retrying on the 30 s backoff and pauses for MARINA_UPSTREAM_ERROR_PAUSE_MS
# (default 10 min), telling its spawner once; it then resumes with the counter
# reset. Default: 20.
# MARINA_MAX_CONSECUTIVE_UPSTREAM_ERRORS=20
# MARINA_UPSTREAM_ERROR_PAUSE_MS=600000

# ─── Outbound URL guard (SSRF) ──────────────────────────────────────────────
# Every agent-initiated outbound fetch (connectors, gateway peers, web tools)
# is range-checked, and named hosts are resolved and re-checked so a public
# name cannot rebind to 127.0.0.1 / 169.254.169.254. When DNS resolution itself
# FAILS the guard refuses the URL (fail closed). Set to "true" only in a
# restricted-DNS environment where legitimate fetches would otherwise break;
# the fetch then proceeds unpinned and re-resolves at connect time.
# MARINA_URL_GUARD_DNS_FAIL_OPEN=false

# ─── Row retention ──────────────────────────────────────────────────────────
# Hourly pass (src/engine/retention.ts) that ages out the append-heavy tables
# in ≤ 5k-row batches. Defaults per class: telemetry 14 d (primitive_usage;
# feed_events 7 d; memory_service_events / coding_events 30 d; event_log is
# row-bounded by MARINA_EVENT_RETENTION), ledgers 90 d (direct_messages once
# acknowledged/expired, cognitive_events, productivity_sessions,
# core_memory_history, media_jobs, memory_assistance_actions), audit 365 d
# (witness_attestations, trace_judgments, note_verifications,
# evidence_receipts, association_events, benchmark_runs; shell_log 90 d).
# chronicle, entity_standing, memory_resolutions and economic_events are
# append-only and never pruned.
# Override any window: comma-separated `table=<duration|rows|0>`; durations
# take s/m/h/d/w, a bare integer is a row count (event_log), 0 = never prune.
# MARINA_RETENTION_OVERRIDES=primitive_usage=30d,feed_events=0,event_log=250000

# ─── HTTP surface hardening ──────────────────────────────────────────────────
# Server-wide request body ceiling for the world HTTP port (Bun's own default
# is 128 MiB). JSON routes are bounded by this; the asset upload route has its
# own cap below, and the effective Bun limit is the larger of the two.
# MARINA_MAX_REQUEST_BODY_BYTES=8388608

# Maximum size of a single asset upload (POST /api/assets, multipart or raw).
# Default 50 MiB. Uploads are also MIME-allowlisted: raster images are checked
# against their magic bytes; anything not on the list is stored and served as
# application/octet-stream (downloaded, never rendered).
# MARINA_MAX_UPLOAD_BYTES=52428800

# MCP session creation + `login`/`auth` tool calls allowed per client IP per
# minute (sibling of MARINA_LOGIN_ATTEMPTS_PER_MIN). 0 = off. Default: 10.
# MARINA_MCP_SESSIONS_PER_MIN=10

# Extra `Host` header values the /mcp transport accepts (DNS-rebinding
# protection). On the loopback default every loopback spelling on the live
# port is already allowed. On a non-loopback bind Host validation is OFF until
# you list your public hostname(s) here (comma-separated, optional :port).
# MARINA_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:3301

# /mcp requires `Authorization: Bearer <MODEL_API_KEYS secret | Marina session
# token>` automatically whenever MODEL_API_KEYS is set, MARINA_AUTH=better-auth
# is on, or the bind is non-loopback. Loopback + no keys (the `local` profile)
# stays unauthenticated so a plain {"url": ".../mcp"} client config works.
# Other fixed per-surface limits (not env-tunable): authenticated dashboard REST
# 60 req / 10 s per principal; canvas + asset mutations 30 / 10 s per principal;
# public /api/entity/* reads 30 / 10 s per IP. MARINA_TRUST_PROXY (above) now
# governs the client IP used by EVERY per-IP limiter, not only the Model API.

# ─── Anthropic passthru prompt caching ──────────────────────────────────────
# When the passthru upstream is Anthropic, add `cache_control: {type: "ephemeral"}`
# to the LAST system block of every request that carries no cache marker of its
# own (a client's markers — pi-ai, Anthropic SDKs on /v1/messages — always win).
# Default: true under the `local` trust profile, false under shared/public.
# Cache hits show up as cacheReadTokens on the request trace (`trace show <id>`).
# MARINA_ANTHROPIC_AUTO_CACHE=true

# ─── Agent Prompt Budget (2026-09-22) ────────────────────────────────────────
# Output reservation for the marina/default self-proxy model. The compactor
# subtracts this from the context window before budgeting the prompt; the real
# local-upstream completion budget is enforced at the proxy (prepareLlamaBody).
# Was localOutputBudget(window) = half of a 128k cloud window, which left agents
# an effective 64k prompt.
# MARINA_DEFAULT_MAX_TOKENS=4096
#
# NOTE: MARINA_LOCAL_OUTPUT_FRACTION (documented above) now defaults to 0.25,
# not 0.5 — a 16k local model keeps ~12k for input and 4k for <think> + tool call.
#
# `full` tool profile: the crew core set is resident and every other typed
# tool is listed one line each inside `marina_tool_search`, loaded by name for
# the session (~14 KB resident vs 36 KB). "off" restores all-resident schemas.
# MARINA_DEFERRED_TOOLS=off
#
# Byte ceiling for the per-cycle continuation prompt; lowest-priority sections
# are deferred with a "[+N sections deferred]" note. Min 1000.
# MARINA_CONTINUATION_BUDGET_BYTES=6000
# Clamp for a model_request perception line (its `content` IS the caller's
# question, so it gets more room than the 400-char general clamp).
# MARINA_PERCEPTION_MODEL_REQUEST_MAX_CHARS=2000
#
# Turns (model calls) one prompt() may take before the loop yields to the next
# cycle; complements AGENT_MAX_TOOL_CALLS_PER_RUN.
# MARINA_MAX_TURNS_PER_PROMPT=24
# Provider-level retries pi-ai performs inside a request (transient 5xx / short
# 429) before Marina's loop-level backoff sees the error. 0 disables.
# MARINA_PROVIDER_MAX_RETRIES=2
#
# Prompt caching from the agent side: the marina/* model emits Anthropic-style
# cache_control markers (system block, last tool, last conversation text) and a
# per-agent session id for the proxy to forward upstream. "off" disables the
# markers (keep off if your proxy does not strip them for strict upstreams).
# MARINA_AGENT_PROMPT_CACHE=off

# ─────────────────────────────────────────────────────────────────────────────
# Agent reasoning depth and tool ordering
# ─────────────────────────────────────────────────────────────────────────────
# Default extended-thinking level for spawned agents (off | minimal | low |
# medium | high | xhigh). Explicit `agent spawn <name> thinking:high` /
# `agent config <name> thinking high` wins; crew responders stay `off` unless
# set explicitly (latency). On the marina/* proxy the level rides as
# `reasoning_effort` and is translated per upstream (Anthropic:
# `thinking: {type:"enabled", budget_tokens}` with temperature omitted).
# MARINA_AGENT_THINKING=off
# How a multi-tool assistant turn executes. Unset (auto): world-mutating tools
# are stamped sequential so any batch containing one runs in order while
# read-only batches (look/who/brief/feed/web/code read …) fan out. `parallel`
# = library default everywhere; `sequential` = serialise every batch.
# MARINA_TOOL_EXECUTION=auto

# ─────────────────────────────────────────────────────────────────────────────
# SDK example providers (src/sdk/examples/*)
# ─────────────────────────────────────────────────────────────────────────────
# Environment read by the runnable examples in src/sdk/examples/. These are
# NOT read by the Marina server — each example is its own process
# (`bun run src/sdk/examples/<name>.ts`). Shared knobs first, then per file.
# `NSED_*` names are the LEGACY spelling of the deliberation/ensemble pattern
# (formerly "NSED"); the `ENSEMBLE_*` names take precedence when both are set.
#
# Shared by most examples
# WS_URL=ws://localhost:3300                 # Marina WebSocket the example logs into
# MARINA_ENDPOINT=http://localhost:3300      # Marina HTTP base (model API, /v1)
# MODEL_CHANNEL=model                        # channel the provider serves model_request on
# AGENT_NAME=<per-example default>           # in-world login name (Provider, Greeter, Explorer, …)
# COMMAND_DRAIN_MS=2500                      # ms to wait for command output before replying (blackboard 2500, ensemble-smart 2000)
# POLL_INTERVAL_MS=1500                      # task/queue poll cadence (task-worker 1500, world-coordinator 2000)
# PROJECT_NAME=benchmark-pursuit             # project the task-worker / coordinator / world-setup examples operate on
# SYSTEM_PROMPT=                             # extra system prompt for provider.ts / smart-provider.ts
#
# adaptive-provider.ts — council-then-escalate answering
# ADAPTIVE_COUNCIL=marina:haiku,marina:qwen,marina:gemma,marina:kimi   # council substrates (comma list)
# ADAPTIVE_TEMPS=0,0,0,0                     # per-council-member temperatures (defaults to 0 each)
# ADAPTIVE_STRONG=marina:sonnet              # escalation model when council agreement is low
# ADAPTIVE_THRESHOLD=0.75                    # agreement ratio below which the strong model is consulted
# ADAPTIVE_TRACE=false                       # true = verbose per-request trace on stderr
#
# benchmark-preflight.ts — sample a benchmark before a full run
# PREFLIGHT_MODEL=marina:gemini              # substrate to preflight
# PREFLIGHT_SAMPLE=5                         # items sampled per benchmark
# SEED=42                                    # sampling seed
#
# blackboard-provider.ts — shared-workspace roles + judge
# BLACKBOARD_ROLES=marina:haiku@scholar,marina:qwen@skeptic,marina:gemma@calculator,marina:kimi@domain   # substrate@role list
# BLACKBOARD_JUDGE=marina:haiku              # model that reads the board and writes the final answer
# BLACKBOARD_POOL_PREFIX=bench-q-            # pool name prefix for per-question blackboards
# BLACKBOARD_TEMPERATURE=0                   # sampling temperature for every role
# BLACKBOARD_TRACE=false
#
# debate-provider.ts — two proposers + judge
# DEBATE_PROPOSER_A=marina:haiku
# DEBATE_PROPOSER_B=marina:qwen
# DEBATE_JUDGE=marina:sonnet
# DEBATE_TEMPERATURE=0
# DEBATE_TRACE=false
#
# ensemble-provider.ts / ensemble-smart-provider.ts — deliberation/ensemble (legacy "NSED")
# ENSEMBLE_SUBSTRATES=marina:haiku,marina:haiku,marina:haiku,marina:haiku   # ensemble members (legacy: NSED_SUBSTRATES)
# ENSEMBLE_TEMPERATURES=0,0,0,0              # per-member temperatures (legacy: NSED_TEMPERATURES)
# ENSEMBLE_TRACE=false                       # legacy: NSED_TRACE
# NSED_SUBSTRATES=                           # legacy name for ENSEMBLE_SUBSTRATES — still honored
# NSED_TEMPERATURES=                         # legacy name for ENSEMBLE_TEMPERATURES — still honored
# NSED_TRACE=                                # legacy name for ENSEMBLE_TRACE — still honored
#
# ensemble-smart-provider.ts / smart-provider.ts / translator.ts — memory-aware providers
# MEMORY_LEARN=true                          # false = do not write reflections back to memory
# MEMORY_MAX_BYTES=6000                      # recalled-memory byte budget per request (translator: 2000)
# MEMORY_POOLS=                              # comma list of pools to recall from (empty = own notes only)
# MEMORY_MODE=reflect                        # smart-provider learning mode: reflect | qa
# MEMORY_TOPK=200                            # smart-provider recall candidates before ranking
# MEMORY_TRACE=false                         # log recalled memory per request
# REFLECTION_PROVIDER_URL=http://localhost:3300/v1   # OpenAI-compatible endpoint used to write reflections
# REFLECTION_PROVIDER_MODEL=marina:haiku     # model that writes reflections
# USE_TRANSLATOR=true                        # false = answer without the translator crew
# TRANSLATOR_CHANNEL=translator              # channel the translator listens on (synthesis: empty = off)
# TRANSLATOR_TIMEOUT_MS=8000                 # wait for a translator reply (synthesis: 15000)
#
# evolver.ts — self-evolving agent loop
# ADVISOR=                                   # entity name to consult each cycle (empty = none)
# CYCLE_SECS=60                              # seconds between evolution cycles
#
# foundry-provider.ts — worker/reviewer merge gate
# FOUNDRY_WORKER=marina:sonnet
# FOUNDRY_REVIEWER=marina:haiku
# FOUNDRY_MAX_ROUNDS=2                       # review rounds before the gate gives up
# FOUNDRY_TEMPERATURE=0
# FOUNDRY_TRACE=false
#
# meta-agent.ts — meta-level orchestration
# META_MODEL=marina:gemini                   # primary model
# META_MODEL_FALLBACK=marina:sonnet          # used when the primary fails
#
# pipeline-provider.ts — parse → reason → verify stages
# PIPELINE_PARSE=marina:haiku
# PIPELINE_REASON=marina:sonnet
# PIPELINE_VERIFY=marina:haiku
# PIPELINE_TEMPERATURE=0
# PIPELINE_TRACE=false
#
# provider.ts / smart-provider.ts — bridge an external OpenAI/Ollama-compatible LLM into a channel
# PROVIDER_URL=http://localhost:11434/v1     # upstream base URL (Ollama default)
# PROVIDER_MODEL=llama3                      # upstream model id
# PROVIDER_KEY=                              # upstream bearer key (empty for local Ollama)
# PROVIDER_FORMAT=openai                     # upstream wire format
#
# seed-pools.ts — seed domain knowledge pools
# SEED_MODEL=marina:sonnet                   # model that writes seed notes
# SEED_PER_DOMAIN=50                         # notes per domain
# SEED_POOL_PREFIX=seed:                     # pool name prefix (seed:math, seed:law, …)
# SEED_DOMAINS=                              # comma list of domain names (empty = built-in eight)
#
# spawner.ts
# BASE_URL=http://localhost:3300             # Marina HTTP base
#
# synthesis-provider.ts — council + strong-model synthesis with tools
# SYNTH_COUNCIL=marina:haiku,marina:qwen,marina:gemma
# SYNTH_STRONG=marina:gemini                 # synthesiser / escalation model
# SYNTH_CLASSIFIER=                          # optional question-classifier model (empty = heuristics)
# SYNTH_ESCALATE_T=0.75                      # council agreement below which the strong model answers
# SYNTH_CALCULATOR=true                      # false = disable the calculator tool
# SYNTH_CALCULATOR_TIMEOUT_MS=12000
# SYNTH_USE_WEB=true                         # false = disable web evidence
# SYNTH_MEMORY_MAX=8000                      # recalled-memory byte budget
# SYNTH_POOLS=seed:math,seed:law,…           # pools to recall from (default: seed:* + benchmark:* pools)
# SYNTH_TRACE=false
#
# task-worker.ts — claims and works project tasks
# WORKER_NAME=Worker1
# WORKER_SUBSTRATE=marina:haiku              # model the worker answers with
# WORKER_TRACE=false
# CLAIM_COOLDOWN_MS=500                      # pause after a claim before the next poll
#
# translator.ts — per-model translator crew member
# MARINA_MODEL=                              # REQUIRED — substrate to serve (marina:haiku, marina:gemini, …)
#
# world-coordinator-provider.ts — dispatches to workers, falls back to a model
# FALLBACK_SUBSTRATE=marina:sonnet           # answers when no worker replies within WORKER_TIMEOUT_MS
# WORKER_TIMEOUT_MS=60000
# COORDINATOR_TRACE=false
#
# world-setup.ts — seeds a benchmark world
# AGENT_COUNT=5                              # agents to spawn
# AGENT_MODELS=marina:haiku,marina:qwen,marina:deepseek,marina:gemini,marina:sonnet   # cycled across the agents
# SKIP_AGENTS=false                          # true = pools only
# SKIP_POOLS=false                           # true = agents only

# ── Agent runtime (2026-09-22, agent track 2) ──
# Strict (constrained-sampling) function tools: resident tools whose schema is
# a closed, all-required object are sent with `strict: true` so OpenAI-style
# upstreams that implement it (OpenAI, vLLM) guarantee the argument shape;
# llama.cpp / Ollama ignore the field and the Anthropic translation drops it.
# Schemas with optional properties are never stamped (strict mode would turn
# them nullable). `off` disables the stamp.
# MARINA_STRICT_TOOLS=on

# Memory-reflector idle stop: a `reflect`-spawned memory-reflector that holds
# no open assistance job and has had none created for it inside this window
# is stopped by the runtime (the next `reflect` re-spawns one on demand).
# Milliseconds; 0 disables. Default 10 minutes.
# MARINA_REFLECTOR_IDLE_STOP_MS=600000

# Self-echo perceptions: by default an agent's OWN command echoes — the
# memory-service acknowledgements of its continuity journal (`memory api`
# capture / checkpoint replies) and its `You tell …` receipts — are kept out
# of the `[World Events]` buffer (they carry nothing the agent did not just
# do; measured at 89 % of continuation prompts hitting the event re-queue).
# `on` restores the previous behaviour. Messages from other entities are
# never filtered.
# MARINA_PERCEIVE_SELF_ECHO=off
