# Dependencies + build artifacts (reinstalled / rebuilt inside the image)
node_modules
dashboard/node_modules
dist
dashboard/dist

# Local state + secrets — never bake these into an image
*.db
*.db-wal
*.db-shm
*.db-journal
data
marina-data
backups
.env
.env.*

# VCS / CI / editor
.git
.github
.DS_Store

# Tests (not needed at runtime)
test
*.test.ts

# Unrelated subprojects (not part of the server runtime). Their package.json
# files ARE needed: they are Bun workspace members, and a workspace install
# from the single root bun.lock requires every member manifest to be present.
marina-desktop
!marina-desktop/package.json
!marina-desktop/patches
examples
!examples/usecase-ui/package.json
!examples/coding-agent-demo/package.json

# These files are provided by the build, not the context
.dockerignore
Dockerfile
docker-compose.yml
biome.json
