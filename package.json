{
  "name": "marina",
  "version": "0.7.0",
  "description": "You think, therefore you are here. A civilization for the future where humans and autonomous AI agents share memory, tools, reputation, and work.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://h2oai.github.io/marina/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h2oai/marina.git"
  },
  "bugs": {
    "url": "https://github.com/h2oai/marina/issues"
  },
  "keywords": [
    "mud",
    "agents",
    "simulation",
    "mcp",
    "multi-agent",
    "typescript",
    "websocket",
    "telnet",
    "openai",
    "ollama",
    "llm",
    "model-api"
  ],
  "bin": {
    "marina": "scripts/marina.ts"
  },
  "files": [
    "src",
    "worlds",
    "rooms",
    "scripts",
    "benchmarks/reference-scores.ts",
    "dist/dashboard",
    ".env.example",
    "config/environment.reference",
    "README.md",
    "LICENSE",
    "dist/memory.js",
    "skills/marina-memory",
    "extensions/local-embeddings/index.ts",
    "extensions/local-embeddings/package.json",
    "extensions/local-embeddings/bun.lock",
    "extensions/local-embeddings/README.md",
    "extensions/langgraph-store/index.ts",
    "extensions/langgraph-store/package.json",
    "extensions/langgraph-store/bun.lock",
    "extensions/langgraph-store/README.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "dashboard",
    "site",
    "marina-desktop",
    "examples/usecase-ui",
    "examples/coding-agent-demo",
    "src/sdk"
  ],
  "scripts": {
    "forecast": "bun run scripts/forecast.ts",
    "arena": "bun run scripts/arena.ts",
    "futurex": "bun run scripts/futurex.ts",
    "metaculus": "bun run scripts/metaculus.ts",
    "swebench": "bun run scripts/swebench.ts",
    "start": "bun run src/main.ts",
    "code": "bun run scripts/code.ts",
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun && bun build src/memory/import-process.ts --outfile dist/memory-import.js --target bun && bun run build:memory",
    "test": "bun run scripts/test-backend.ts",
    "test:ui": "cd dashboard && bun run test",
    "test:browser": "bun run dashboard:build && cd dashboard && bun run test:browser e2e/discovery.spec.ts e2e/memory.spec.ts e2e/participation.spec.ts e2e/participant-streams.spec.ts e2e/workspace.spec.ts e2e/workspace-canvas.spec.ts e2e/workspace-panel-instances.spec.ts e2e/published-panels.spec.ts e2e/coding-desk.spec.ts",
    "test:fast": "bun run scripts/test-fast.ts",
    "test:shard": "bun run scripts/test-shard.ts",
    "test:serial": "bun test --path-ignore-patterns '**/dashboard/**' --path-ignore-patterns '**/examples/coding-agent-demo/**' --path-ignore-patterns '**/marina-desktop/**'",
    "test:coverage": "bun test --path-ignore-patterns '**/dashboard/**' --path-ignore-patterns '**/examples/coding-agent-demo/**' --path-ignore-patterns '**/marina-desktop/**' --coverage",
    "check:coverage": "bun run scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.benchmarks.json",
    "lint": "biome check src/ test/ dashboard/src/",
    "format": "biome format --write src/ test/ dashboard/src/",
    "schema:check": "bun scripts/generate-schema-baseline.ts --check",
    "docs:api": "bun --env-file=/dev/null scripts/generate-command-reference.ts",
    "docs:env": "bun --env-file=/dev/null scripts/generate-environment-reference.ts",
    "check:versions": "bun run scripts/check-versions.ts",
    "check:overrides": "bun run scripts/check-overrides.ts",
    "dashboard:dev": "cd dashboard && bunx vite",
    "dashboard:build": "cd dashboard && bunx vite build",
    "test:canvas:browser": "bun run dashboard:build && cd dashboard && bun run test:browser",
    "prepack": "bun run dashboard:build && bun run build:memory",
    "usecase-ui:dev": "cd examples/usecase-ui && bun run dev",
    "usecase-ui:build": "cd examples/usecase-ui && bun run build",
    "clean": "rm -f marina.db marina.db-shm marina.db-wal data/marina.db && rm -rf data/scratch/*",
    "bench": "bun run benchmarks/harness.ts",
    "bench:compare": "bun run benchmarks/compare.ts",
    "benchmark:import": "bun scripts/benchmark-import.ts",
    "bench:tier0": "bun run benchmarks/tier0.ts",
    "bench:context": "bun --env-file=/dev/null benchmarks/context-statistics.ts",
    "bench:ui": "bun run benchmarks/server.ts",
    "bench:native": "bun --env-file=/dev/null benchmarks/native/cli.ts",
    "init": "bun run scripts/init.ts",
    "prune-agent-users": "bun run scripts/prune-agent-users.ts",
    "eval-prompt": "bun run scripts/eval-prompt.ts",
    "qualify:prompt": "bun run scripts/eval-prompt.ts marina:answerer --min-score 13",
    "qualify:autonomy": "bun run scripts/qualify-autonomy.ts",
    "qualify:coding": "bun run scripts/qualify-coding.ts",
    "qualify:evolution": "bun run scripts/qualify-evolution.ts",
    "sbom": "bun scripts/generate-sbom.ts",
    "qualify:release": "bun run sbom && bun run check:versions && bun run schema:check && bun run qualify:sdk && bun run typecheck && bun run lint && bun run test && cd dashboard && bun run test && bun run build && cd .. && bun run qualify:server && cd dashboard && bun run test:browser && cd ../site && bun run build && cd .. && bun audit",
    "qualify:flywheel": "bun run scripts/qualify-flywheel-live.ts",
    "trial:evolution": "bun run scripts/run-evolution-trial.ts",
    "trial:evolution:local": "bun run scripts/run-evolution-trial-local.ts",
    "soak": "bun run test/load/flood.ts",
    "soak:churn": "bun run test/load/churn.ts",
    "soak:churn:local": "bun run scripts/run-churn-soak-local.ts",
    "memory": "bun run scripts/memory.ts",
    "qualify:memory": "bun run scripts/qualify-memory-service.ts",
    "qualify:memory:benchmark": "bun --env-file=/dev/null run scripts/qualify-memory-benchmark.ts",
    "qualify:paraphrase": "bun --env-file=/dev/null run scripts/qualify-paraphrase.ts",
    "qualify:decisions": "bun run scripts/qualify-decisions.ts",
    "qualify:memory:assistance": "bun run scripts/research/memory-assistance-qualification.ts",
    "qualify:memory:reliability": "bun run scripts/qualify-memory-reliability.ts",
    "build:memory": "bun build src/sdk/memory.ts --target browser --outfile dist/memory.js",
    "memory:mcp": "bun run scripts/memory-mcp.ts",
    "qualify:memory:storage": "bun run scripts/qualify-memory-storage.ts",
    "qualify:memory:sustained": "bun run scripts/qualify-memory-sustained.ts",
    "qualify:memory:scale": "bun run scripts/research/memory-scale-qualification.ts",
    "qualify:memory:utility": "bun run scripts/research/memory-utility-qualification.ts",
    "qualify:memory:task-workflows": "bun run scripts/research/memory-task-workflow-qualification.ts",
    "qualify:memory:workflow": "bun run scripts/research/memory-workflow-qualification.ts",
    "qualify:memory:resident": "bun run scripts/research/memory-resident-qualification.ts",
    "qualify:memory:clients": "bun run scripts/research/memory-coding-client-qualification.ts",
    "qualify:memory:load": "bun run scripts/qualify-memory-load.ts",
    "build:sdk": "bun run scripts/build-sdk.ts",
    "qualify:sdk": "bun run scripts/qualify-sdk.ts",
    "create:agent": "bun run scripts/create-agent.ts",
    "recovery": "bun scripts/recovery.ts",
    "qualify:image": "bun scripts/qualify-image.ts",
    "memory:compatibility": "bun scripts/memory-compatibility.ts",
    "qualify:server": "bun scripts/qualify-server.ts",
    "qualify:participation:load": "bun --env-file=/dev/null scripts/qualify-participation-load.ts",
    "test:properties": "bun run scripts/test-backend.ts --parallel=2 --timeout=120000 test/context-cache-property.test.ts test/command-order-property.test.ts test/context-security-property.test.ts",
    "test:explorer": "cd site && bun run build && cd ../dashboard && bun run test:browser --config playwright.explorer.config.ts",
    "test:mutation": "node node_modules/@stryker-mutator/core/bin/stryker.js run",
    "check:model": "bun --env-file=/dev/null scripts/check-session-model.ts",
    "bench:participation-context": "bun --env-file=/dev/null benchmarks/participation-context.ts",
    "check:context-performance": "bun --env-file=/dev/null scripts/check-context-benchmark.ts",
    "check:a11y": "bun run scripts/check-dashboard-accessibility.ts && biome lint dashboard/src --error-on-warnings",
    "test:a11y": "bun run check:a11y && bun run dashboard:build && cd dashboard && bun run test:browser e2e/accessibility.spec.ts",
    "tau2": "bun run scripts/tau2.ts",
    "repro": "bun run scripts/repro.ts"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@biomejs/biome": "^2.5.13",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "^1.4.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "discord.js": "^14.27.0",
    "grammy": "^1.46.0",
    "mathjs": "^15.2.0",
    "mcporter": "^0.13.12",
    "zod": "4.6.4"
  },
  "overrides": {
    "@hono/node-server": "^1.19.15",
    "@protobufjs/utf8": "^1.1.1",
    "basic-ftp": "^5.3.1",
    "body-parser": "^2.3.0",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.8",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "hono": "^4.13.5",
    "ip-address": "^10.7.2",
    "lodash": "^4.18.0",
    "path-to-regexp": "^8.4.0",
    "protobufjs": "^7.6.3",
    "qs": "^6.16.0",
    "undici": "^6.28.0",
    "ws": "^8.20.1",
    "zod": "4.6.4"
  },
  "patchedDependencies": {
    "electrobun@1.18.1": "marina-desktop/patches/electrobun@1.18.1.patch"
  },
  "optionalDependencies": {
    "better-auth": "^1.7.4",
    "jose": "^6.2.12"
  },
  "exports": {
    "./memory": {
      "types": "./src/sdk/memory.ts",
      "default": "./dist/memory.js"
    },
    "./*": "./*"
  },
  "packageManager": "bun@1.4.2"
}
