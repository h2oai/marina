# ═══════════════════════════════════════════════════════════════════════════
# Marina environment reference
#
# Every environment variable the Marina server and its world definitions read.
# This file is the catalog: the dashboard settings editor (Admin → Settings),
# the generated page docs/reference/environment.md and the documentation tests
# all parse it. It is not loaded at runtime. For a short starter, copy
# .env.example to .env instead.
#
# Everything is optional. With no configuration a loopback `bun run start`
# runs the ungated `local` trust profile.
#
# Format: a comment block describes the `# KEY=value` lines directly below it.
# A blank line or a bare `#` ends the block. Values shown are defaults or safe
# examples. Optional tag lines inside a block apply to every key in it:
#   @protected  the dashboard never writes it (edit .env or the process env)
#   @internal   hidden from the dashboard editor; Marina sets it, or only a
#               command-line client reads it
#   @restart    read once at startup; a change needs a restart
# Script, test, CI and SDK-example knobs are documented elsewhere:
# docs/guides/testing.md, docs/guides/release-qualification.md,
# src/sdk/examples/.env.example and examples/memory-service/.env.example.
# ═══════════════════════════════════════════════════════════════════════════

# ── Network and ports ────────────────────────────────────────────────────────

# WebSocket, web chat, dashboard and HTTP API port (the OpenAI- and Ollama-compatible /v1 and /api routes are served here too). 0 picks a free port for the listener, but internal agents and benchmark runs still dial 3300, so use a real port when agents run.
# @restart
# WS_PORT=3300

# Bind address for the WebSocket/HTTP and MCP listeners; the default is loopback only. Unless MARINA_ALLOW_INSECURE_PUBLIC=true, a non-loopback bind is fatal at startup when login is passwordless (MARINA_AUTH off, which also covers MARINA_AUTONOMY=open), when MARINA_OPEN_API=true, or under MARINA_PROFILE=local.
# @protected
# @restart
# WS_HOST=127.0.0.1

# Deprecated alias of WS_HOST (WS_HOST wins when both are set).
# @protected
# @restart
# MARINA_HOST=127.0.0.1

# true binds 0.0.0.0 without naming an interface. An explicit WS_HOST wins.
# @protected
# @restart
# MARINA_PUBLIC=false

# Acknowledge an unauthenticated non-loopback bind (see WS_HOST). Only for a network you control; prefer MARINA_AUTH=better-auth.
# @protected
# @restart
# MARINA_ALLOW_INSECURE_PUBLIC=false

# Telnet port. 0 (the default) is off. Telnet is plaintext and unauthenticated, and telnet sessions can never run host commands.
# @restart
# TELNET_PORT=0

# MCP (Model Context Protocol) port. Default: the bound WebSocket port + 1 (also with WS_PORT=0). 0 disables.
# @restart
# MCP_PORT=3301

# Real-time log viewer port. Default: the bound WebSocket port + 2 (also with WS_PORT=0). 0 disables.
# @restart
# LOG_PORT=3302

# Maximum concurrent WebSocket connections per client IP.
# @restart
# WS_MAX_CONNECTIONS_PER_IP=100

# Trust X-Forwarded-For when resolving the client IP for every per-IP rate limiter. Enable only behind a trusted reverse proxy.
# @protected
# MARINA_TRUST_PROXY=false

# When NODE_ENV=production and neither HTTPS_PROXY nor REVERSE_PROXY is set, Marina logs a hint that no TLS proxy was detected. Only presence matters. Bun's fetch also honours HTTPS_PROXY, HTTP_PROXY and NO_PROXY for outbound requests.
# @restart
# NODE_ENV=production
# REVERSE_PROXY=1
# HTTPS_PROXY=

# Human-readable instance name. Shown in the dashboard and stamped as the origin on federation and provenance records. Defaults to the world name.
# @restart
# MARINA_NAME=Marina

# ── API authentication and access ────────────────────────────────────────────

# Comma-separated bearer tokens accepted on /v1, the Ollama-compatible /api routes and MCP. Under the local profile Marina also generates a key into <DB_PATH>.local-api-key (mode 600) and prints it at boot, so local clients need nothing here.
# MODEL_API_KEYS=sk-marina-change-me

# Comma-separated secret:agent pairs for the /mem REST API and /api/probe. Unset keeps /mem closed, except with MARINA_OPEN_API=true or, under the local profile, the local model-API key plus an X-Agent-Name header.
# MEM_API_KEYS=sk-agent-1:scout

# Encrypts provider keys stored through Admin → Keys (AES-256-GCM, 16+ characters; generate with `openssl rand -base64 32`). Unset: Marina generates one in <DB_PATH>.key-secret (0600) and encrypts keys saved from then on; existing plaintext rows keep working, and an explicit value also migrates them. Back the secret (or that file) up with the database: changing or losing it orphans stored keys, which must then be re-entered. Environment provider keys are never stored.
# @protected
# @restart
# MARINA_KEY_SECRET=

# Development only: accept unauthenticated requests on the model, memory and dashboard read APIs. It does not grant operator actions: key and settings management, spawning and deletion still need an operator, and writes are refused outside the local profile. Fatal with a non-loopback bind unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# @protected
# MARINA_OPEN_API=false

# Comma-separated origins allowed for CORS. Unset sends no Access-Control-Allow-Origin header (same-origin only).
# ALLOWED_ORIGINS=http://localhost:5173

# Content-Security-Policy for the dashboard HTML. Unset uses the built-in policy; `off` drops the header; any other value replaces the policy verbatim.
# @protected
# MARINA_DASHBOARD_CSP=

# ── Sign-in (better-auth) ────────────────────────────────────────────────────

# `better-auth` requires human sign-in on the web chat and dashboard (email/password plus any configured OAuth providers) and rejects passwordless name login. A signed-in identity is bridged to a named Marina entity. Agents keep authenticating with session tokens. Off by default.
# @protected
# @restart
# MARINA_AUTH=better-auth

# Required with MARINA_AUTH=better-auth: 32+ characters (generate with `openssl rand -base64 32`; `bun run init --preset shared-team` writes one).
# @protected
# @restart
# BETTER_AUTH_SECRET=

# Public base URL of this instance, used in auth callbacks. Default http://localhost:<WS_PORT>.
# @restart
# BETTER_AUTH_URL=https://marina.example.com

# SQLite file for the auth tables, kept separate from the world database.
# @restart
# BETTER_AUTH_DB_PATH=marina-auth.db

# Comma-separated verified email addresses promoted to admin when sign-in is on. Replaces MARINA_ADMINS under MARINA_AUTH.
# @protected
# MARINA_AUTH_ADMIN_EMAILS=you@example.com

# OAuth sign-in providers. Set both the id and the secret to enable each one.
# @restart
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── Trust profile, autonomy and admins ───────────────────────────────────────

# Who this Marina is for. Derived when unset: `local` when every listener binds loopback and MARINA_AUTH is off, `shared` when MARINA_AUTH=better-auth, `public` for any non-loopback bind. `local` is ungated: all safety gates pass, loopback logins are sovereign, rate limits, login caps and memory admission budgets are off, and database durability defaults to `normal`; audit (exec decisions, cognitive ledger, memory receipts, trust labels) stays on. `shared` enforces gates, ranks and limits with sign-in identifying people; `public` enforces everything. `local` with a non-loopback bind is fatal unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# @protected
# @restart
# MARINA_PROFILE=local

# Autonomy posture, env-only by design. `guarded`: supervised gate attempts need a witness window. `earned`: agents with enough standing run supervised operations and a witness attests afterwards. `open`: every gate passes except the destructive core (key.manage, admin.destructive, shell.exec, code.exec.unrestricted, world.code); `open` does pass code.exec. Unset means `guarded`, except under the local profile, where unset is ungated and only an explicit `guarded` brings the gates back. `open` with a non-loopback bind and passwordless login is fatal.
# @protected
# @restart
# MARINA_AUTONOMY=guarded

# Comma-separated entity names promoted to sovereign on login, honoured only for loopback or in-process connections and ignored under MARINA_AUTH. Redundant under the local profile, where loopback logins are already sovereign.
# @protected
# MARINA_ADMINS=YourName

# Instance-wide cap on concurrent entity logins. 0 is unlimited. Internal room and crew agents are exempt (MAX_AGENTS caps them). Not enforced under the local profile.
# MARINA_MAX_LOGINS=0

# Login and reconnect attempts per minute per client IP (MCP sessions share their peer's bucket). 0 disables.
# @restart
# MARINA_LOGIN_ATTEMPTS_PER_MIN=10

# Absolute lifetime of a session token in milliseconds (default 7 days). Activity refreshes the 24-hour idle window only up to this cap; a reconnect mints a new session.
# MARINA_SESSION_MAX_AGE_MS=604800000

# ── Challenges and agent lineage ─────────────────────────────────────────────

# When a caller is refused by a rank floor or safety gate, Marina asks its creator and the admins with a token instead of only refusing; `challenge approve <token> [once|always]` re-runs the held command. `off` restores plain refusals.
# MARINA_CHALLENGES=on

# How long an unanswered challenge stays open, in milliseconds.
# MARINA_CHALLENGE_TTL_MS=3600000

# Challenge judge (needs a MARINA_DECISIONS backend). `observe` scores held commands in shadow. `on` also auto-approves `once` for a gate only after it earned that gate (25+ approved calls at 85% or better, 95% lower bound), never for the core gates, never `always`, never a deny. `challenge stats` shows the record.
# @protected
# MARINA_CHALLENGE_JUDGE=off

# Deepest spawn lineage an agent may extend (lead → sub-lead → specialist).
# MARINA_MAX_SPAWN_DEPTH=3

# Standing per concurrent child an earned spawner may keep alive (budget = floor(standing / this), capped by MAX_AGENTS).
# MARINA_STANDING_PER_SPAWNED_CHILD=25

# Total copies `evolve replicate` may seed from one accepted run.
# MARINA_MAX_REPLICAS_PER_RUN=5

# `here` lets a dedicated parallel world run `evolve trial` itself. Trials otherwise run only in a World Collective child. Never set it on a world you care about.
# @protected
# MARINA_EVOLVE_TRIALS=

# Standing decay half-life in days (minimum 1; a non-numeric value falls back to 60). Shorter means rank derived from standing demotes faster.
# @restart
# STANDING_HALF_LIFE_DAYS=60

# ── World ────────────────────────────────────────────────────────────────────

# World definition to load: the file name of any module in worlds/ (default, showcase, commons, research, evolve, empty, …).
# @restart
# MARINA_WORLD=default

# Room where new players spawn. Defaults to the world's start room.
# @restart
# START_ROOM=

# Engine tick interval in milliseconds.
# @restart
# TICK_MS=1000

# Wall-clock budget for the per-tick command phase, in milliseconds.
# @restart
# MARINA_COMMAND_PHASE_BUDGET_MS=150

# Macro expansion limits: nesting depth (a macro that runs a macro …) and commands one top-level macro invocation may expand to. 0 is unlimited. Unset, the shared/public defaults are 8 and 100, and the local-ungated profile or MARINA_AUTONOMY=open is unlimited. A macro cycle is always refused, and every expanded command still costs one rate-limit token.
# MARINA_MACRO_MAX_DEPTH=8
# MARINA_MACRO_MAX_EXPANSIONS=100

# `false` suppresses every room-agent auto-spawn (the LLM agents rooms start on first entry). Any other value leaves it on. Room agents need a provider key.
# MARINA_ROOM_AGENTS=true

# Model for the default Workbench's Host, Builder, Critic and Chronicler. Unset tries MARINA_CREW_MODEL, then openai/gpt-6-luna (OPENAI_API_KEY), openrouter/openai/gpt-6-luna (OPENROUTER_API_KEY), huggingface/zai-org/GLM-5.3-Flash (HUGGINGFACE_API_KEY or HF_TOKEN), then marina/default.
# @restart
# MARINA_WORKBENCH_MODEL=openai/gpt-6-luna

# Shared crew-model override for the Workbench, Showcase and focused single-outcome worlds.
# @restart
# MARINA_CREW_MODEL=marina/default

# Showcase world only: size of the answerer crew and per-crew model overrides (each falls back to MARINA_CREW_MODEL).
# @restart
# MARINA_ANSWERER_COUNT=4
# MARINA_ANSWERER_MODEL=
# MARINA_MATH_MODEL=
# MARINA_REFLECTOR_MODEL=

# Per-agent model map for boot-seeded agents, any world: comma list of Name=model (names case-insensitive; the model string passes through as-is). Wins over the per-role variables above and MARINA_CREW_MODEL. Applied on every boot to agents the seed still owns — a user-customized or retired agent is never touched — exactly like the per-role variables. A name matching no seeded agent, or a malformed entry, is logged as a warning at boot.
# @restart
# MARINA_AGENT_MODELS=Answerer=openrouter/anthropic/claude-opus-5.5,Translator=openrouter/deepseek/deepseek-v4-pro-0813

# Showcase world only: which autonomous coordinators to seed beyond marina:answerer (comma list of council, debate, decompose; empty or `none` seeds none). Unset seeds all three. Each is a loop that spends tokens even when its endpoint is never called.
# @restart
# MARINA_ENDPOINTS=council,debate,decompose

# Showcase world only: `true` seeds the universal skill packages.
# @restart
# MARINA_SEED_SKILLS=false

# `false` disables the verified-arithmetic fast path on marina:answerer (simple arithmetic otherwise returns without a crew round).
# MARINA_MODEL_FAST_PATH=true

# `false` turns off model synthesis in `ask` and `dig` (retrieval only) and the model interpretation pass in `desire`. Any other value keeps them on.
# MARINA_ASK_MODEL=true

# `true` enables native evolution protocols: passive experiment lineage and evidence analysis over the experiment command. Nothing is auto-run or auto-promoted.
# MARINA_EVOLUTION_PROTOCOLS=false

# `true` makes the retired Unified Canvas (ReactFlow world graph) reachable at /?unified.
# MARINA_UNIFIED_CANVAS=false

# ── Storage ──────────────────────────────────────────────────────────────────

# SQLite world database path.
# @restart
# DB_PATH=marina.db

# World database durability: `full` (fsync per commit) or `normal` (WAL, crash-safe, small power-loss window). Default `normal` under the local profile, `full` otherwise.
# @restart
# MARINA_DB_DURABILITY=full

# Directory for uploaded assets.
# @restart
# ASSETS_DIR=data/assets

# ── Model provider keys ──────────────────────────────────────────────────────

# Anthropic API key. Set one provider key for agents that think; OPENROUTER_API_KEY is the most versatile because `forecast` and the arena research path also need it. Environment keys and keys added in Admin → Keys both work on every path; the environment wins and survives database resets.
# ANTHROPIC_API_KEY=

# OpenAI API key.
# OPENAI_API_KEY=

# Google Gemini API key (GOOGLE_API_KEY is accepted as an alias).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Groq API key.
# GROQ_API_KEY=

# OpenRouter API key. Also required by the `forecast` command and POST /v1/forecast.
# OPENROUTER_API_KEY=

# Hugging Face Inference Providers key (router.huggingface.co). Address models as `huggingface/<org>/<model>`, optionally suffixed `:fastest`, `:cheapest` or `:<provider>`. HF_TOKEN is accepted as well.
# HUGGINGFACE_API_KEY=
# HF_TOKEN=

# More OpenAI-compatible providers. Each is also an upstream for marina/default (defaults: gpt-oss-120b, deepseek-flash, mistral-small-latest, grok-4.7; override with MARINA_DEFAULT_<PROVIDER>_MODEL).
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# ── Local model runtimes ─────────────────────────────────────────────────────

# llama.cpp server (OpenAI-compatible). Setting the base URL or the key opts in; llama is then the first marina/default fallback. Address models as `llama/<id>`. The key is only needed when the server runs with --api-key.
# @restart
# LLAMA_BASE_URL=http://localhost:8080/v1
# LLAMA_API_KEY=

# Ollama (OpenAI-compatible, usually keyless). Setting the base URL or the key opts in as a marina/default fallback after llama. Address models as `ollama/<id>`.
# @restart
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# VibeThinker served by vLLM or SGLang. Usable only as an explicit `vibethinker/<id>` model, never as a marina/default fallback. In Docker it is the optional `vibethinker` compose profile, whose own VIBETHINKER_MODEL, VIBETHINKER_CTX and VIBETHINKER_MODELS_DIR are read by docker-compose.yml, not by Marina.
# @restart
# VIBETHINKER_BASE_URL=http://localhost:8000/v1
# VIBETHINKER_API_KEY=

# Pin the context window (tokens) the agent compactor budgets against. Normally autodetected at launch (llama.cpp /props, Ollama /api/show); these win over the probe. Without either, llama uses 16384, Ollama 8192 and VibeThinker 40960.
# @restart
# LLAMA_CONTEXT_WINDOW=16384
# OLLAMA_CONTEXT_WINDOW=8192
# VIBETHINKER_CONTEXT_WINDOW=

# Context window assumed for marina/default. Set it when marina/default proxies to a small local model, or requests overflow it.
# MARINA_DEFAULT_CONTEXT_WINDOW=128000

# Share of a local model's context window reserved for output (0 < f ≤ 0.5; higher values are clamped). It scales with the configured window, so pin a real window above for large local servers.
# MARINA_LOCAL_OUTPUT_FRACTION=0.25

# Optional hard cap in tokens on local-model output. Unset applies the fraction alone.
# MARINA_LOCAL_MAX_OUTPUT_TOKENS=32768

# Characters per token in the compactor's prompt-size estimate. Lower compacts earlier; raising it risks oversized prompts the upstream rejects.
# MARINA_TOKEN_CHARS_PER_TOKEN=3

# Tool-result text block cap. Unset: max(2000, 15% of the effective prompt window), recalculated after model changes and overflow recovery. A positive integer sets a fixed cap. Truncation is labeled; originals are archived before compaction. Prefer narrower retrievals when a result exceeds the cap.
# MARINA_MAX_TOOL_RESULT_TOKENS=2000

# ── Default and fallback models ──────────────────────────────────────────────

# Model for agents spawned without one, and the fallback for unrecognized models. marina/default calls this instance's own /v1, which routes to whichever provider has a key. A default model set at runtime (dashboard or `admin`) wins.
# MARINA_DEFAULT_MODEL=marina/default

# Model /v1 uses on each provider when it proxies directly upstream (no model agent is online for the requested channel). The variable name is MARINA_DEFAULT_<PROVIDER>_MODEL.
# MARINA_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-5
# MARINA_DEFAULT_OPENAI_MODEL=gpt-6-luna
# MARINA_DEFAULT_GEMINI_MODEL=gemini-3.1-flash-lite
# MARINA_DEFAULT_OPENROUTER_MODEL=openai/gpt-6-luna
# MARINA_DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
# MARINA_DEFAULT_HUGGINGFACE_MODEL=zai-org/GLM-5.3-Flash
# MARINA_DEFAULT_LLAMA_MODEL=local-model
# Ollama default: the first model in Ollama's /api/tags (read at boot), else qwen3:4b.
# MARINA_DEFAULT_OLLAMA_MODEL=qwen3:4b

# Upstream timeout for /v1 requests in milliseconds. Non-streaming client connections also close at Bun's 255-second idle limit.
# MODEL_REQUEST_TIMEOUT_MS=600000

# `0` stops re-posting an unanswered routed model_request as a reminder at 25% and 60% of the timeout.
# MODEL_REQUEST_REMINDERS=1

# Output-token cap marina/default sends upstream per completion (also the compactor's output reservation). Extended thinking on this path is clamped to this value minus 1024.
# MARINA_DEFAULT_MAX_TOKENS=16384

# ── Agent runtime ────────────────────────────────────────────────────────────

# Restart saved agents at boot, including world-seeded ones such as the Workbench population and the Chronicler. Unset: on for a local install (local profile) with a usable provider, off otherwise; `true`/`false` overrides. `readiness` shows what is live.
# @restart
# AGENT_AUTORESPAWN=false

# Maximum concurrently running agents.
# @restart
# MAX_AGENTS=30

# Maximum agent uptime in milliseconds before the runtime stops it (default 24 hours).
# @restart
# MAX_AGENT_UPTIME_MS=86400000

# Comma-separated agent names that seeders, autorespawn and room-agent spawning must not bring back. `agent disable <name>` does the same in-world and persists.
# MARINA_DISABLED_AGENTS=

# Renewable lease on a newly claimed task, in milliseconds. Workers renew with `task heartbeat <id>`; expired ordinary work reopens.
# MARINA_TASK_LEASE_MS=900000

# Output-token cap for request-driven (crew) agents. Unset: 2048 with thinking off; with thinking enabled, pi-ai's thinking budget + 2048 answer/tool tokens, bounded by the provider output limit and half the context window. An explicit insufficient cap is honored with a warning; reasoning depth may be reduced.
# AGENT_CREW_MAX_TOKENS=2048

# Output-token cap for cloud agents using the compact tool profile. Unset: 4096 with thinking off; with thinking enabled, pi-ai's thinking budget + 2048 answer/tool tokens, bounded by the provider output limit and half the context window. An explicit insufficient cap is honored with a warning.
# AGENT_COMPACT_MAX_TOKENS=4096

# Tool calls one agent run may make before it yields. Unset: 8 for crew responders, 16 for autonomous agents. A value applies to both.
# AGENT_MAX_TOOL_CALLS_PER_RUN=16

# Model calls one prompt may take before the loop yields to the next cycle.
# MARINA_MAX_TURNS_PER_PROMPT=24

# Ceiling on public channel sends per agent run. Each agent's own budget defaults to 1 and may be set up to this ceiling with `memory set channel_sends <n>`; 0 disables agent channel sends. Tells are never capped.
# MARINA_CHANNEL_SENDS_PER_RUN=3

# Quiet-cycle and active-cycle intervals for autonomous agents, in milliseconds. Defaults: idle max(60000, 5 × cycle delay); active max(15000, cycle delay).
# AGENT_IDLE_TICK_MS=60000
# AGENT_ACTIVE_TICK_MS=15000

# Minimum gap between an agent's replies on one channel, in milliseconds.
# AGENT_CHANNEL_REPLY_COOLDOWN_MS=30000

# Default extended-thinking level for spawned agents: off, minimal, low, medium, high or xhigh. `agent spawn … thinking:<level>` wins; crew responders stay off unless set explicitly.
# MARINA_AGENT_THINKING=off

# Multi-tool turn execution. `auto` runs batches containing a world-mutating tool in order and fans read-only batches out; `parallel` and `sequential` apply to every batch.
# MARINA_TOOL_EXECUTION=auto

# `off` keeps every typed tool schema resident in the `full` tool profile. On by default: the core set is resident and other tools load by name through `marina_tool_search`.
# MARINA_DEFERRED_TOOLS=on

# `off` stops agents' marina/* requests carrying prompt-cache markers and a per-agent session id. On by default; Marina's proxy strips the markers for upstreams that reject them.
# MARINA_AGENT_PROMPT_CACHE=on

# `off` sends tools without `strict: true`. On by default for closed, all-required schemas; upstreams that do not implement strict mode ignore it.
# MARINA_STRICT_TOOLS=on

# `off` omits the tools prose section from the lean agent system prompt.
# MARINA_SYSTEM_TOOLS_PROSE=on

# Byte allowance for per-cycle context. Unset: effective prompt tokens / 8, clamped to 6000–16000 bytes. Automatic memory gets 2048–4096 content bytes. A fixed override has a minimum of 1000; mandatory sections can exceed it. Optional sections are deferred and remain eligible on the next scheduled cycle.
# MARINA_CONTINUATION_BUDGET_BYTES=6000

# Clamp in characters for a model_request perception line (minimum 400). Its content is the caller's question. Other addressed requests and JSON results get 1200 chars; ambient chatter gets 400.
# MARINA_PERCEPTION_MODEL_REQUEST_MAX_CHARS=2000

# What forces a tool call after a silent turn. `all` (default): any addressed or high-priority event. `requests`: only an event that owes a reply — a request tell, an addressed post whose body is a request, or a request already in the reply ledger; addressed information still wakes the agent but is not tracked as owed or nudged.
# MARINA_FORCED_ACTION_NUDGE=all

# Absolute cap on an agent's conversation, in estimated tokens (system prompt and tool schemas excluded). Default 48000; `0`/`off` disables it (compaction then fires only near the model window); explicit values below 8000 are raised to 8000. Once the cap is reached after the agent's first run, the history is compacted to MARINA_AGENT_CONTEXT_TARGET_TOKENS (default a third of the cap) and kept; the originals are archived first. The near-window trigger still applies when it comes first. The built-in default exempts an agent bound to an active Code Mode task; an explicit value applies to every agent.
# MARINA_AGENT_CONTEXT_CAP_TOKENS=48000
# MARINA_AGENT_CONTEXT_TARGET_TOKENS=16000

# Removes reasoning blocks (text and provider signature) from assistant messages of earlier runs between prompts; the latest run is untouched, OpenAI Responses-API messages are skipped, and the originals stay in the continuity journal. On by default; `off` keeps every reasoning block.
# MARINA_DROP_OLD_THINKING_SIGNATURES=on

# Provider-level retries inside one request (transient 5xx, short 429) before the loop's own backoff. 0 disables.
# MARINA_PROVIDER_MAX_RETRIES=2

# `on` keeps an agent's own command echoes (memory-service acknowledgements, its `You tell …` receipts) in its world-event buffer. Off by default; messages from others are never filtered.
# MARINA_PERCEIVE_SELF_ECHO=off

# Stop a `reflect`-spawned memory reflector after this many idle milliseconds with no assistance job. 0 disables.
# MARINA_REFLECTOR_IDLE_STOP_MS=600000

# `true` records full, payload-bearing cognitive provenance. Off by default.
# MARINA_COGNITIVE_PROVENANCE=false

# ── Spend limits and failure breaker ─────────────────────────────────────────

# Daily USD cap (UTC day, persisted) on everything this world pays upstream: /v1 passthru, agent turns, decision backends, forecasts and priced media jobs. At the cap /v1 returns 429 spend_cap_reached, decisions, forecasts and priced media jobs are refused and agents pause until 00:00 UTC. Default 50; 0 or off = no cap; an invalid value keeps the default. `readiness` shows today's spend.
# @protected
# MARINA_DAILY_SPEND_CAP_USD=50

# Daily cap a World Collective child world starts with (default 50, never above the parent's cap; 0 or off = the parent's cap).
# @protected
# MARINA_CHILD_DAILY_SPEND_CAP_USD=50

# Rolling one-hour USD caps on agent model spend, across all agents and per agent. Unset or 0 is unlimited. At a cap the agent pauses, tells its spawner, and resumes once last-hour spend drops. Local models count as $0.
# @protected
# MARINA_MAX_COST_USD_PER_HOUR=5
# MARINA_MAX_AGENT_COST_USD_PER_HOUR=1

# Consecutive upstream or loop errors (429, 5xx, timeouts) before an agent pauses for MARINA_UPSTREAM_ERROR_PAUSE_MS milliseconds and tells its spawner once.
# MARINA_MAX_CONSECUTIVE_UPSTREAM_ERRORS=20
# MARINA_UPSTREAM_ERROR_PAUSE_MS=600000

# ── Code Mode ────────────────────────────────────────────────────────────────

# Comma-separated directories `code` sessions may operate in. With neither this nor MARINA_CODE_DEFAULT_ROOT set, the working directory is a read-only root and host edits and command execution are refused. `marina .` sets this for the folder it opens.
# @restart
# MARINA_CODE_ROOTS=/workspaces/project-a

# Default root for new sessions (must be inside MARINA_CODE_ROOTS). Defaults to the first root; set alone it also enables host execution in that directory.
# @restart
# MARINA_CODE_DEFAULT_ROOT=

# Comma-separated entity ids or names eligible for headless approval of arbitrary (non-allowlisted) host commands. Each also needs the code.exec.unrestricted gate unsupervised and a trusted identity on the acting connection (signed in, or loopback). Interactive approval (`code exec-mode prompt`) does not use this list.
# @protected
# MARINA_CODE_EXEC_UNRESTRICTED=

# Interactive exec-approval prompt timeout in milliseconds.
# MARINA_CODE_EXEC_APPROVAL_TIMEOUT_MS=120000

# Container runtime for container-backed workspaces (`podman` or `docker`). Unset picks podman, then docker. With neither installed, a container runner refuses every command; it never falls back to host execution.
# MARINA_CODE_CONTAINER_RUNTIME=

# Operator default container runner for local Code Mode sessions without an explicit `code workspace runner` setting: finite commands (tests, scripts) run inside this image instead of on the host. Same allowlist, approvals and code.exec gate as host runs; no network unless MARINA_CODE_CONTAINER_NETWORK is on; capabilities dropped; CPU/memory/pid limits. SYNC=mount (default) binds the worktree at WORKDIR (default /work) on a read-only root; SYNC=patch mounts nothing and applies the pending diff inside a throwaway container whose image already holds the project at WORKDIR. INIT is a one-line environment preamble (e.g. activating a conda env) run by SHELL (sh or bash).
# MARINA_CODE_CONTAINER_IMAGE=
# MARINA_CODE_CONTAINER_SYNC=mount
# MARINA_CODE_CONTAINER_WORKDIR=/work
# MARINA_CODE_CONTAINER_INIT=
# MARINA_CODE_CONTAINER_SHELL=sh
# MARINA_CODE_CONTAINER_NETWORK=off

# ── Flywheel sandboxes ───────────────────────────────────────────────────────

# Flywheel isolated execution: the operator token (kept server-side; Marina mints short-lived per-entity capabilities), RPC endpoint and guest image. Unset token disables Flywheel.
# @restart
# FLYWHEEL_TOKEN=
# FLYWHEEL_RPC_URL=http://localhost:8088/rpc
# FLYWHEEL_IMAGE=localhost/h2oai/flywheel-agentd:latest

# Public-service lease in milliseconds (values under 60000 are ignored).
# MARINA_FLYWHEEL_PUBLICATION_TTL_MS=3600000

# Fleet admission and lifecycle limits (counts 1–10000; durations at least 60000 ms). Flywheel sizes CPU, RAM and disk itself.
# MARINA_FLYWHEEL_MAX_SANDBOXES=100
# MARINA_FLYWHEEL_MAX_RUNNING_SANDBOXES=50
# MARINA_FLYWHEEL_IDLE_HIBERNATE_MS=3600000
# MARINA_FLYWHEEL_ABSOLUTE_LIFETIME_MS=86400000
# MARINA_FLYWHEEL_TELEMETRY_RETENTION_MS=604800000

# ── Media generation ─────────────────────────────────────────────────────────

# Image and video provider keys (OpenAI and Google reuse OPENAI_API_KEY and GEMINI_API_KEY). Stability, Black Forest Labs (Flux, with an optional base URL), Runway and Luma. See docs/guides/media.md for model ids.
# STABILITY_API_KEY=
# BFL_API_KEY=
# BFL_BASE_URL=
# RUNWAY_API_KEY=
# LUMA_API_KEY=

# Automatic1111 or SD.Next web UI for `automatic1111/<checkpoint>` images (AUTOMATIC1111_BASE_URL is accepted as an alias). Keyless unless the server requires one.
# A1111_BASE_URL=http://localhost:7860
# A1111_API_KEY=

# Any OpenAI-compatible image server: set <PROVIDER>_IMAGE_BASE_URL and <PROVIDER>_API_KEY, then use `<provider>/<model>`. Together is shown as an example.
# TOGETHER_IMAGE_BASE_URL=https://api.together.xyz/v1
# TOGETHER_API_KEY=

# Image and video jobs per entity per rolling 24 h (defaults 50 and 5). 0 is unlimited.
# MAX_IMAGE_JOBS_PER_DAY=50
# MAX_VIDEO_JOBS_PER_DAY=5

# ── Search ───────────────────────────────────────────────────────────────────

# Web search upgrades. Search works with no key (DuckDuckGo plus arXiv, PubMed and Semantic Scholar); Tavily or a self-hosted SearXNG improves results. Forecast and arena retrieval use OpenRouter web search instead.
# @restart
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# ── Chat adapters ────────────────────────────────────────────────────────────

# Telegram bot token (from @BotFather). Unset leaves the adapter off.
# TELEGRAM_TOKEN=

# Discord bot token. Unset leaves the adapter off.
# DISCORD_TOKEN=

# Comma-separated Discord channel ids the bot operates in. Empty means every channel the bot can read.
# DISCORD_CHANNEL_IDS=

# ── Federation ───────────────────────────────────────────────────────────────

# Shared secret for the gateway handshake: outgoing gateway connections send it and incoming ones must present it before logging in, or the socket closes. It does not fence bridged-channel participation or cross-instance tells; a hard boundary also needs MARINA_AUTH=better-auth. Unset allows any peer.
# @protected
# GATEWAY_SECRET=

# Drop a bridged channel message or tell that has already crossed this many instances.
# MARINA_MAX_RELAY_HOPS=3

# Ed25519 federation identity (base64 PKCS#8 DER, or PEM with escaped newlines). Set to publish signed v2 manifests; unset publishes unsigned v1.
# @restart
# MARINA_FEDERATION_SIGNING_KEY=

# `true` accepts unsigned cross-world mesh events on `mesh replicate`, whose origin cannot be verified. Only between development instances on a trusted network.
# @protected
# MARINA_FEDERATION_ALLOW_UNSIGNED=false

# ── Harness decisions ────────────────────────────────────────────────────────

# Decision backend for cheap per-step judgements (off by default; it receives tool names and redacted arguments). `decisions-api` (alias `jev`): a Jev-family model over the Decisions API on OpenRouter, or a self-hosted OpenJev. `typesafe`: TypeSafe's API. `chat-classifier` (aliases `classifier`, `llm`): any chat model (see MARINA_DECISION_MODEL). Every MARINA_DECISION* setting except base URLs, paths and API keys can also be changed at runtime (`admin decisions set …`, Admin → Ops → Decisions); a value set here wins and locks it.
# MARINA_DECISIONS=off

# Backend model. Defaults: typesafe/jev-1.13 for decisions-api, jev-latest for typesafe; chat-classifier uses openai/gpt-6-luna on OpenRouter or zai-org/GLM-5.3-Flash on the Hugging Face router, and any other base URL must name a model.
# MARINA_DECISION_MODEL=typesafe/jev-1.13

# Backend endpoint. Defaults: https://openrouter.ai/api/alpha (decisions-api), https://api.typesafe.ai (typesafe), https://openrouter.ai/api/v1 (chat-classifier).
# @protected
# MARINA_DECISION_BASE_URL=https://openrouter.ai/api/alpha

# Backend key. Unset falls back by host: OPENROUTER_API_KEY for openrouter.ai, TYPESAFE_API_KEY for api.typesafe.ai, HUGGINGFACE_API_KEY or HF_TOKEN for router.huggingface.co.
# @protected
# MARINA_DECISION_API_KEY=

# Decisions API path (typesafe uses /v1/systemone).
# @protected
# MARINA_DECISION_PATH=/decisions

# TypeSafe API key, used by the typesafe backend.
# TYPESAFE_API_KEY=

# Backend timeout in milliseconds (default 2000; 8000 for chat-classifier).
# MARINA_DECISION_TIMEOUT_MS=2000

# Chat models served as Jev-compatible engines on /v1/systemone as `marina/classifier:<model>`, through Marina's own passthru and spend ledger. Comma list, or `*` for any model Marina routes. Works with or without MARINA_DECISIONS. GET /v1/decisions/models lists them.
# MARINA_DECISION_ENGINES=

# How chat classifiers get probabilities: auto, logprobs, sampled or verbalized. Unset: engines use auto and a chat-classifier backend stays verbalized.
# MARINA_DECISION_METHOD=

# Calls per decision for the sampled method (clamped 2–15).
# MARINA_DECISION_SAMPLES=5

# Members of the `marina/ensemble` engine, which asks them in parallel and needs a strict majority to answer. `marina/auto` asks the backend first and consults the ensemble (else the first engine) only when unsure or down. Classifier members must be admitted by MARINA_DECISION_ENGINES.
# MARINA_DECISION_ENSEMBLE=

# Earned gate calibration file written by `bun run qualify:decisions -- --calibrate <file>`. Applied only to a backend whose fit was earned; a missing, invalid or group/world-writable file changes nothing.
# MARINA_DECISION_CALIBRATION=

# Run Marina's own harness (tool gate, spawn routing, task verifier, `decision` commands) on an engine such as marina/auto instead of the configured backend. Unresolvable falls back to the backend with a readiness warning.
# MARINA_DECISION_ENGINE=

# How long `marina/auto` waits for a second opinion before the primary's answer stands (milliseconds; `0` = no limit). Not applied when the primary failed: the fallback is then the only judge.
# MARINA_DECISION_SECOND_OPINION_TIMEOUT_MS=3000

# Adopted gate-question wording file written by `bun run qualify:decisions -- --adopt <file>`. Refused unless the variant earned a held-out win.
# MARINA_DECISION_GATE_QUESTIONS=

# `on` scores mutating agent tool calls before they run (fail-closed; reads and messages are never sent). Needs a backend.
# MARINA_DECISION_GATE=off

# With the gate on, also send the agent's operator-set intent and the trust labels of its prompt inputs (never the content). `off` sends the call only.
# MARINA_DECISION_GATE_CONTEXT=on

# How long an ask-a-person verdict's challenge stays open, in milliseconds. Defaults to MARINA_CHALLENGE_TTL_MS.
# MARINA_DECISION_APPROVAL_TIMEOUT_MS=3600000

# Verify `task submit` deliverables: `on` bounces a weak first attempt once (advisory; the creator still approves); `observe` records the judge's opinion without acting. Needs a backend.
# MARINA_DECISION_VERIFY=off

# ── Model routing ────────────────────────────────────────────────────────────

# Tiers for `agent spawn <name> model:route goal:<…>`, chosen once at spawn and persisted. With neither tiers nor MARINA_ROUTES set, model:route refuses the spawn; with tiers but no backend or goal, the powerful tier is used.
# MARINA_ROUTE_FAST_MODEL=openai/gpt-6-luna
# MARINA_ROUTE_POWERFUL_MODEL=anthropic/claude-opus-5-5

# Route table (JSON object of name → {model, criteria}); wins over the two tiers. Low confidence (< 0.6), no backend or an error use MARINA_ROUTE_FALLBACK (default `powerful` if present, else the last route).
# MARINA_ROUTES={"cheap":{"model":"openai/gpt-6-luna","criteria":"Lookups and small edits."},"powerful":{"model":"anthropic/claude-opus-5-5","criteria":"Architecture and unclear failures."}}
# MARINA_ROUTE_INSTRUCTIONS=Choose the least costly model that can complete the task.
# MARINA_ROUTE_FALLBACK=powerful

# Benchmark evidence for model:route (src/engine/benchmark-evidence.ts). After the router picks, measured ledger results may prefer another of the SAME candidates: the best Wilson lower bound among at least two candidates with MIN_N items in the role's families (and within MAX_COST_USD per item, when set). `observe` records the pick on the route decision without acting; `on` applies it. Resolved once at spawn and persisted; any error keeps the router's choice. Families: a comma list of benchmark names for every role, or JSON {"*": [...], "<role>": [...]}; with none, evidence never applies. Evidence is traced participants and direct-model runs; window evidence only with MARINA_ROUTE_EVIDENCE_WINDOW=true, shared window evidence never. Inspect with `trace advise evidence <benchmark>`.
# MARINA_ROUTE_EVIDENCE=off
# MARINA_ROUTE_EVIDENCE_FAMILIES=hle-verified-gold,frames
# MARINA_ROUTE_EVIDENCE_MIN_N=30
# MARINA_ROUTE_EVIDENCE_MAX_COST_USD=0.05
# MARINA_ROUTE_EVIDENCE_WINDOW=false

# What the evidence pick optimizes.
# - `lcb` (default): the best Wilson lower bound.
# - `budget`: the best lower bound within MARINA_ROUTE_EVIDENCE_MAX_COST_USD per item; it never picks without a budget.
# - `value`: the CHEAPEST priced candidate not measurably worse than the best-lower-bound one. Its point accuracy must be within TOLERANCE (absolute, 0–1) of the best's. With at least MIN_N shared items, a paired exact McNemar test must not show a significant loss (p < 0.05); otherwise its interval must overlap the best's lower bound.
# Evidence is per role first (participants whose agent plays the spawning role) and falls back to model level when fewer than two candidates have MIN_N role items.
# MARINA_ROUTE_EVIDENCE_OBJECTIVE=lcb
# MARINA_ROUTE_EVIDENCE_TOLERANCE=0.05

# Replicates a challenger needs before `benchmark promote` reads a slot's holdout (src/engine/benchmark-promotion.ts). A replicate is another ledger run of the same target on the same items with the same judge (one replicate group). With replicates on either side, the paired interval is a two-stage bootstrap (runs, then items), so run-to-run variance counts against the gain. An integer from 1 to 100; 1 restores single-run promotion. Anything else is the default.
# MARINA_PROMOTION_MIN_REPLICATES=2

# ── Forecasting ──────────────────────────────────────────────────────────────

# `forecast`, `bun run forecast` and POST /v1/forecast (docs/guides/forecasting.md). The defaults need OPENROUTER_API_KEY. Analysts are a comma list of models (defaults: DeepSeek V4 Pro, Claude Sonnet 5 and GPT-6 Luna via OpenRouter); the retriever defaults to OpenRouter web search on GPT-6 Luna; the judge is jev, decisions (the MARINA_DECISIONS backend, falling back to jev) or none.
# MARINA_FORECAST_ANALYSTS=openrouter/deepseek/deepseek-v4-pro,openrouter/anthropic/claude-opus-5.5,openrouter/openai/gpt-6-luna
# MARINA_FORECAST_RETRIEVER=openrouter-web:openai/gpt-6-luna
# MARINA_FORECAST_JUDGE=jev

# Typed forecasts (a choice, a set of options, a number, a ranking or a short string; `forecast … type:<t>`, `bun run forecast --type`, POST /v1/forecast with `answer`). The retriever also accepts sonar:<model>, tavily:<basic|advanced> (TAVILY_API_KEY) and asof[:<providers>] (keyless and date-strict, bounded to each forecast's cutoff: gdelt, wikipedia, hn, arxiv, wayback; docs/guides/search.md), comma-separated to merge. The planner decomposes the question and names research gaps (default: the first analyst); the critic searches for evidence against the leading answer and may revise it only when its confidence exceeds the runs' agreement (default: the planner). RUNS independent answers (1–9, analysts used round-robin) are combined by type; RESEARCH_ROUNDS bounds the search loop (1–4); CRITIQUE=off skips the disconfirmation pass. LOOKUPS adds optional structured sources, a comma list (empty means none): polymarket and kalshi (market prices; a past cutoff reads the last price at or before it, never the resolution), odds (sports head-to-head odds via ODDS_API_KEY; historical snapshots need a paid plan), fred (official series; vintage-correct for a past cutoff with FRED_API_KEY, live-only without), bls (live-only), or markets / all. A number is anchored on the freshest official reading with a horizon-scaled spread.
# MARINA_FORECAST_PLANNER=openrouter/deepseek/deepseek-v4-pro
# MARINA_FORECAST_CRITIC=openrouter/deepseek/deepseek-v4-pro
# MARINA_FORECAST_RUNS=3
# MARINA_FORECAST_RESEARCH_ROUNDS=2
# MARINA_FORECAST_CRITIQUE=on
# MARINA_FORECAST_LOOKUPS=

# Verification inside a typed forecast: with VERIFY=on each run's draft is checked by VERIFIER (default: the critic) against the dossier and the resolution rules before it is combined, and a concrete correction replaces it. RETRIEVAL_FILTER=strict keeps only research lines whose every cited page is provably published on or before the evidence cutoff (engine date, else a date in the URL) and that name no later day; undated and live-result pages are dropped. Use it for past-cutoff forecasts (replays, backtests); date-filtered engines (tavily:, exa:) need no filter, and `closed-book` as the retriever disables retrieval.
# MARINA_FORECAST_VERIFY=off
# MARINA_FORECAST_VERIFIER=openrouter/anthropic/claude-opus-5
# MARINA_FORECAST_RETRIEVAL_FILTER=none

# Exa search for forecast and arena retrieval (`exa:auto`, `exa:neural`, `exa:keyword`): filtered server-side by publication date to the brief's window, so it is a date-filtered engine.
# @restart
# EXA_API_KEY=
# Keys for forecast lookups (each lookup is skipped when its key is unset): The Odds API (sports odds), FRED (St. Louis Fed; vintage data for a past cutoff), and BLS (optional; raises the public API's quota).
# @protected
# ODDS_API_KEY=
# FRED_API_KEY=
# BLS_API_KEY=

# An analyst written `marina:<crew>` asks that crew through a Marina server's model API (for example a crew in the verification formation). URL defaults to http://localhost:3300; the key is that server's MODEL_API_KEYS entry. The crew's spend is recorded by that server.
# @protected
# MARINA_FORECAST_MARINA_URL=http://localhost:3300
# MARINA_FORECAST_MARINA_KEY=

# ── Social Simulation Arena ──────────────────────────────────────────────────

# Signed participation in the MIT Social Simulation Arena (docs/guides/arena.md). Off unless an entrant id is set. The key file holds the Ed25519 private key (mode 0600, `bun run arena keygen <path>`).
# @restart
# MARINA_ARENA_ENTRANT=<your-entrant-id>
# MARINA_ARENA_KEY_FILE=/srv/marina/arena-key.pem
# MARINA_ARENA_KEY_ID=k1

# File each round automatically during its last MARINA_ARENA_WINDOW_HOURS hours (default 24, max 168; an invalid value falls back to 24).
# MARINA_ARENA_AUTOPILOT=off
# MARINA_ARENA_WINDOW_HOURS=24

# What answers (default nowcast — no model calls; the baseline for non-Civiqs rounds): nowcast (freshest Civiqs reading), baseline, discovered (best promoted signal, else nowcast), tabh2o[:forecast][@nowcast] (experimental; TabH2O on the lock's own history, needs TABH2O_API_KEY), model:<provider/model>, crew:<m>[,<m>,<m>] (statistician, analyst, skeptic) or research:<m>[,<m>,<m>]. A model's answer is shrunk toward the baseline by MARINA_ARENA_MODEL_WEIGHT. Measure with `bun run arena evaluate` before switching.
# MARINA_ARENA_FORECASTER=nowcast

# Per-family routing for MARINA_ARENA_FORECASTER=routed (or a literal route:… spec): one forecaster per tracker family, `skip` to leave a family unanswered (the board averages only answered rounds), `*` for the rest. Unset uses the measured default: civiqs=nowcast; aaii and umich_sentiment on multi-model formations; economist_yougov, umich_party and morning_consult skipped; *=nowcast.
# MARINA_ARENA_ROUTES=civiqs=nowcast;economist_yougov=skip;*=nowcast
# MARINA_ARENA_MODEL_WEIGHT=0.5

# `off` stops the nowcast reading the live Civiqs dashboard for open rounds (rounds past their lock never do).
# MARINA_ARENA_CIVIQS_LIVE=on

# `on` counts a Google Trends basket's partial current week as its latest reading.
# MARINA_ARENA_TRENDS_PARTIAL=off

# Horizon-aware Civiqs nowcast (experimental, off until a backtest earns it): `drift` adds a damped local trend to the release day where the series' own history says trends persist, `sd` widens the spread to the h-day-ahead error plus revision noise, `both` does both. Applies wherever the nowcast is the start forecast (nowcast, formations, research). DAMPING is φ in (0, 1]. Measure with `bun run arena evaluate` or the `nowcast-drift:<φ>` / `horizon` signals before switching.
# MARINA_ARENA_NOWCAST_HORIZON=off
# MARINA_ARENA_NOWCAST_DAMPING=0.8

# Research forecaster: retriever, judge (jev, decisions or none; default jev, or none without OPENROUTER_API_KEY) and the trust given to verified research lines. Retrievers: openrouter-web:<model> (any model with OpenRouter's web search) or sonar:<Perplexity model> (sonar, sonar-pro, sonar-pro-search, sonar-reasoning-pro, sonar-deep-research); tavily:basic or tavily:advanced calls Tavily's search API directly (needs TAVILY_API_KEY; its page text is used for citation checks); asof[:<providers>] uses keyless date-strict engines (gdelt, wikipedia, hn, arxiv, wayback) bounded to the brief's cutoff; list several, comma-separated, to merge their reports.
# MARINA_ARENA_RESEARCH_RETRIEVER=openrouter-web:openai/gpt-6-luna
# MARINA_ARENA_RESEARCH_JUDGE=jev
# MARINA_ARENA_RESEARCH_TRUST=0.5

# Record a candidate forecaster hourly in shadow, never filed (`bun run arena shadow score`).
# MARINA_ARENA_SHADOW=

# Model that proposes signals for `arena discover`.
# MARINA_ARENA_PROPOSER=openrouter/anthropic/claude-opus-5.5

# Rehearsal overrides for the arena endpoint, audience and data repository. Production is the default.
# MARINA_ARENA_URL=https://social-simulation-arena.com
# MARINA_ARENA_AUDIENCE=ssa-production-v1
# MARINA_ARENA_DATA_URL=https://raw.githubusercontent.com/Social-Atoms/social-sim-arena/main

# ── TabH2O ───────────────────────────────────────────────────────────────────

# H2O.ai's hosted tabular foundation model, used by `market forecast`. Without a key the connector is seeded but inactive. The endpoint override is for self-hosted deployments.
# TABH2O_API_KEY=
# TABH2O_ENDPOINT=https://tabh2o.h2oai.com/api/v1/predict

# ── Prediction markets ───────────────────────────────────────────────────────

# `true` allows live order placement (Kalshi only). `position` is paper trading by default.
# @protected
# MARINA_TRADING_ENABLED=false

# Kalshi credentials for live trading (the key is a UUID; the secret is a base64-encoded RSA private key in PEM form) and an API base override.
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

# Polymarket market-data base overrides (gamma for markets, CLOB for price history). Market data works; live Polymarket orders are not implemented.
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# Reserved Polymarket credentials. Live Polymarket orders are NOT supported (no CLOB order signing): with MARINA_TRADING_ENABLED=true and all four set, orders fail closed with an error and nothing is sent; otherwise orders are paper.
# @internal
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=

# ── Memory ───────────────────────────────────────────────────────────────────

# Per-owner admission budgets for durable memory (world and standalone service), aggregated across spaces: logical bytes, sources, revisions and spaces. Unlimited under the local profile unless set; the values shown are the shared/public defaults. Existing data is never evicted, and reads and forgetting keep working at the limit.
# MARINA_MEMORY_MAX_BYTES=1073741824
# MARINA_MEMORY_MAX_SOURCES=100000
# MARINA_MEMORY_MAX_REVISIONS=100000
# MARINA_MEMORY_MAX_SPACES=256

# Operator-owned JSON file of explicit memory federation mounts. Each entry binds a local principal to a peer URL and space, and names the environment variable holding the peer credential (see docs/guides/memory-service.md).
# @restart
# MARINA_MEMORY_FEDERATION_CONFIG=

# Optional model-directed memory plans. URL and model must both be set; unset gives deterministic, model-free plans.
# @restart
# MARINA_MEMORY_PLANNER_URL=http://127.0.0.1:3300/v1
# MARINA_MEMORY_PLANNER_MODEL=marina
# MARINA_MEMORY_PLANNER_TOKEN=

# Memory embeddings: none (lexical only), local (pinned MiniLM through the optional extensions/local-embeddings) or ollama (an operator-run /api/embed with a model and an immutable revision). Evidence-gated: run `bun run qualify:paraphrase` first.
# @restart
# MARINA_MEMORY_EMBEDDINGS=none
# MARINA_MEMORY_EMBEDDING_CACHE=data/memory-models
# MARINA_MEMORY_EMBEDDING_LOCAL_ONLY=false
# MARINA_MEMORY_EMBEDDING_URL=http://127.0.0.1:11434
# MARINA_MEMORY_EMBEDDING_MODEL=
# MARINA_MEMORY_EMBEDDING_REVISION=

# ── Passthru and prompt caching ──────────────────────────────────────────────

# Comma-separated pool names shared with passthru (external OpenAI-SDK) callers. Empty shares none.
# MARINA_PASSTHRU_SHARED_POOLS=

# Bytes of memory context injected into a proxied request for an identified passthru caller (clamped 256–65536). The entity property passthruInjectBytes overrides it per key.
# MARINA_PASSTHRU_INJECT_BYTES=2048

# Exact-match response cache for identified passthru callers. `on` applies only under the local profile; elsewhere a caller opts in with the entity property passthruResponseCache. Streaming, tool-call and non-2xx responses are never cached.
# MARINA_PASSTHRU_RESPONSE_CACHE=off
# MARINA_PASSTHRU_RESPONSE_CACHE_TTL_MS=3600000

# Add an ephemeral cache marker to the last system block of Anthropic passthru requests that carry none. Default true under the local profile, false otherwise.
# MARINA_ANTHROPIC_AUTO_CACHE=false

# `marina/verify:<proposer>[+<checker>]` model ids: the checker used when the id names none. Default: the proposer reviews its own draft.
# MARINA_VERIFY_CHECKER_MODEL=openrouter/openai/gpt-6.1-sol

# `marina/verify:` revision rounds after a flagged draft (0 = review only and return the draft; max 3). Default 1.
# MARINA_VERIFY_ROUNDS=1

# Comma-separated drop-in compatibility profiles whose model-id aliases appear in /v1/models (`openai` exposes `assistant`). Default all; `none` disables.
# MARINA_COMPAT=openai

# ── HTTP hardening ───────────────────────────────────────────────────────────

# Request body ceiling for JSON routes (enforced per route; pre-auth and key-management routes use a 64 KiB cap), and the separate cap on one asset upload (uploads are MIME-allowlisted and magic-byte checked).
# @restart
# MARINA_MAX_REQUEST_BODY_BYTES=8388608
# MARINA_MAX_UPLOAD_BYTES=52428800

# Deadline in milliseconds for one proxied upstream model call (response headers for a stream, the whole reply otherwise). A non-streaming call is also aborted when its client disconnects.
# MARINA_UPSTREAM_TIMEOUT_MS=300000

# MCP session creations and login/auth tool calls per client IP per minute. 0 disables.
# MARINA_MCP_SESSIONS_PER_MIN=10

# Extra Host header values /mcp accepts (DNS-rebinding protection; validation is never off). Unset on a non-loopback bind: only loopback names, a specific bind address, the machine hostname and the BETTER_AUTH_URL / ALLOWED_ORIGINS hosts. List LAN IPs or other names clients use here.
# @protected
# MARINA_MCP_ALLOWED_HOSTS=mcp.example.com

# `true` lets outbound fetches proceed when DNS resolution fails, instead of refusing them (fail open). Only for restricted-DNS environments.
# @protected
# MARINA_URL_GUARD_DNS_FAIL_OPEN=false

# ── Retention ────────────────────────────────────────────────────────────────

# Override row-retention windows: comma-separated table=<duration|rows|0>, durations in s/m/h/d/w, a bare integer is a row count, 0 never prunes. Per-class defaults and the table list live in src/engine/retention.ts (Admin → Ops shows them); append-only tables can never be pruned.
# MARINA_RETENTION_OVERRIDES=primitive_usage=30d,feed_events=0

# Durable event_log rows kept (pruned hourly; clamped 10000–10000000).
# MARINA_EVENT_RETENTION=100000

# Structured application log rows kept in SQLite (maximum 1000000).
# @restart
# MARINA_LOG_RETENTION=10000

# ── Logging and OpenTelemetry ────────────────────────────────────────────────

# Log format (text or json) and minimum level (debug, info, warn, error; case-insensitive — an invalid level warns once and uses info).
# @restart
# LOG_FORMAT=text
# LOG_LEVEL=info

# `true` pushes completed structural spans to an OTLP/HTTP JSON collector. Prompts, outputs, tool arguments and credentials are excluded; a collector outage never blocks agents.
# @restart
# MARINA_OTLP_ENABLED=false

# `true` pushes logs over OTLP/HTTP JSON, independently of traces.
# @restart
# MARINA_OTLP_LOGS_ENABLED=false

# Shared OTLP base endpoint (Marina appends /v1/traces or /v1/logs), headers (comma-separated, percent-encoded key=value, never displayed), timeout (default 10s, clamped 100ms–60s) and protocol (only http/json is supported). Each has a per-signal OTEL_EXPORTER_OTLP_TRACES_* or OTEL_EXPORTER_OTLP_LOGS_* variant that wins; per-signal endpoints are used exactly as written.
# @restart
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TIMEOUT=10s
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=

# Resource identity attached to exported spans and logs.
# @restart
# OTEL_SERVICE_NAME=marina
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.namespace=my-team

# `true` allows a plaintext (http) collector on a non-loopback host.
# @protected
# @restart
# MARINA_OTLP_ALLOW_INSECURE=false

# Export batching: trace batch delay, log batch delay and log queue size.
# @restart
# MARINA_OTLP_BATCH_DELAY_MS=2000
# MARINA_OTLP_LOGS_BATCH_DELAY_MS=2000
# MARINA_OTLP_LOGS_MAX_QUEUE=2000

# ── Extensions ───────────────────────────────────────────────────────────────

# Comma-separated directories of trusted host extensions, each containing a marina-plugin.json (docs/guides/extending.md). Nothing is downloaded; empty loads none.
# @protected
# @restart
# MARINA_PLUGINS=./plugins/hello

# ── World Collective ─────────────────────────────────────────────────────────

# How long a child world may take to come up, in milliseconds (minimum 1000; the first boot applies every migration).
# MARINA_COLLECTIVE_START_TIMEOUT_MS=30000

# ── Command-line clients ─────────────────────────────────────────────────────

# Server URL for `marina connect`, `marina status`, the ACP bridge (scripts/acp.ts) and the routing CLIs. Read by those clients, not the server.
# @internal
# MARINA_URL=ws://localhost:3300

# Bearer token `marina status` and the routing CLIs send. Unset reuses the newest cached `marina connect` session for MARINA_URL.
# @internal
# MARINA_TOKEN=

# Folder launcher (`marina [dir]`, `bun run code`): `1` uses a throwaway database deleted on exit (same as --fresh) instead of ~/.marina/projects/<slug>/marina.db, and the one-shot `marina -p` timeout in milliseconds (on timeout it sends `code stop` and exits 2).
# @internal
# MARINA_CODE_FRESH=
# MARINA_CODE_TASK_TIMEOUT_MS=600000

# ── Set by Marina (do not set) ───────────────────────────────────────────────

# The local profile's generated model-API key, loaded from <DB_PATH>.local-api-key at boot; ignored and dropped under shared/public. It also opens /mem with an X-Agent-Name header. Do not set it yourself.
# @internal
# @protected
# MARINA_LOCAL_API_KEY=

# Marks a World Collective child world, which lets `evolve trial` run there. Set by the collective manager; setting it on a parent world bypasses the trial fence.
# @internal
# @protected
# MARINA_COLLECTIVE_CHILD=
