# ═══════════════════════════════════════════════════════════════════════════
# Marina environment reference
#
# Every environment variable the Marina server and its world definitions read.
# This file is the catalog: the dashboard settings editor (Admin → Settings),
# the generated page docs/reference/environment.md and the documentation tests
# all parse it. It is not loaded at runtime. For a short starter, copy
# .env.example to .env instead.
#
# Everything is optional. With no configuration a loopback `bun run start`
# runs the ungated `local` trust profile.
#
# Format: a comment block describes the `# KEY=value` lines directly below it.
# A blank line or a bare `#` ends the block. Values shown are defaults or safe
# examples. Optional tag lines inside a block apply to every key in it:
#   @protected  the dashboard never writes it (edit .env or the process env)
#   @internal   hidden from the dashboard editor; Marina sets it, or only a
#               command-line client reads it
#   @restart    read once at startup; a change needs a restart
# Script, test, CI and SDK-example knobs are documented elsewhere:
# docs/guides/testing.md, docs/guides/release-qualification.md,
# src/sdk/examples/.env.example and examples/memory-service/.env.example.
# ═══════════════════════════════════════════════════════════════════════════

# ── Network and ports ────────────────────────────────────────────────────────

# WebSocket, web chat, dashboard and HTTP API port (the OpenAI- and Ollama-compatible /v1 and /api routes are served here too). 0 picks a free port for the listener, but internal agents and benchmark runs still dial 3300, so use a real port when agents run.
# @restart
# WS_PORT=3300

# Bind address for the WebSocket/HTTP and MCP listeners; the default is loopback only. Unless MARINA_ALLOW_INSECURE_PUBLIC=true, a non-loopback bind is fatal at startup when login is passwordless (MARINA_AUTH off, which also covers MARINA_AUTONOMY=open), when MARINA_OPEN_API=true, under MARINA_PROFILE=local, or under MARINA_AUTONOMY=sovereign.
# @protected
# @restart
# WS_HOST=127.0.0.1

# Deprecated alias of WS_HOST (WS_HOST wins when both are set).
# @protected
# @restart
# MARINA_HOST=127.0.0.1

# true binds 0.0.0.0 without naming an interface. An explicit WS_HOST wins.
# @protected
# @restart
# MARINA_PUBLIC=false

# Acknowledge an unauthenticated non-loopback bind (see WS_HOST). Only for a network you control; prefer MARINA_AUTH=better-auth.
# @protected
# @restart
# MARINA_ALLOW_INSECURE_PUBLIC=false

# Telnet port. 0 (the default) is off. Telnet is plaintext and unauthenticated, and telnet sessions can never run host commands.
# @restart
# TELNET_PORT=0

# MCP (Model Context Protocol) port. Default: the bound WebSocket port + 1 (also with WS_PORT=0). 0 disables.
# @restart
# MCP_PORT=3301

# Real-time log viewer port. Default: the bound WebSocket port + 2 (also with WS_PORT=0). 0 disables.
# @restart
# LOG_PORT=3302

# One listener for everything: `/mcp` is served on the WebSocket/HTTP port instead of MCP_PORT, and the log viewer stays off unless LOG_PORT is set explicitly. For embedders that need exactly one port per instance. MCP_PORT=0 still disables MCP.
# @restart
# MARINA_SINGLE_PORT=false

# Shut down gracefully after this long with no external use, no open agent turn and no pending background work (`15m`, `900s`, `1h`; 0 or unset = never). External use is an HTTP or MCP request (in flight until a streamed response — SSE or NDJSON, an MCP client's event stream included — ends), an open WebSocket (dashboard, chat, SDK) or telnet connection, or a frame on one; the clock starts when the last of them ends. An idle MCP session with no open stream does not count. Health probes and Marina's own agents calling its /v1 are not activity, autonomous agent turns never reset the clock, and an open turn stops postponing the exit when its agent stops or after 30 minutes. For on-demand instances that a host starts when needed (see endpoint.json under MARINA_DATA_DIR).
# @restart
# MARINA_IDLE_SHUTDOWN=0

# Exit gracefully when this process id no longer exists — for a Marina owned by a host process that may die without stopping it.
# @restart
# MARINA_PARENT_PID=

# Maximum concurrent WebSocket connections per client IP.
# @restart
# WS_MAX_CONNECTIONS_PER_IP=100

# Trust X-Forwarded-For when resolving the client IP for every per-IP rate limiter. Enable only behind a trusted reverse proxy.
# @protected
# MARINA_TRUST_PROXY=false

# When NODE_ENV=production and neither HTTPS_PROXY nor REVERSE_PROXY is set, Marina logs a hint that no TLS proxy was detected. Only presence matters. Bun's fetch also honours HTTPS_PROXY, HTTP_PROXY and NO_PROXY for outbound requests.
# @restart
# NODE_ENV=production
# REVERSE_PROXY=1
# HTTPS_PROXY=

# Human-readable instance name. Shown in the dashboard and stamped as the origin on federation and provenance records. Defaults to the world name.
# @restart
# MARINA_NAME=Marina

# ── API authentication and access ────────────────────────────────────────────

# Comma-separated bearer tokens accepted on /v1, the Ollama-compatible /api routes and MCP. Under the local profile Marina also generates a key into <DB_PATH>.local-api-key (mode 600) and prints it at boot, so local clients need nothing here.
# MODEL_API_KEYS=sk-marina-change-me

# Comma-separated secret:agent pairs for the /mem REST API and /api/probe. Unset keeps /mem closed, except with MARINA_OPEN_API=true or, under the local profile, the local model-API key plus an X-Agent-Name header.
# MEM_API_KEYS=sk-agent-1:scout

# Encrypts provider keys stored through Admin → Keys (AES-256-GCM, 16+ characters; generate with `openssl rand -base64 32`). Unset: Marina generates one in <DB_PATH>.key-secret (0600) and encrypts keys saved from then on; existing plaintext rows keep working, and an explicit value also migrates them. Back the secret (or that file) up with the database: changing or losing it orphans stored keys, which must then be re-entered. Environment provider keys are never stored.
# @protected
# @restart
# MARINA_KEY_SECRET=

# Development only: accept unauthenticated requests on the model, memory and dashboard read APIs. It does not grant operator actions: key and settings management, spawning and deletion still need an operator, and writes are refused outside the local profile. Fatal with a non-loopback bind unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# @protected
# MARINA_OPEN_API=false

# Comma-separated origins allowed for CORS. Unset sends no Access-Control-Allow-Origin header (same-origin only).
# ALLOWED_ORIGINS=http://localhost:5173

# Content-Security-Policy for the dashboard HTML. Unset uses the built-in policy; `off` drops the header; any other value replaces the policy verbatim.
# @protected
# MARINA_DASHBOARD_CSP=

# ── Sign-in (better-auth) ────────────────────────────────────────────────────

# `better-auth` requires human sign-in on the web chat and dashboard (email/password plus any configured OAuth providers) and rejects passwordless name login. A signed-in identity is bridged to a named Marina entity. Agents keep authenticating with session tokens. Off by default.
# @protected
# @restart
# MARINA_AUTH=better-auth

# Required with MARINA_AUTH=better-auth: 32+ characters (generate with `openssl rand -base64 32`; `bun run init --preset shared-team` writes one).
# @protected
# @restart
# BETTER_AUTH_SECRET=

# Public base URL of this instance, used in auth callbacks. Default http://localhost:<WS_PORT>.
# @restart
# BETTER_AUTH_URL=https://marina.example.com

# SQLite file for the auth tables, kept separate from the world database.
# @restart
# BETTER_AUTH_DB_PATH=marina-auth.db

# Comma-separated verified email addresses promoted to admin when sign-in is on. Replaces MARINA_ADMINS under MARINA_AUTH.
# @protected
# MARINA_AUTH_ADMIN_EMAILS=you@example.com

# OAuth sign-in providers. Set both the id and the secret to enable each one.
# @restart
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── Trust profile, autonomy and admins ───────────────────────────────────────

# Who this Marina is for. Derived when unset: `local` when every listener binds loopback and MARINA_AUTH is off, `shared` when MARINA_AUTH=better-auth, `public` for any non-loopback bind. `local` is ungated: all safety gates pass, loopback logins are sovereign, rate limits, login caps and memory admission budgets are off, and database durability defaults to `normal`; audit (exec decisions, cognitive ledger, memory receipts, trust labels) stays on. `shared` enforces gates, ranks and limits with sign-in identifying people; `public` enforces everything. `local` with a non-loopback bind is fatal unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# @protected
# @restart
# MARINA_PROFILE=local

# Autonomy posture, env-only by design. `guarded`: a supervised gate attempt is held until a person approves it; approvals from outside the requester's lineage make the gate its own. `earned`: agents whose standing clears a gate's floor run supervised operations at once, and an operator attests the runs afterwards. `open`: every gate passes except the destructive core (key.manage, admin.destructive, shell.exec, code.exec.unrestricted, world.code); `open` does pass code.exec. `sovereign`: the all-gates-off switch for a sovereign, self-hosted Marina with no guests: every gate (core included), rank floor and hold is off for every principal in every profile; audit stays on and the profile still sets the performance defaults. Unset means `guarded`, except under the local profile, where unset is ungated and only an explicit `guarded` brings the gates back. `open` with a non-loopback bind and passwordless login is fatal; `sovereign` with a non-loopback bind is fatal, signed in or not, unless MARINA_ALLOW_INSECURE_PUBLIC=true.
# @protected
# @restart
# MARINA_AUTONOMY=guarded

# Comma-separated entity names promoted to sovereign on login, honoured only for loopback or in-process connections and ignored under MARINA_AUTH. Redundant under the local profile, where loopback logins are already sovereign.
# @protected
# MARINA_ADMINS=YourName

# Instance-wide cap on concurrent entity logins. 0 is unlimited. Internal room and crew agents are exempt (MAX_AGENTS caps them). Not enforced under the local profile.
# MARINA_MAX_LOGINS=0

# Login and reconnect attempts per minute per client IP (MCP sessions share their peer's bucket). 0 disables.
# @restart
# MARINA_LOGIN_ATTEMPTS_PER_MIN=10

# Absolute lifetime of a session token in milliseconds (default 7 days). Activity refreshes the 24-hour idle window only up to this cap; a reconnect mints a new session.
# MARINA_SESSION_MAX_AGE_MS=604800000

# ── Challenges and agent lineage ─────────────────────────────────────────────

# When a caller is refused by a rank floor or safety gate, Marina asks its creator and the admins with a token instead of only refusing; `challenge approve <token> [once|always]` re-runs the held command. `off` restores plain refusals.
# MARINA_CHALLENGES=on

# How long an unanswered challenge stays open, in milliseconds.
# MARINA_CHALLENGE_TTL_MS=3600000

# Challenge judge (needs a decision backend; nothing is scored without one). `observe` (default) scores held commands in shadow so its agreement with people is measured. `on` also auto-approves `once` for a gate only after it earned that gate (25+ approved calls at 85% or better, 95% lower bound), never for the core gates, never `always`, never a deny. `off` never scores. `challenge stats` shows the record.
# @protected
# MARINA_CHALLENGE_JUDGE=observe

# Deepest spawn lineage an agent may extend (lead → sub-lead → specialist).
# MARINA_MAX_SPAWN_DEPTH=3

# Standing per concurrent child an earned spawner may keep alive (budget = floor(standing / this), capped by MAX_AGENTS).
# MARINA_STANDING_PER_SPAWNED_CHILD=25

# Total copies `evolve replicate` may seed from one accepted run.
# MARINA_MAX_REPLICAS_PER_RUN=5

# `here` lets a dedicated parallel world run `evolve trial` itself. Trials otherwise run only in a World Collective child. Never set it on a world you care about.
# @protected
# MARINA_EVOLVE_TRIALS=

# Standing decay half-life in days (minimum 1; a non-numeric value falls back to 60). Shorter means rank derived from standing demotes faster.
# @restart
# STANDING_HALF_LIFE_DAYS=60

# ── World ────────────────────────────────────────────────────────────────────

# World definition to load: the file name of any module in worlds/ (default, showcase, commons, research, evolve, empty, …).
# @restart
# MARINA_WORLD=default

# Room where new players spawn. Defaults to the world's start room.
# @restart
# START_ROOM=

# Engine tick interval in milliseconds.
# @restart
# TICK_MS=1000

# Wall-clock budget for the per-tick command phase, in milliseconds.
# @restart
# MARINA_COMMAND_PHASE_BUDGET_MS=150

# Macro expansion limits: nesting depth (a macro that runs a macro …) and commands one top-level macro invocation may expand to. 0 is unlimited. Unset, the shared/public defaults are 8 and 100, and the local-ungated profile or MARINA_AUTONOMY=open is unlimited. A macro cycle is always refused, and every expanded command still costs one rate-limit token.
# MARINA_MACRO_MAX_DEPTH=8
# MARINA_MACRO_MAX_EXPANSIONS=100

# `false` suppresses every room-agent auto-spawn (the LLM agents rooms start on first entry). Any other value leaves it on. Room agents need a provider key.
# MARINA_ROOM_AGENTS=true

# Model for the default Workbench's Host, Builder, Critic and Chronicler. Unset tries MARINA_CREW_MODEL, then openai/gpt-6.1-sol (OPENAI_API_KEY), anthropic/claude-opus-5-5 (ANTHROPIC_API_KEY), openrouter/google/gemini-3.1-pro-preview (OPENROUTER_API_KEY), huggingface/zai-org/GLM-5.3-Flash (HUGGINGFACE_API_KEY or HF_TOKEN), then marina/default.
# @restart
# MARINA_WORKBENCH_MODEL=openai/gpt-6.1-sol

# Shared crew-model override for the Workbench, Showcase and focused single-outcome worlds.
# @restart
# MARINA_CREW_MODEL=marina/default

# Showcase world only: size of the answerer crew and per-crew model overrides (each falls back to MARINA_CREW_MODEL).
# @restart
# MARINA_ANSWERER_COUNT=4
# MARINA_ANSWERER_MODEL=
# MARINA_MATH_MODEL=
# MARINA_REFLECTOR_MODEL=

# Per-agent model map for boot-seeded agents, any world: comma list of Name=model (names case-insensitive; the model string passes through as-is). Wins over the per-role variables above and MARINA_CREW_MODEL. Applied on every boot to agents the seed still owns — a user-customized or retired agent is never touched — exactly like the per-role variables. A name matching no seeded agent, or a malformed entry, is logged as a warning at boot.
# @restart
# MARINA_AGENT_MODELS=Answerer=anthropic/claude-opus-5-5,Translator=openrouter/deepseek/deepseek-v4-pro-0813

# Showcase world only: which autonomous coordinators to seed beyond marina:answerer (comma list of council, debate, decompose; empty or `none` seeds none). Unset seeds all three. Each is a loop that spends tokens even when its endpoint is never called.
# @restart
# MARINA_ENDPOINTS=council,debate,decompose

# Showcase world only: `true` seeds the universal skill packages.
# @restart
# MARINA_SEED_SKILLS=false

# `false` disables the verified-arithmetic fast path on marina:answerer (simple arithmetic otherwise returns without a crew round).
# MARINA_MODEL_FAST_PATH=true

# `false` turns off model synthesis in `ask` and `dig` (retrieval only) and the model interpretation pass in `desire`. Any other value keeps them on.
# MARINA_ASK_MODEL=true

# `true` enables native evolution protocols: passive experiment lineage and evidence analysis over the experiment command. Nothing is auto-run or auto-promoted.
# MARINA_EVOLUTION_PROTOCOLS=false

# `true` makes the retired Unified Canvas (ReactFlow world graph) reachable at /?unified.
# MARINA_UNIFIED_CANVAS=false

# ── Storage ──────────────────────────────────────────────────────────────────

# One directory for everything this instance writes. When set, every path setting below that is unset moves under it (DB_PATH → <dir>/marina.db, ASSETS_DIR → <dir>/assets, MARINA_SCRATCH_DIR → <dir>/scratch, BETTER_AUTH_DB_PATH, the embedding model caches), the dashboard settings editor reads and writes <dir>/.env, a running instance publishes <dir>/endpoint.json (url, MCP url, pid, local key; mode 600; removed on clean exit — written only with this setting), and keys from that file fill only variables the process environment leaves unset. Nothing is written to the working directory. An explicit path setting still wins. Created (mode 700) when missing.
# @restart
# MARINA_DATA_DIR=

# SQLite world database path.
# @restart
# DB_PATH=marina.db

# World database durability: `full` (fsync per commit) or `normal` (WAL, crash-safe, small power-loss window). Default `normal` under the local profile, `full` otherwise.
# @restart
# MARINA_DB_DURABILITY=full

# Directory for uploaded assets.
# @restart
# ASSETS_DIR=data/assets

# Per-entity scratch directory (`run` output, canvas `file:` uploads).
# @restart
# MARINA_SCRATCH_DIR=data/scratch

# ── Model provider keys ──────────────────────────────────────────────────────

# Anthropic API key. Set one provider key for agents that think; OPENROUTER_API_KEY is the most versatile because `forecast` and the arena research path also need it. Environment keys and keys added in Admin → Keys both work on every path; the environment wins and survives database resets.
# ANTHROPIC_API_KEY=

# OpenAI API key.
# OPENAI_API_KEY=

# Google Gemini API key (GOOGLE_API_KEY is accepted as an alias).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Groq API key.
# GROQ_API_KEY=

# OpenRouter API key. Enables its models and web retrievers; forecasts can also use other configured providers.
# OPENROUTER_API_KEY=

# Together AI API key. Use together/<provider-model-id>; model discovery supplies live token prices.
# TOGETHER_API_KEY=
# Nebius Token Factory API key. Use nebius/<provider-model-id>; verbose model discovery supplies live token prices.
# NEBIUS_API_KEY=
# Optional OpenAI-compatible API roots for dedicated endpoints. Include /v1; never put credentials in URLs. The same root serves discovery and inference.
# @restart
# TOGETHER_BASE_URL=https://api.together.ai/v1
# Optional Nebius API root for a dedicated endpoint. Include /v1; applies to discovery and inference.
# @restart
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Hugging Face Inference Providers key (router.huggingface.co). Address models as `huggingface/<org>/<model>`, optionally suffixed `:fastest`, `:cheapest` or `:<provider>`. HF_TOKEN is accepted as well.
# HUGGINGFACE_API_KEY=
# HF_TOKEN=

# More OpenAI-compatible providers. Each is also an upstream for marina/default (defaults: gpt-oss-120b, deepseek-flash, mistral-small-latest, grok-4.7; override with MARINA_DEFAULT_<PROVIDER>_MODEL).
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# ── Local model runtimes ─────────────────────────────────────────────────────

# llama.cpp server (OpenAI-compatible). Setting the base URL or the key opts in; llama is then the first marina/default fallback. Address models as `llama/<id>`. The key is only needed when the server runs with --api-key.
# @restart
# LLAMA_BASE_URL=http://localhost:8080/v1
# LLAMA_API_KEY=

# Ollama (OpenAI-compatible, usually keyless). Setting the base URL or the key opts in as a marina/default fallback after llama. Address models as `ollama/<id>`.
# @restart
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# VibeThinker served by vLLM or SGLang. Usable only as an explicit `vibethinker/<id>` model, never as a marina/default fallback. In Docker it is the optional `vibethinker` compose profile, whose own VIBETHINKER_MODEL, VIBETHINKER_CTX and VIBETHINKER_MODELS_DIR are read by docker-compose.yml, not by Marina.
# @restart
# VIBETHINKER_BASE_URL=http://localhost:8000/v1
# VIBETHINKER_API_KEY=

# Pin the context window (tokens) the agent compactor budgets against. Normally autodetected at launch (llama.cpp /props, Ollama /api/show); these win over the probe. Without either, llama uses 16384, Ollama 8192 and VibeThinker 40960.
# @restart
# LLAMA_CONTEXT_WINDOW=16384
# OLLAMA_CONTEXT_WINDOW=8192
# VIBETHINKER_CONTEXT_WINDOW=

# Context window assumed for marina/default. Set it when marina/default proxies to a small local model, or requests overflow it.
# MARINA_DEFAULT_CONTEXT_WINDOW=128000

# Share of a local model's context window reserved for output (0 < f ≤ 0.5; higher values are clamped). It scales with the configured window, so pin a real window above for large local servers.
# MARINA_LOCAL_OUTPUT_FRACTION=0.25

# Optional hard cap in tokens on local-model output. Unset applies the fraction alone.
# MARINA_LOCAL_MAX_OUTPUT_TOKENS=32768

# Characters per token in the compactor's prompt-size estimate. Lower compacts earlier; raising it risks oversized prompts the upstream rejects.
# MARINA_TOKEN_CHARS_PER_TOKEN=3

# Tool-result text block cap. Unset: max(2000, 15% of the effective prompt window), recalculated after model changes and overflow recovery. A positive integer sets a fixed cap. Truncation is labeled; originals are archived before compaction. Prefer narrower retrievals when a result exceeds the cap.
# MARINA_MAX_TOOL_RESULT_TOKENS=2000

# ── Default and fallback models ──────────────────────────────────────────────

# Model for agents spawned without one, and the fallback for unrecognized models. marina/default calls this instance's own /v1, which routes to whichever provider has a key. A default model set at runtime (dashboard or `admin`) wins.
# MARINA_DEFAULT_MODEL=marina/default

# Model /v1 uses on each provider when it proxies directly upstream (no model agent is online for the requested channel). The variable name is MARINA_DEFAULT_<PROVIDER>_MODEL.
# MARINA_DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
# MARINA_DEFAULT_OPENAI_MODEL=gpt-6.1-sol
# MARINA_DEFAULT_GEMINI_MODEL=gemini-3.1-pro-preview
# MARINA_DEFAULT_OPENROUTER_MODEL=google/gemini-3.1-pro-preview
# MARINA_DEFAULT_TOGETHER_MODEL=MiniMaxAI/MiniMax-M3
# MARINA_DEFAULT_NEBIUS_MODEL=MiniMaxAI/MiniMax-M3
# MARINA_DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
# MARINA_DEFAULT_HUGGINGFACE_MODEL=zai-org/GLM-5.3-Flash
# MARINA_DEFAULT_LLAMA_MODEL=local-model
# Ollama default: the first model in Ollama's /api/tags (read at boot), else qwen3:4b.
# MARINA_DEFAULT_OLLAMA_MODEL=qwen3:4b

# Upstream timeout for /v1 requests in milliseconds. Non-streaming client connections also close at Bun's 255-second idle limit.
# MODEL_REQUEST_TIMEOUT_MS=600000

# `0` stops re-posting an unanswered routed model_request as a reminder at 25% and 60% of the timeout.
# MODEL_REQUEST_REMINDERS=1

# Output-token cap marina/default sends upstream per completion (also the compactor's output reservation). Extended thinking on this path is clamped to this value minus 1024. When set explicitly it also caps a full-profile agent on a registry model, which otherwise asks for the model's whole output maximum; an explicit cap never grows.
# MARINA_DEFAULT_MAX_TOKENS=16384

# ── Agent runtime ────────────────────────────────────────────────────────────

# Restart saved agents at boot, including world-seeded ones such as the Workbench population and the Chronicler. Unset: on for a local install (local profile) with a usable provider, off otherwise; `true`/`false` overrides. `readiness` shows what is live.
# @restart
# AGENT_AUTORESPAWN=false

# Maximum concurrently running agents.
# @restart
# MAX_AGENTS=30

# Maximum agent uptime in milliseconds before the runtime stops it (default 24 hours).
# @restart
# MAX_AGENT_UPTIME_MS=86400000

# Comma-separated agent names that seeders, autorespawn and room-agent spawning must not bring back. `agent disable <name>` does the same in-world and persists.
# MARINA_DISABLED_AGENTS=

# Renewable lease on a newly claimed task, in milliseconds. Workers renew with `task heartbeat <id>`; expired ordinary work reopens.
# MARINA_TASK_LEASE_MS=900000

# Output-token cap for request-driven (crew) agents. Unset: 2048 with thinking off; with thinking enabled, pi-ai's thinking budget + 2048 answer/tool tokens, bounded by the provider output limit and half the context window. An explicit insufficient cap is honored with a warning; reasoning depth may be reduced.
# AGENT_CREW_MAX_TOKENS=2048

# Output-token cap for cloud agents using the compact tool profile. Unset: 4096 with thinking off; with thinking enabled, pi-ai's thinking budget + 2048 answer/tool tokens, bounded by the provider output limit and half the context window. An explicit insufficient cap is honored with a warning.
# AGENT_COMPACT_MAX_TOKENS=4096

# Tool calls one agent run may make before it yields. Unset: 8 for crew responders, 16 for autonomous agents. A value applies to both.
# AGENT_MAX_TOOL_CALLS_PER_RUN=16

# Model calls one prompt may take before the loop yields to the next cycle.
# MARINA_MAX_TURNS_PER_PROMPT=24

# Ceiling on public channel sends per agent run. Each agent's own budget defaults to 1 and may be set up to this ceiling with `memory set channel_sends <n>`; 0 disables agent channel sends. Tells are never capped.
# MARINA_CHANNEL_SENDS_PER_RUN=3

# Quiet-cycle and active-cycle intervals for autonomous agents, in milliseconds. Defaults: idle max(60000, 5 × cycle delay); active max(15000, cycle delay).
# AGENT_IDLE_TICK_MS=60000
# AGENT_ACTIVE_TICK_MS=15000

# Long heartbeat for an idle or resting resident, in milliseconds. With no new perception (while resting: no owed reply), no outstanding request, no work in its last run and no consolidation or reflection material, a resident makes no model call until this long after its last prompt. Default 1800000 (30 min); `0`/`off` = only events wake it.
# MARINA_AGENT_HEARTBEAT_MS=1800000

# Minimum gap between an agent's replies on one channel, in milliseconds.
# AGENT_CHANNEL_REPLY_COOLDOWN_MS=30000

# Default extended-thinking level for spawned agents: off, minimal, low, medium, high or xhigh. `agent spawn … thinking:<level>` wins; crew responders stay off unless set explicitly. Unset: off, except Code Mode coders (MARINA_CODE_THINKING).
# MARINA_AGENT_THINKING=off

# Thinking level for Code Mode coders (and `marina -p`; `--thinking <level>` sets it) when neither the agent nor MARINA_AGENT_THINKING sets one. Applied only where the coder's model declares reasoning support, never forced onto a model that may reject reasoning parameters. Default high; `off` disables it.
# MARINA_CODE_THINKING=high

# Multi-tool turn execution. `auto` runs batches containing a world-mutating tool in order and fans read-only batches out; `parallel` and `sequential` apply to every batch.
# MARINA_TOOL_EXECUTION=auto

# `off` keeps every typed tool schema resident in the `full` tool profile. On by default: the core set is resident and other tools load by name through `marina_tool_search`.
# MARINA_DEFERRED_TOOLS=on

# `off` stops agents' marina/* requests carrying prompt-cache markers and a per-agent session id. On by default; Marina's proxy strips the markers for upstreams that reject them.
# MARINA_AGENT_PROMPT_CACHE=on

# `off` sends tools without `strict: true`. On by default for closed, all-required schemas; upstreams that do not implement strict mode ignore it.
# MARINA_STRICT_TOOLS=on

# `off` stops asking OpenRouter for `provider.require_parameters` on agent requests that carry tools. On by default, so a request is never served by a provider that ignores `tools`; dropped per model when no endpoint supports every parameter.
# MARINA_OPENROUTER_REQUIRE_PARAMETERS=on

# `off` never sends `reasoning: {enabled: false}` to OpenRouter. By default an agent with thinking off sends it only for a model whose spawn-time tool probe still made a tool call without reasoning; a model that says reasoning is mandatory stops receiving it.
# MARINA_OPENROUTER_REASONING_OFF=on

# Spawn-time tool-calling probe for an unlisted model id or any OpenRouter model: `warn` reports a model that answered without a tool call (readiness, `agent status`), `refuse` also stops a crew lead on it, `off` skips the probe. Default `warn` (`off` under a test runner).
# MARINA_TOOL_PROBE=warn

# Output repair when a model's output misses its required shape (prose where a reply or tool call was owed, malformed JSON or arguments): `on` = deterministic parse, then one re-encoding shot whose values must appear verbatim in the original; `parse` = deterministic only; `off` = raw output. Repaired deliveries carry `repaired:parse` / `repaired:shot`.
# MARINA_OUTPUT_REPAIR=on

# Model for server-side repair shots (`marina/verify` final output); must be a reachable upstream id. Default: the model whose output is repaired. Agents and forecast runs repair with their own model.
# MARINA_REPAIR_MODEL=openai/gpt-6.1-sol

# `off` omits the tools prose section from the lean agent system prompt.
# MARINA_SYSTEM_TOOLS_PROSE=on

# Byte allowance for per-cycle context. Unset: effective prompt tokens / 8, clamped to 6000–16000 bytes. Automatic memory gets 2048–4096 content bytes. A fixed override has a minimum of 1000; mandatory sections can exceed it. Optional sections are deferred and remain eligible on the next scheduled cycle.
# MARINA_CONTINUATION_BUDGET_BYTES=6000

# Clamp in characters for a model_request perception line (minimum 400). Its content is the caller's question. Other addressed requests and JSON results get 1200 chars; ambient chatter gets 400.
# MARINA_PERCEPTION_MODEL_REQUEST_MAX_CHARS=2000

# What a resident owes a reply to (the reply ledger and the forced-action nudge). `requests` (default): only an event that owes a reply — a request tell, a post addressed to the agent (vocative `Name, …` / `@Name` / `to:Name`) whose body is a request, or a request already in the reply ledger; addressed information still wakes the agent but is not tracked as owed or nudged. `all`: any addressed or high-priority event (the earlier default; two agents naming each other could answer each other indefinitely).
# MARINA_FORCED_ACTION_NUDGE=requests

# Absolute cap on an agent's conversation, in estimated tokens (system prompt and tool schemas excluded). Default 48000; `0`/`off` disables it (compaction then fires only near the model window); explicit values below 8000 are raised to 8000. Once the cap is reached after the agent's first run, the history is compacted to MARINA_AGENT_CONTEXT_TARGET_TOKENS (default a third of the cap) and kept; the originals are archived first. Bound Code Mode coders also apply it after the first assistant turn inside a long task; a fresh request is never compacted before work starts. The same default and explicit values apply to every agent. The near-window trigger still applies when it comes first.
# MARINA_AGENT_CONTEXT_CAP_TOKENS=48000
# MARINA_AGENT_CONTEXT_TARGET_TOKENS=16000

# Removes reasoning blocks (text and provider signature) from assistant messages of earlier runs between prompts; the latest run is untouched, OpenAI Responses-API messages are skipped, and the originals stay in the continuity journal. On by default; `off` keeps every reasoning block.
# MARINA_DROP_OLD_THINKING_SIGNATURES=on

# Provider-level retries inside one request (transient 5xx, short 429) before the loop's own backoff. 0 disables.
# MARINA_PROVIDER_MAX_RETRIES=2

# `on` keeps an agent's own command echoes (memory-service acknowledgements, its `You tell …` receipts) in its world-event buffer. Off by default; messages from others are never filtered.
# MARINA_PERCEIVE_SELF_ECHO=off

# Stop a `reflect`-spawned memory reflector after this many idle milliseconds with no assistance job. 0 disables.
# MARINA_REFLECTOR_IDLE_STOP_MS=600000

# `true` records full, payload-bearing cognitive provenance. Off by default.
# MARINA_COGNITIVE_PROVENANCE=false

# ── Spend limits and failure breaker ─────────────────────────────────────────

# Daily USD cap (UTC day, persisted) on everything this world pays upstream: /v1 passthru, agent turns, decision backends, forecasts and priced media jobs. At the cap /v1 returns 429 spend_cap_reached, decisions, forecasts and priced media jobs are refused and agents pause until 00:00 UTC. Default 50; 0 or off = no cap; an invalid value keeps the default. `readiness` shows today's spend. The total is shared by every process on the same database: command-line runs (`bun run futurex`, `forecast`, `arena`, `metaculus`, `forecastbench`, …) attach the DB_PATH ledger and are checked against the persisted day total, so each run does not get a fresh cap. A command-line run without a database counts per process and warns once.
# @protected
# MARINA_DAILY_SPEND_CAP_USD=50

# Optional budget scope for this process (letters, digits, `.`, `_`, `-`, `:`; at most 64; case-insensitive). Its spend is recorded under the scope as well as in the world total, and the process is refused when EITHER its scope cap OR MARINA_DAILY_SPEND_CAP_USD is reached, so a scope only narrows the budget. Use one scope per job, for example a live watcher and a backtest. An invalid name refuses all spend. `readiness` lists today's scopes.
# @protected
# MARINA_SPEND_SCOPE=futurex-live

# The daily USD cap for MARINA_SPEND_SCOPE (UTC day, persisted). Default 50; 0 or off = no scope cap (the world cap still applies); an invalid value keeps the default.
# @protected
# MARINA_SPEND_SCOPE_CAP_USD=50

# Daily cap a World Collective child world starts with (default 50, never above the parent's cap; 0 or off = the parent's cap).
# @protected
# MARINA_CHILD_DAILY_SPEND_CAP_USD=50

# Shared daily spend ledger: a SQLite file (created with mode 0600, its directory if missing) that several Marina processes record into and check MARINA_DAILY_SPEND_CAP_USD and MARINA_SPEND_SCOPE caps against, so a host running one process per world gets ONE daily total and ONE cap instead of one per world database. Spend is still written to each world database too (per-world history); every cap check and the readiness/Ops readouts use the shared total. Command-line runs that attach a ledger use it as well, even without DB_PATH. An unusable path refuses to start rather than falling back to a per-world cap. With it set, a World Collective child world shares the parent's cap and gets its own budget as scope `child:<name>` capped at MARINA_CHILD_DAILY_SPEND_CAP_USD. Unset = one ledger per world database.
# @protected
# MARINA_SPEND_LEDGER=/var/lib/marina/spend-ledger.db

# Rolling one-hour USD caps on agent model spend, across all agents and per agent. Unset or 0 is unlimited. At a cap the agent pauses, tells its spawner, and resumes once last-hour spend drops. Local models count as $0.
# @protected
# MARINA_MAX_COST_USD_PER_HOUR=5
# MARINA_MAX_AGENT_COST_USD_PER_HOUR=1

# Wall-clock bound on one agent prompt (all its turns), in milliseconds. Unset: it starts by thinking level (off 120000, low 180000, medium 300000, high and above 600000) and an automatic bound doubles after a timeout up to 600000; a set value never grows.
# MARINA_AGENT_PROMPT_TIMEOUT_MS=

# Consecutive upstream or loop errors (429, 5xx, timeouts) before an agent pauses for MARINA_UPSTREAM_ERROR_PAUSE_MS milliseconds and tells its spawner once. A spend refusal (a spend cap, a budget proxy, a provider out of credits) is not retried: the agent pauses for MARINA_UPSTREAM_ERROR_PAUSE_MS at once, and a Code Mode coder ends its task attempt (`code blocked kind:impossible`, labelled BudgetForced) with the work kept in the workspace.
# MARINA_MAX_CONSECUTIVE_UPSTREAM_ERRORS=20
# MARINA_UPSTREAM_ERROR_PAUSE_MS=600000

# ── Code Mode ────────────────────────────────────────────────────────────────

# Comma-separated directories `code` sessions may operate in. With neither this nor MARINA_CODE_DEFAULT_ROOT set, the working directory is a read-only root and host edits and command execution are refused. `marina .` sets this for the folder it opens.
# @restart
# MARINA_CODE_ROOTS=/workspaces/project-a

# Default root for new sessions (must be inside MARINA_CODE_ROOTS). Defaults to the first root; set alone it also enables host execution in that directory.
# @restart
# MARINA_CODE_DEFAULT_ROOT=

# Extra, separate read-only task input roots (comma separated); explicit operator authority for file tools, not additional executable workspace roots. Must exist; may not overlap each other or the primary workspace. Container mount sync maps these read-only to /marina-task/inputs/0, /1, etc.; patch sync refuses extra roots.
# MARINA_CODE_INPUT_ROOTS=

# Extra writable task output roots (comma separated); direct file writes use normal session writer permissions. Container mount sync maps these to /marina-task/outputs/0, /1, etc. These grants do not sandbox host processes; use a container runner for OS-enforced input protection.
# MARINA_CODE_OUTPUT_ROOTS=


# Comma-separated entity ids or names eligible for headless approval of arbitrary (non-allowlisted) host commands. Each also needs the code.exec.unrestricted gate unsupervised and a trusted identity on the acting connection (signed in, or loopback). Interactive approval (`code exec-mode prompt`) does not use this list.
# @protected
# MARINA_CODE_EXEC_UNRESTRICTED=

# Interactive exec-approval prompt timeout in milliseconds.
# MARINA_CODE_EXEC_APPROVAL_TIMEOUT_MS=120000

# Container runtime for container-backed workspaces (`podman` or `docker`). Unset picks podman, then docker. With neither installed, a container runner refuses every command; it never falls back to host execution.
# MARINA_CODE_CONTAINER_RUNTIME=

# Operator container runner for local Code Mode sessions: finite commands (tests, scripts) run inside this image instead of on the host. Same allowlist, approvals and code.exec gate as host runs; no network unless MARINA_CODE_CONTAINER_NETWORK is on; capabilities dropped; CPU/memory/pid limits. While MARINA_CODE_CONTAINER_REQUIRED is in force (the default once IMAGE is set) this is policy: in-world `code workspace runner` cannot return to the host or change the image, runtime, sync, workdir, shell, network or init; sessions tune only cpus/memory/timeout. SYNC=mount (default) binds the worktree at WORKDIR (default /work) on a read-only root, with the repository's .git bound read-only (a root without its own .git is refused); SYNC=patch mounts nothing and applies the pending diff inside a throwaway container whose image already holds the project at WORKDIR. INIT is a one-line environment preamble (e.g. activating a conda env) run by SHELL (sh or bash); it is operator-only and never settable in-world.
# MARINA_CODE_CONTAINER_IMAGE=
# MARINA_CODE_CONTAINER_SYNC=mount
# MARINA_CODE_CONTAINER_WORKDIR=/work
# MARINA_CODE_CONTAINER_INIT=
# MARINA_CODE_CONTAINER_SHELL=sh
# MARINA_CODE_CONTAINER_NETWORK=off

# Whether local Code Mode sessions must run their commands in a container. Unset: required exactly when MARINA_CODE_CONTAINER_IMAGE is set. `true`: required even without an image (sessions then pick one with `code workspace runner container image:<ref>`, which needs the code.exec.unrestricted gate; until then commands fail, never run on the host). `false`: the operator image is only a default and a session may choose `code workspace runner local`. Env-only; nothing in-world changes it.
# MARINA_CODE_CONTAINER_REQUIRED=

# Podman image store (`--root`) and runtime state (`--runroot`) for container workspaces, as absolute paths. Unset uses the operator's own Podman storage, resolved from the server's startup HOME / XDG_* / CONTAINERS_* environment (never the scratch HOME Code Mode gives host commands). Podman only; set Docker's data-root in the daemon. `code doctor` warns when the store is on tmpfs or under /tmp.
# MARINA_CODE_CONTAINER_STORAGE=
# MARINA_CODE_CONTAINER_RUNROOT=

# Defaults for `code verify` (each overridable per call with the modifier of the same name). SCOPE: `auto` runs the tests relevant to the change (touched tests, tests named after touched files, tests that import them) and falls back to the full suite when none are found; `changed` runs only relevant tests (not_run when there are none); `full` runs the whole suite; `changed+full` runs relevant tests, then the full suite within FULL_BUDGET. DEPENDENCIES: `check` probes the environment for the detected project type and reports not_run when it is not ready; `none` skips the probe; `auto` (or the project's own manager) also installs locked dependencies where isolated (a candidate or delivery snapshot with a Bun text lockfile or npm v3 package-lock.json, without scripts, or a container runner with sync mount and network on). A manager for another language is never run. TYPECHECK: `auto` runs the project's configured tsc / mypy / pyright; `off` skips it. Invalid values fall back to the defaults.
# MARINA_CODE_VERIFY_SCOPE=auto
# MARINA_CODE_VERIFY_DEPENDENCIES=check
# MARINA_CODE_VERIFY_TYPECHECK=auto
# MARINA_CODE_VERIFY_FULL_BUDGET=10m

# Delivery capture streams regular files in bounded chunks. These positive byte limits bound
# each file and the complete materialization (defaults 1 GiB and 4 GiB). Raise explicitly for
# larger deliverables; neither setting changes command permissions or the execution runner.
# MARINA_CODE_DELIVERY_MAX_FILE_BYTES=1073741824
# MARINA_CODE_DELIVERY_MAX_TOTAL_BYTES=4294967296

# ── Flywheel sandboxes ───────────────────────────────────────────────────────

# Flywheel isolated execution: the operator token (kept server-side; Marina mints short-lived per-entity capabilities), RPC endpoint and guest image. Unset token disables Flywheel.
# @restart
# FLYWHEEL_TOKEN=
# FLYWHEEL_RPC_URL=http://localhost:8088/rpc
# FLYWHEEL_IMAGE=localhost/h2oai/flywheel-agentd:latest

# Public-service lease in milliseconds (values under 60000 are ignored).
# MARINA_FLYWHEEL_PUBLICATION_TTL_MS=3600000

# Fleet admission and lifecycle limits (counts 1–10000; durations at least 60000 ms). Flywheel sizes CPU, RAM and disk itself.
# MARINA_FLYWHEEL_MAX_SANDBOXES=100
# MARINA_FLYWHEEL_MAX_RUNNING_SANDBOXES=50
# MARINA_FLYWHEEL_IDLE_HIBERNATE_MS=3600000
# MARINA_FLYWHEEL_ABSOLUTE_LIFETIME_MS=86400000
# MARINA_FLYWHEEL_TELEMETRY_RETENTION_MS=604800000

# ── Media generation ─────────────────────────────────────────────────────────

# Image and video provider keys (OpenAI and Google reuse OPENAI_API_KEY and GEMINI_API_KEY). Stability, Black Forest Labs (Flux, with an optional base URL), Runway and Luma. See docs/guides/media.md for model ids.
# STABILITY_API_KEY=
# BFL_API_KEY=
# BFL_BASE_URL=
# RUNWAY_API_KEY=
# LUMA_API_KEY=

# Automatic1111 or SD.Next web UI for `automatic1111/<checkpoint>` images (AUTOMATIC1111_BASE_URL is accepted as an alias). Keyless unless the server requires one.
# A1111_BASE_URL=http://localhost:7860
# A1111_API_KEY=

# Any OpenAI-compatible image server: set <PROVIDER>_IMAGE_BASE_URL and <PROVIDER>_API_KEY, then use `<provider>/<model>`. Together is shown as an example.
# TOGETHER_IMAGE_BASE_URL=https://api.together.ai/v1

# Image and video jobs per entity per rolling 24 h (defaults 50 and 5). 0 is unlimited.
# MAX_IMAGE_JOBS_PER_DAY=50
# MAX_VIDEO_JOBS_PER_DAY=5

# Audio: speech-to-text and text-to-speech (`audio` command, `marina_transcribe` / `marina_speak` tools, POST /v1/audio/transcriptions and /v1/audio/speech). OpenAI uses OPENAI_API_KEY. Any OpenAI-compatible audio server (LocalAI, speaches, Kokoro-FastAPI, whisper.cpp with --inference-path /v1/audio/transcriptions): set <PROVIDER>_AUDIO_BASE_URL (and <PROVIDER>_API_KEY if it needs one), then use `<provider>/<model>`. See docs/guides/media.md → Audio.
# KOKORO_AUDIO_BASE_URL=http://localhost:8880/v1

# Default audio models and voice. Unset: openai/gpt-transcribe and openai/gpt-4o-mini-tts (voice marin) with an OpenAI key; otherwise the first <PROVIDER>_AUDIO_BASE_URL server as <provider>/whisper-1 and <provider>/tts-1.
# MARINA_TRANSCRIBE_MODEL=openai/gpt-transcribe
# MARINA_SPEECH_MODEL=openai/gpt-4o-mini-tts
# MARINA_SPEECH_VOICE=marin

# Audio limits. MAX_BYTES caps one input (default 100 MiB; HTTP uploads are also held to MARINA_MAX_UPLOAD_BYTES), MAX_SECONDS its length (default 3600, needs ffprobe to measure). Audio longer than CHUNK_SECONDS (default 600, minimum 30), larger than the provider's upload limit (OpenAI: 25 MB) or in a format the provider does not take is cut into 16 kHz mono WAV pieces by ffmpeg and the transcripts are joined with their timestamps; video is transcribed from its audio track (needs ffmpeg). SPEECH_MAX_CHARS caps one speech request (default 4096, OpenAI's own limit). Blank or invalid values use the defaults.
# MARINA_AUDIO_MAX_BYTES=104857600
# MARINA_AUDIO_MAX_SECONDS=3600
# MARINA_AUDIO_CHUNK_SECONDS=600
# MARINA_SPEECH_MAX_CHARS=4096

# Transcription and speech jobs per entity per rolling 24 h (defaults 100 each). 0 is unlimited.
# MAX_TRANSCRIPTION_JOBS_PER_DAY=100
# MAX_SPEECH_JOBS_PER_DAY=100

# Minutes a video job may stay rendering before it is failed with a timeout reason (default 30). Running jobs are polled from the database every ~5 s by the `media-video-poll` tick job, so a restart resumes them. Blank or invalid uses the default; there is no unlimited setting.
# MARINA_VIDEO_JOB_TIMEOUT_MIN=30

# ── Search ───────────────────────────────────────────────────────────────────

# Web search upgrades. Search works with no key (DuckDuckGo plus arXiv, PubMed and Semantic Scholar); Tavily or a self-hosted SearXNG improves results. A backend that fails — a key out of credit (Tavily answers HTTP 432), an outage, the daily spend cap — falls through to the next (Tavily → SearXNG → DuckDuckGo), is named in the reply and shows in `readiness` (check `search`); Tavily calls are priced into the daily spend ledger (source `search`). The `search` research retriever uses the same backends (see MARINA_RESEARCH_SEARCH_BACKENDS).
# @restart
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# The `search` research retriever (forecasts, typed answers, `MARINA_ARENA_RESEARCH_RETRIEVER=search`): every planned query goes through a backend chain, the pages are read (SSRF-guarded, never a no-fetch publisher) and the passages most relevant to the question are quoted verbatim, dated, so the citation check verifies them. BACKENDS is the chain in fallback order (tavily, exa, searxng, duckduckgo, openrouter; default: every configured one, then keyless duckduckgo, then — with OPENROUTER_API_KEY — OpenRouter's Exa web plugin as the paid fallback when DuckDuckGo throttles; SEARCH_MODEL is the model that carries that call); a backend that fails is skipped for the rest of the brief and reported. The question's named resolution page is read before any search. MAX_PASSAGES is the relevance top-k cut per brief (default 15; passages far below the best are dropped too). RESULTS_PER_QUERY (default 8), DOMAIN_CAP (pages per site, default 3, for source diversity) and MAX_PAGES (pages read per brief, default 14) set breadth; PASSAGE_CHARS fixes the passage budget per brief (default: the forecast's own evidence budget, sized to the model's context window). Paid backends check the daily spend cap and record their cost (source `search`).
# MARINA_RESEARCH_SEARCH_BACKENDS=tavily,exa,searxng,duckduckgo,openrouter
# MARINA_RESEARCH_SEARCH_MODEL=google/gemini-3.1-pro-preview
# MARINA_RESEARCH_MAX_PASSAGES=15
# MARINA_RESEARCH_RESULTS_PER_QUERY=8
# MARINA_RESEARCH_DOMAIN_CAP=3
# MARINA_RESEARCH_MAX_PAGES=14
# MARINA_RESEARCH_PASSAGE_CHARS=

# Where local corpora live: offline BM25 indexes built with `bun run corpus build <name> <docs.jsonl>` and searched with `web search engines:corpus:<name>`, the search room, or the `corpus:<name>` research retriever. Keep it on a disk with room (a 100k-document corpus is several GB), not a small temp filesystem.
# MARINA_CORPUS_DIR=~/.local/share/marina/corpora

# Corpus ranking. Each query's top 1,000 FTS5 candidates are rescored with BM25 k1 = 6, b = 1 (Porter-stemmed term counts, document length in characters): full length normalisation, which beat FTS5's built-in bm25() (k1 = 1.2, b = 0.75, tuned for short passages) on held-out query splits of a long-document corpus. Set BOTH K1 and B to rescore with other parameters; MARINA_CORPUS_RANKING=fts5 keeps FTS5's own ranking. Rankings are cached, so paging through results (`offset`) is cheap; a rescored search costs about 1–3 s on a 100k-document corpus (FTS5 alone ≈ 0.3 s). The BrowseComp-Plus harness ranks with FTS5 unless K1 and B are set explicitly.
# MARINA_CORPUS_RANKING=rescored
# MARINA_CORPUS_BM25_K1=
# MARINA_CORPUS_BM25_B=

# Optional hybrid corpus search: the query embedder. none (default) keeps every corpus on BM25 exactly as above. local (the pinned MiniLM extension), ollama (an operator-run /api/embed) or openai (ANY OpenAI-compatible /v1/embeddings: OpenAI, OpenRouter, a local llama.cpp / vLLM / TEI server; URL, model and an operator-declared immutable revision required). Hybrid search applies only to a corpus holding vectors from the same model (`bun run corpus embed <name>` with this configuration, or `bun run corpus vectors import`); otherwise, and on any embedding failure or the daily spend cap, the search is BM25 and says so. Paid query embeddings are recorded in the spend ledger as `search`. The API key falls back to OPENROUTER_API_KEY / OPENAI_API_KEY only for those vendors' own hosts. DIMENSIONS asks the server for a Matryoshka-truncated vector (the stored vectors must match).
# @protected
# MARINA_CORPUS_EMBEDDINGS=none
# MARINA_CORPUS_EMBEDDING_URL=
# MARINA_CORPUS_EMBEDDING_MODEL=
# MARINA_CORPUS_EMBEDDING_REVISION=
# MARINA_CORPUS_EMBEDDING_API_KEY=
# MARINA_CORPUS_EMBEDDING_DIMENSIONS=
# MARINA_CORPUS_EMBEDDING_CACHE=data/memory-models
# MARINA_CORPUS_EMBEDDING_LOCAL_ONLY=false

# Per-input cap for remote corpus embeddings, in estimated tokens (UTF-8 bytes / 3): longer inputs are cut to their head before they are embedded (default 8192; 0 = no cap), as MARINA_MEMORY_EMBEDDING_MAX_TOKENS.
# MARINA_CORPUS_EMBEDDING_MAX_TOKENS=8192

# Hybrid corpus search: weight of the dense ranking in the reciprocal-rank fusion (the BM25 ranking weighs 1). Each ranking contributes its top 1,000.
# MARINA_CORPUS_HYBRID_WEIGHT=2

# ── Chat adapters ────────────────────────────────────────────────────────────

# Telegram bot token (from @BotFather). Unset leaves the adapter off.
# TELEGRAM_TOKEN=

# Discord bot token. Unset leaves the adapter off.
# DISCORD_TOKEN=

# Comma-separated Discord channel ids the bot operates in. Empty means every channel the bot can read.
# DISCORD_CHANNEL_IDS=

# ── Federation ───────────────────────────────────────────────────────────────

# Shared secret for the gateway handshake: outgoing gateway connections send it and incoming ones must present it before logging in, or the socket closes. It does not fence bridged-channel participation or cross-instance tells; a hard boundary also needs MARINA_AUTH=better-auth. Unset allows any peer.
# @protected
# GATEWAY_SECRET=

# Drop a bridged channel message or tell that has already crossed this many instances.
# MARINA_MAX_RELAY_HOPS=3

# Ed25519 federation identity (base64 PKCS#8 DER, or PEM with escaped newlines). Set to publish signed v2 manifests; unset publishes unsigned v1.
# @restart
# MARINA_FEDERATION_SIGNING_KEY=

# `true` accepts unsigned cross-world mesh events on `mesh replicate`, whose origin cannot be verified. Only between development instances on a trusted network.
# @protected
# MARINA_FEDERATION_ALLOW_UNSIGNED=false

# ── Harness decisions ────────────────────────────────────────────────────────

# Optional advisory use cases (all off by default). observe records judgments without applying advice or reordering context; on applies bounded advice or within-tier context ordering. Both modes consume time and model budget. These do not change tool safety gates or approvals. Enabling a feature sends its authorized, masked evidence excerpts to the configured decision backend, then the fallback below if needed. No usable backend leaves the existing operation intact.
# MARINA_RESEARCH_ADVICE=off
# MARINA_MEMORY_CONTEXT_VALUE=off
# MARINA_CREW_DELIVERABLE_REVIEW=off

# Advisory fallback: one verbalized classifier call through Marina's own /v1 using this model. The default also lets standalone web research use its existing model without a running server. none disables the fallback; it does not disable a configured primary. Receipts identify the actual answering model and mark task calibration unmeasured. No extra provider credentials are required beyond the model's usual configuration.
# MARINA_ADVISORY_FALLBACK_MODEL=marina/default

# Total deadline per advisory judgment, including fallback (1-60000 ms, default 4000). With two backends, half is reserved for fallback. Caller cancellation and the daily spend cap stop the chain. The normal safety gate retains its own failure policy.
# MARINA_ADVISORY_TIMEOUT_MS=4000

# Decision backend for cheap per-step judgements (it receives tool names and redacted arguments). `auto` (default; alias `on`): a chat classifier answering through this Marina's own /v1 with the world's default model (`marina-self`; MARINA_DECISION_MODEL overrides) — the strongest model the operator configured, on providers the world already uses, never a cheaper stand-in; with no provider at all decisions are off. `off` turns them off. `decisions-api` (alias `jev`): a Jev-family model over the Decisions API on OpenRouter, or a self-hosted OpenJev. `typesafe`: TypeSafe's API. `chat-classifier` (aliases `classifier`, `llm`): any chat model (see MARINA_DECISION_MODEL). Every MARINA_DECISION* setting except base URLs, paths and API keys can also be changed at runtime (`admin decisions set …`, Admin → Ops → Decisions); a value set here wins and locks it.
# MARINA_DECISIONS=auto

# Backend model. Defaults: typesafe/jev-1.13 for decisions-api, jev-latest for typesafe; chat-classifier uses google/gemini-3.1-pro-preview on OpenRouter, zai-org/GLM-5.3-Flash on the Hugging Face router, or the local runtime's default model on a configured llama.cpp / Ollama / vLLM server, and any other base URL must name a model.
# MARINA_DECISION_MODEL=typesafe/jev-1.13

# Backend endpoint. Defaults: https://openrouter.ai/api/alpha (decisions-api), https://api.typesafe.ai (typesafe); chat-classifier: OpenRouter with OPENROUTER_API_KEY, else the Hugging Face router with its key, else a configured local runtime (LLAMA_BASE_URL / OLLAMA_BASE_URL / VIBETHINKER_BASE_URL or its key), else https://openrouter.ai/api/v1.
# @protected
# MARINA_DECISION_BASE_URL=https://openrouter.ai/api/alpha

# Backend key. Unset falls back by host: OPENROUTER_API_KEY for openrouter.ai, TYPESAFE_API_KEY for api.typesafe.ai, HUGGINGFACE_API_KEY or HF_TOKEN for router.huggingface.co.
# @protected
# MARINA_DECISION_API_KEY=

# Decisions API path (typesafe uses /v1/systemone).
# @protected
# MARINA_DECISION_PATH=/decisions

# TypeSafe API key, used by the typesafe backend.
# TYPESAFE_API_KEY=

# Backend timeout in milliseconds (default 2000; 8000 for chat-classifier).
# MARINA_DECISION_TIMEOUT_MS=2000

# Chat models served as Jev-compatible engines on /v1/systemone as `marina/classifier:<model>`, through Marina's own passthru and spend ledger. Comma list, or `*` for any model Marina routes. Works with or without MARINA_DECISIONS. GET /v1/decisions/models lists them.
# MARINA_DECISION_ENGINES=

# How chat classifiers get probabilities: auto, logprobs, sampled or verbalized. Unset: engines use auto and a chat-classifier backend stays verbalized.
# MARINA_DECISION_METHOD=

# Calls per decision for the sampled method (clamped 2–15).
# MARINA_DECISION_SAMPLES=5

# Members of the `marina/ensemble` engine, which asks them in parallel and needs a strict majority to answer. `marina/auto` asks the backend first and consults the ensemble (else the first engine) only when unsure or down. Classifier members must be admitted by MARINA_DECISION_ENGINES.
# MARINA_DECISION_ENSEMBLE=

# Earned gate calibration file written by `bun run qualify:decisions -- --calibrate <file>`. Applied only to a backend whose fit was earned; a missing, invalid or group/world-writable file changes nothing.
# MARINA_DECISION_CALIBRATION=

# Run Marina's own harness (tool gate, spawn routing, task verifier, `decision` commands) on an engine such as marina/auto instead of the configured backend. Unresolvable falls back to the backend with a readiness warning.
# MARINA_DECISION_ENGINE=

# How long `marina/auto` waits for a second opinion before the primary's answer stands (milliseconds; `0` = no limit). Not applied when the primary failed: the fallback is then the only judge.
# MARINA_DECISION_SECOND_OPINION_TIMEOUT_MS=3000

# Adopted gate-question wording file written by `bun run qualify:decisions -- --adopt <file>`. Refused unless the variant earned a held-out win.
# MARINA_DECISION_GATE_QUESTIONS=

# `on` scores mutating agent tool calls before they run (fail-closed; reads and messages are never sent). Needs a backend.
# MARINA_DECISION_GATE=off

# With the gate on, also send the agent's operator-set intent and the trust labels of its prompt inputs (never the content). `off` sends the call only.
# MARINA_DECISION_GATE_CONTEXT=on

# How long an ask-a-person verdict's challenge stays open, in milliseconds. Defaults to MARINA_CHALLENGE_TTL_MS.
# MARINA_DECISION_APPROVAL_TIMEOUT_MS=3600000

# Verify `task submit` deliverables: `observe` (default) records the judge's opinion without acting, so its agreement with creators is measured (`decision agreement`); `on` bounces a weak first attempt once (advisory; the creator still approves); `off` never scores. Code Mode submits (which already passed their required checks) get the opinion recorded under both `observe` and `on`, never a bounce. Needs a backend; nothing is scored without one.
# MARINA_DECISION_VERIFY=observe

# Most images one decision request may carry (`/v1/decisions` and in-world decisions; 1–32). Every image is decoded and prepared to Jev's limits (PNG/JPEG, 256–1568 px a side, 78,400–2,458,624 px, ≤ 16 MiB) before it leaves Marina; together ≤ 30 MiB.
# MARINA_DECISION_MAX_IMAGES=8

# After an image generation, ask the decision backend whether the image depicts its prompt. `observe` records the numbers and a label on the job and as an `agent_decision` event; `on` also regenerates a mismatch at most once (an ordinary job: quota and spend cap apply); `off` (default) makes no call. An outage is never a mismatch. Needs a backend that reads images (Jev, or a vision chat classifier).
# MARINA_MEDIA_VERIFY=off

# ── Model routing ────────────────────────────────────────────────────────────

# Tiers for `agent spawn <name> model:route goal:<…>`, chosen once at spawn and persisted. With neither tiers nor MARINA_ROUTES set, model:route has one candidate (this installation's first available model, else marina/default) and says so in the route event; with tiers but no backend or goal, the powerful tier is used.
# MARINA_ROUTE_FAST_MODEL=openai/gpt-6-luna
# MARINA_ROUTE_POWERFUL_MODEL=anthropic/claude-opus-5-5

# Route table (JSON object of name → {model, criteria}); wins over the two tiers. Low confidence (< 0.6), no backend or an error use MARINA_ROUTE_FALLBACK (default `powerful` if present, else the last route).
# MARINA_ROUTES={"cheap":{"model":"openai/gpt-6-luna","criteria":"Lookups and small edits."},"powerful":{"model":"anthropic/claude-opus-5-5","criteria":"Architecture and unclear failures."}}
# MARINA_ROUTE_INSTRUCTIONS=Choose the least costly model that can complete the task.
# MARINA_ROUTE_FALLBACK=powerful

# Benchmark evidence for model:route (src/engine/benchmark-evidence.ts). After the router picks, measured ledger results may prefer another of the SAME candidates: the best Wilson lower bound among at least two candidates with MIN_N items in the role's families (and within MAX_COST_USD per item, when set). `observe` (the default) records the pick on the route decision without acting; `on` applies it; `off` skips it. Resolved once at spawn and persisted; any error keeps the router's choice. Families: a comma list of benchmark names for every role, or JSON {"*": [...], "<role>": [...]}; when unset, the spawning role's own declared families (its traits' `families` capability) are used, expanded to the registered benchmarks tagged with them; with none, evidence never applies. Evidence is traced participants and direct-model runs; window evidence only with MARINA_ROUTE_EVIDENCE_WINDOW=true, shared window evidence never. Inspect with `trace advise evidence <benchmark>`.
# MARINA_ROUTE_EVIDENCE=observe

# Live evidence in spawn-time route evidence (src/outcomes/evidence.ts): also weigh what each candidate model (and role) actually got done on real work — task verdicts, Code Mode checks, outcomes reported to POST /v1/outcomes — as families `live:<source>`, mechanical outcomes only, never measurement, and only SHARED work (a person's work, or their agents', never pools into it). Same MIN_N, objective and observe/on mode as the ledger evidence, so under the default `observe` it is recorded, not applied. Default on; `off` uses the ledger only.
# MARINA_ROUTE_EVIDENCE_LIVE=on
# MARINA_ROUTE_EVIDENCE_FAMILIES=hle-verified-gold,frames
# MARINA_ROUTE_EVIDENCE_MIN_N=30
# MARINA_ROUTE_EVIDENCE_MAX_COST_USD=0.05
# MARINA_ROUTE_EVIDENCE_WINDOW=false

# What the evidence pick optimizes.
# - `lcb` (default): the best Wilson lower bound.
# - `budget`: the best lower bound within MARINA_ROUTE_EVIDENCE_MAX_COST_USD per item; it never picks without a budget.
# - `value`: the CHEAPEST priced candidate not measurably worse than the best-lower-bound one. Its point accuracy must be within TOLERANCE (absolute, 0–1) of the best's. With at least MIN_N shared items, a paired exact McNemar test must not show a significant loss (p < 0.05); otherwise its interval must overlap the best's lower bound.
# Evidence is per role first (participants whose agent plays the spawning role) and falls back to model level when fewer than two candidates have MIN_N role items.
# MARINA_ROUTE_EVIDENCE_OBJECTIVE=lcb
# MARINA_ROUTE_EVIDENCE_TOLERANCE=0.05

# Replicates a challenger needs before `benchmark promote` reads a slot's holdout (src/engine/benchmark-promotion.ts). A replicate is another ledger run of the same target on the same items with the same judge (one replicate group). With replicates on either side, the paired interval is a two-stage bootstrap (runs, then items), so run-to-run variance counts against the gain. An integer from 1 to 100; 1 restores single-run promotion. Anything else is the default.
# MARINA_PROMOTION_MIN_REPLICATES=2

# Share of a benchmark run's items that may be fallbacks — an error, a spend-cap or provider refusal, or an unparseable reply replaced by a default — before the ledger records the run `invalid` (src/engine/benchmark-ledger.ts). An invalid run keeps its items but is excluded from every ledger reader (leaderboard, frontier, compare, replicates, participants, promotion, route evidence); `benchmark runs` and `benchmark result` show it marked with the reason, and `benchmark revalidate` (role.edit) reverses it. Read wherever a run is recorded: the server (in-world runs and POST /v1/benchmarks/runs), `bun run benchmark:import` and `bun run futurex`. A share from 0 to 1, exceeded strictly; `off` (or 1) disables the check; junk is the default. The default is conservative: a few timeouts are the target's own failures and stay scored.
# MARINA_BENCHMARK_MAX_FALLBACK_RATE=0.25

# Where in-world `benchmark kit` runs keep their run directories (servers, scratch, logs). Default: `kit-runs/` beside the world DB (`DB_PATH`). The kit's runs file into the world DB either way.
# MARINA_BENCHMARK_KIT_DIR=

# ── Forecasting ──────────────────────────────────────────────────────────────

# `forecast`, `bun run forecast` and POST /v1/forecast (docs/guides/forecasting.md). No vendor key is required: unset, every part sizes to what is configured (docs/guides/single-model.md). Analysts are a comma list of models (defaults with OPENROUTER_API_KEY: Claude Fable 5.1 and GPT-6 Astra through ANTHROPIC_API_KEY / OPENAI_API_KEY when set, else via OpenRouter, plus Gemini 3.1 Pro via OpenRouter; without OPENROUTER_API_KEY, the configured providers or a single local model, which then answers as the one analyst × K runs); the retriever defaults to OpenRouter web search on Gemini 3.1 Pro over Exa plus the `search` retriever (every planned query through the search backend chain, pages read and quoted), else `search` alone (keyless DuckDuckGo when no search key is set); the judge is jev (without OPENROUTER_API_KEY: the MARINA_DECISIONS backend, else no judge), decisions (the MARINA_DECISIONS backend, falling back to jev) or none. Substitutions are reported as the answer's `scale` (tier `degraded`); only having no model at all is an error.
# MARINA_FORECAST_ANALYSTS=anthropic/claude-fable-5-1,openai/gpt-6-astra,openrouter/google/gemini-3.1-pro-preview
# MARINA_FORECAST_RETRIEVER=openrouter-web:google/gemini-3.1-pro-preview@exa,search
# MARINA_FORECAST_JUDGE=jev

# Evidence depth for typed forecasts. DOSSIER_CHARS is the research dossier each run reads (default: sized to the analysts' context window, 12 000–60 000 characters; 24 000 when unknown); when the dossier is longer, verified lines are kept first. MIN_EVIDENCE is the number of verified lines wanted before the runs (default 5; 0 = off): fewer triggers one more research round first. Otherwise FOLLOWUP=on (default) runs that one extra round after the runs when none is grounded in verified evidence, and redoes the runs only if it verified something new; off disables both. DISAGREEMENT=on (default): when the runs disagree (agreement below 0.7), one round searches the point they disagree on and one more run reads it, pooled with the others.
# MARINA_FORECAST_DOSSIER_CHARS=
# MARINA_FORECAST_FOLLOWUP=on
# MARINA_FORECAST_MIN_EVIDENCE=5
# MARINA_FORECAST_DISAGREEMENT=on

# Read swarm (src/retrieval/read-swarm.ts; off unless set): a reader model that reads every page research finds IN FULL against the question's clues and reports verbatim quotes, which are checked mechanically before they reach the dossier. Set, typed forecasts' research rounds put the readers' verified quotes ahead of the retriever's report, and `web swarm <question>` (any agent or crew) answers with a candidate table. Any model spec (`provider/model`); a cheap one is the point. Every reader call is priced against the daily spend cap.
# MARINA_READ_SWARM_READER=openai/gpt-6-luna

# Portable research evidence: capture source text, dates, hashes and verification for offline replay. Shared by arena and general forecasts; off preserves the existing retrieval behavior. Live snapshots record capture time separately from publication/vintage time and are not historical archives.
# MARINA_RESEARCH_EVIDENCE=off
# Target-aware whole-claim selection and independent-origin balancing: off, observe, on.
# Uses the captured evidence contract; judges cannot override dates or target identity.
# MARINA_RESEARCH_TARGET_EVIDENCE=off
# Operator-imported survey-wave JSON array, produced by scripts/arena-survey-import.py.
# No automatic publisher scraping. Availability and target identity are checked at capture.
# @protected
# MARINA_RESEARCH_SURVEY_FILE=
# Imported ReleaseEvent JSON array, keyed by round/question id in each target field.
# Adds due release source reads; scheduled events never stand in for published results.
# @protected
# MARINA_RESEARCH_CALENDAR_FILE=
# Recheck evidence before reusing an accepted formation. Changed inputs, daily expiry,
# or the final two hours before lock require a new forecast. Operator-only, opt-in.
# MARINA_ARENA_EVIDENCE_REFRESH=off

# Spread calibration of filed arena sds — a scalar topline and every profile cell — per (family, method): the multiplier with the best mean per-round skill over resolved rounds we filed (CRPS for scalars, the arena's energy score for profiles; outcomes from the arena's public site data, published before min(now, lock) only), partially pooled in log space (method → family → cross-family, w = n/(n+4)) and clamped to [0.35, 3]. It runs last, after the measured-error floor; the decision and its evidence (n, ŝ, w per level) are kept under `spreadCalibration` in the filing detail. `on` (default) applies the multiplier, `observe` records it without applying, `off` skips it.
# MARINA_ARENA_SPREAD_CALIBRATION=on
# Retired name of the switch above, still read when MARINA_ARENA_SPREAD_CALIBRATION is unset.
# MARINA_ARENA_CALIBRATION=on

# Learned move weight for formation filings, per (family, method): the filed mean is start + w × (median member proposal − start), w ∈ [0, 1.5] fitted by minimum CRPS on our resolved filings and arena shadows of the same key (shrunk toward the formations' own trust), adopted only when it beats what was filed on the newer 40 % by 5 % AND shuffling the members' moves across rounds does not reach the same gain (placebo). Until then the formation's constant trust stands. `on` (default) applies an adopted weight, `observe` records it without applying, `off` skips it. The measured-error floor and then the spread calibration run after it.
# MARINA_ARENA_MOVE_WEIGHT=on

# Bounded evidence gap loop, 1–3 rounds per retrieval (default 1). Values above 1 enable evidence capture. A reviewer names up to three missing or contradictory facts; stop on no new verified evidence or no remaining queries. Typed forecasts already have an outer research loop: keep its research-round setting at 1 when isolating this inner loop. LOOP_MODEL defaults to the caller's lead/first analyst. Model and search spend still use the shared daily/scope ledger.
# MARINA_RESEARCH_LOOP_ROUNDS=1
# MARINA_RESEARCH_LOOP_MODEL=

# Typed forecasts (a choice, a set of options, a number, a ranking or a short string; `forecast … type:<t>`, `bun run forecast --type`, POST /v1/forecast with `answer`). The retriever also accepts openrouter-web:<model>@exa|@native (the web plugin's engine; Exa excerpts serve the citation check), sonar:<model>, tavily:<basic|advanced> (TAVILY_API_KEY), search[:<backend>+<backend>…] and asof[:<providers>] (keyless and date-strict, bounded to each forecast's cutoff: gdelt, wikipedia, hn, arxiv, wayback; docs/guides/search.md), comma-separated to merge. The planner decomposes the question and names research gaps (default: the first analyst); the critic searches for evidence against the leading answer and may revise it only when its confidence exceeds the runs' agreement (default: the planner). RUNS independent answers (1–9, analysts used round-robin) are combined by type; RESEARCH_ROUNDS bounds the search loop (1–4); CRITIQUE=off skips the disconfirmation pass. LOOKUPS picks structured sources (also answerable directly with the `data` command): unset or `auto` (the default) turns on every one that can run here — polymarket, kalshi, fred and bls (keyless) plus odds when ODDS_API_KEY is set; `off` or `none` (or empty) turns them off; otherwise a comma list: polymarket and kalshi (market prices; a past cutoff reads the last price at or before it, never the resolution), odds (sports head-to-head odds via ODDS_API_KEY; historical snapshots need a paid plan), fred (official series; vintage-correct for a past cutoff with FRED_API_KEY, live-only without), bls (live-only), or markets / all. Every lookup reads as of the earlier of the cutoff and now. A number is anchored on the freshest official reading with a horizon-scaled spread.
# MARINA_FORECAST_PLANNER=openrouter/deepseek/deepseek-v4-pro
# MARINA_FORECAST_CRITIC=openrouter/deepseek/deepseek-v4-pro
# MARINA_FORECAST_RUNS=3
# MARINA_FORECAST_RESEARCH_ROUNDS=2
# MARINA_FORECAST_CRITIQUE=on
# MARINA_FORECAST_LOOKUPS=auto

# How POST /v1/forecast combines a typed forecast's runs (src/forecast/formations.ts): `ensemble` (default — combined by type, then the critique), `delphi` (each member revises once after an anonymous panel summary; median of the revisions), `tournament` (pairwise knockout judged by the critic; the champion's answer) or `skeptic` (the arena's crew: the first two analysts propose as statistician and analyst, the critic — else the third analyst — sets how much of their move away from the prior to trust; deterministic aggregation that only shrinks toward an informative prior — never the uniform default; without one the proposals' log-odds mean stands; one model runs every role). The research and cutoff are the same for all of them.
# MARINA_FORECAST_FORMATION=ensemble

# Plain questions (a probability or a number with no `answer` spec, on POST /v1/forecast, the `forecast` command and `bun run forecast`) run through the same typed pipeline by default — a yes/no choice with probabilities, or a typed number — so they get the plan, research rounds, runs, judge, critique, lessons, formation and routing; the answer keeps the plain shape (`probability`, or `mean`/`sd`/80 % `interval`) with the typed answer attached as `typed`. It costs more than the older pipeline (runs × research rounds instead of one round of analysts). `legacy` keeps the older single-round analyst pipeline.
# MARINA_FORECAST_PLAIN=typed

# The board whose earned forecast configuration (`forecast-config:<board>`, filed by a selection such as `forecastbench select`) the general surfaces read before the general slot; `--board` on `bun run forecast` and `board` on POST /v1/forecast win over it. Unset reads only the general and family slots.
# MARINA_FORECAST_BOARD=

# Prior shrink and recalibration for typed forecasts (src/forecast/adjust.ts), applied once at the end of any formation. Both default to `earned`: the stage runs and records itself on every answer, but a learned weight or map changes an answer only after it wins on the held-out split below, and an earned prior shrink has no cold-start weight (PRIOR_WEIGHT defaults to 0 there), so with no history no answer moves. `on` adds the operator's cold-start weight; `off` skips the stage. PRIOR=on pools the finished answer toward the best prior available at the evidence cutoff — a market, community or statistical forecast the caller supplied (`priors` on POST /v1/forecast; statistical = a series' own history or a published reference class's base rate, e.g. the ForecastBench adapter's dataset priors), one priced market a lookup matched for a yes/no question, the freshest official reading for a number, the question class's base rate in resolved history, else the type default — in log-odds (numbers: linearly). PRIOR_WEIGHT (0–1; default 0.5 under `on`, 0 under `earned`) is the weight toward a supplied prior before there is evidence; every other prior starts at 0. Only an INFORMATIVE prior earns a shrink (never the uniform type default, which would only add to the hedging LLM forecasters show); with enough records in a time-to-close bucket (≤ 7 d, ≤ 30 d, > 30 d; and liquidity below/above $10k when the caller supplies `liquidity`) the weight is fitted there, so a liquid market near its close can earn more weight than a thin one far from it. CALIBRATION=on applies a recalibration map per answer group (Platt in log-odds for choices and multi-selects, an sd scale for numbers); `observe` fits and records it without applying it; `fixed:<a>` (e.g. `fixed:sqrt3`, 0.25–4) applies a fixed Platt slope from the first forecast with no history — the cold start for a new board (a > 1 extremizes). PROB_CLAMP (0.0001–0.2) holds final probabilities inside [ε, 1 − ε], a tail guard for log-scored boards. POOL=logodds averages the runs' probabilities in log-odds (a geometric pool) instead of arithmetically (`linear`, the default). A learned weight or map is fitted on the older 60 % of the resolved history visible at the cutoff and replaces its default only when it improves CALIBRATION_SCORE (`brier` or `log`; numbers use CRPS) on the newer 40 % by at least CALIBRATION_MARGIN (relative, default 0.05) — and only with at least HISTORY_MIN visible records (default 50). HISTORY is a JSON-lines file of resolved forecasts (numbers, option ids, the answering formation and its score — no question text) that adapters and outcome delivery append to as questions resolve; unset, it is `forecast/history.jsonl` next to an on-disk DB_PATH (none for an in-memory database), and `off` keeps none. Recording changes no forecast; a record is used only when its outcome was known at the forecast's cutoff, and never for its own question. Every prior, weight and map is recorded on the answer (`adjustment`).
# MARINA_FORECAST_PRIOR=earned
# MARINA_FORECAST_PRIOR_WEIGHT=0
# MARINA_FORECAST_CALIBRATION=earned
# MARINA_FORECAST_CALIBRATION_MARGIN=0.05
# MARINA_FORECAST_CALIBRATION_SCORE=brier
# MARINA_FORECAST_PROB_CLAMP=0.01
# MARINA_FORECAST_POOL=linear
# MARINA_FORECAST_HISTORY=
# MARINA_FORECAST_HISTORY_MIN=50

# Automatic resolution (src/outcomes/autoresolve.ts): every hour, the markets that open saved answers are linked to (`resolves:<venue>/<ticker>`) are read, at most 20 per pass, and a resolved one settles every answer waiting on it. Public Kalshi/Polymarket reads only. `off` waits for a `probe`.
# MARINA_OUTCOME_AUTORESOLVE=on

# Judged outcomes (src/outcomes/judge-resolution.ts, judge-quality.ts), hourly, spend-capped; no decision backend means nothing.
# - Resolution: a saved answer that no market settles is researched after its end time plus 2 days, and the decision backend judges how it resolved, at most 5 per hour. Choice answers: it picks an option. Multi-select: a yes/no per option behind a "has it resolved" gate. Numbers: MARINA_OUTCOME_JUDGE_MODEL proposes the value with a verbatim quote that must be in the evidence, and the backend confirms it.
# - Quality: a task submission its creator has not decided within 3 days is judged for whether it completes the task, at most 5 per hour.
# - `off` (default): nothing. `observe`: every judgement is recorded as a judged outcome that settles and teaches nothing, measured against any mechanical result (`outcome agreement`). `on`: as observe, and a confident judgement (≥ 0.9) from a judge that has earned agreement (≥ 25 comparisons, Wilson lower bound ≥ 0.85) settles the answer or is delivered as a lesson, labelled judged.
# MARINA_OUTCOME_JUDGE=off

# The model that proposes a number's resolved value for judged resolution; default the first MARINA_FORECAST_ANALYSTS model, else marina/default.
# MARINA_OUTCOME_JUDGE_MODEL=

# Method routing for every forecast surface (src/forecast/card-routing.ts): which method card answers. `off` answers with MARINA_FORECAST_FORMATION (outcomes are still tagged); `observe` records on each answer (`routing`) which card routing would pick and still answers with the default; `on` (default) uses it — without enough paired evidence the pick is the default card (the operator's formation and options), so `on` changes nothing until a challenger earns it. Evidence is per class, most specific first — the board, the caller's `category`, the judged domain (MARINA_FORECAST_FEATURES), then the answer group — using the first class with at least ROUTE_MIN_N records: resolved, mechanically scored outcomes tagged `family:<class>` and `method:<card>` (a measurement run counts only for its own board), plus formation records in MARINA_FORECAST_HISTORY. A challenger replaces the default only when, on at least ROUTE_MIN_N questions both answered, its paired gain has a 95 % lower bound above 0 and clears the fishing margin 0.02 + 0.01·log₂(1 + challengers tried); sibling classes only order what to explore next. A card whose preconditions fail here (a panel with one run, no retriever, no checker) is never a candidate. CANDIDATES is a comma list of formations or card specs `<formation>[+verify|+noverify][+closed-book]` (closed-book: no web research, lookups still run; default the four plain formations); an unknown entry is dropped.
# MARINA_FORECAST_ROUTE=on
# MARINA_FORECAST_ROUTE_CANDIDATES=ensemble,delphi,tournament,skeptic
# MARINA_FORECAST_ROUTE_MIN_N=30

# Question features for method routing (src/forecast/featurise.ts). Mechanical features (answer type, group, category, board, horizon) are always used. `auto` (default) also asks the configured decision backend (MARINA_DECISIONS) two fixed questions — the question's domain from a fixed list and whether a scheduled event falls inside the horizon — and adds the domain to the class chain; `on` the same; `observe` asks and records them on the answer without using them; `off` asks nothing. Only the question text (emails and secrets masked, clipped), the answer type and the horizon are sent — never the asker's context, priors or identity. No backend, a timeout or the spend cap falls open to the mechanical features; the content-free receipt goes on the answer.
# MARINA_FORECAST_FEATURES=auto

# Verification inside a typed forecast: with VERIFY=on (the default; `off` skips it) each run's draft is checked by VERIFIER (default: the critic, so one model runs it too) against the dossier and the resolution rules before it is combined, and a concrete correction replaces it. It adds one checker call per run. `--formation verify` on `bun run forecast` turns it on for one run. RETRIEVAL_FILTER=strict keeps only research lines whose every cited page is provably published on or before the evidence cutoff (engine date, else a date in the URL) and that name no later day; undated and live-result pages are dropped. Use it for past-cutoff forecasts (replays, backtests); date-filtered engines (tavily:, exa:) need no filter, and `closed-book` as the retriever disables retrieval.
# MARINA_FORECAST_VERIFY=on
# MARINA_FORECAST_VERIFIER=
# MARINA_FORECAST_RETRIEVAL_FILTER=none

# Wall-clock budget per typed forecast, in seconds (unset or 0 = none). Budget-terminal answering: from about 75 % no further research round starts; at the cap lookups, verification and the critique are skipped and the answer is combined from the runs finished so far (the first run to finish, when none has). The answer then carries `budgetForced`, and a skipped check is recorded as `not_run`, never as a failure.
# MARINA_FORECAST_BUDGET_S=0

# How a typed forecast's K runs become one answer. `agreement` (the default) combines the runs by type and reports their agreement as the confidence. `confidence` takes the run with the highest self-reported confidence and reports that confidence, which is the bar a critique must clear to replace it. Agreement among same-model runs measures consistency, not correctness. The default changes only after `confidence` wins on a held-out split by the promotion margin (`benchmarks/futurex/rescore-selection.ts` re-scores saved forecasts offline).
# MARINA_FORECAST_SELECTION=agreement

# Exa search for forecast and arena retrieval (`exa:auto`, `exa:neural`, `exa:keyword`): filtered server-side by publication date to the brief's window, so it is a date-filtered engine.
# @restart
# EXA_API_KEY=
# Keys for forecast lookups (each lookup is skipped when its key is unset): The Odds API (sports odds), FRED (St. Louis Fed; vintage data for a past cutoff), and BLS (optional; raises the public API's quota).
# @protected
# ODDS_API_KEY=
# FRED_API_KEY=
# BLS_API_KEY=

# An analyst written `marina:<crew>` asks that crew through a Marina server's model API (for example a crew in the verification formation). URL defaults to http://localhost:3300; the key is that server's MODEL_API_KEYS entry. The crew's spend is recorded by that server.
# @protected
# MARINA_FORECAST_MARINA_URL=http://localhost:3300
# MARINA_FORECAST_MARINA_KEY=

# ── Social Simulation Arena ──────────────────────────────────────────────────

# Signed participation in the MIT Social Simulation Arena (docs/guides/arena.md). Off unless an entrant id is set. The key file holds the Ed25519 private key (mode 0600, `bun run arena keygen <path>`).
# @restart
# MARINA_ARENA_ENTRANT=<your-entrant-id>
# MARINA_ARENA_KEY_FILE=/srv/marina/arena-key.pem
# MARINA_ARENA_KEY_ID=k1

# File each round automatically during its last MARINA_ARENA_WINDOW_HOURS hours (default 24; above 168 is clamped to 168 with a warning; an invalid value falls back to 24).
# MARINA_ARENA_AUTOPILOT=off
# MARINA_ARENA_WINDOW_HOURS=24

# Anchor guard, before signing any arena filing: compare the forecast's anchor (the latest reading its inputs saw, per series or profile cell) with the arena's own latest published value (persistence baseline in the arena's site data, dated by its series tail), tolerant of the arena's rounding. An older release with a different value is stale: the inputs are re-read once, and if still stale the stale means are shifted onto the arena's value; the attempt is recorded as `stale_anchor` and the filing watch alerts. `submit due --replace` also refiles every open round whose accepted filing is stale, whatever its lock. `on` (default) re-reads and re-anchors, `observe` records the verdict and files what was forecast, `off` skips the check. Ranking rounds are never checked.
# MARINA_ARENA_ANCHOR_GUARD=on

# What answers (default nowcast — no model calls; the baseline for non-Civiqs rounds): nowcast (freshest Civiqs reading), baseline, spike-decay (nowcast with Trends basket event-week cells decayed toward their recent level; a shadow challenger), discovered (best promoted signal, else nowcast), tabh2o[:forecast][@nowcast] (experimental; TabH2O on the lock's own history, needs TABH2O_API_KEY), wiki-specialist[:<m>[,…]] (Wikipedia top 10 from projected target-week pageviews; no model calls without models, optional verified scheduled events with them), model:<provider/model>, crew:<m>[,<m>,<m>] (statistician, analyst, skeptic) or research:<m>[,<m>,<m>]. A model's answer is shrunk toward the baseline by MARINA_ARENA_MODEL_WEIGHT. Measure with `bun run arena evaluate` before switching.
# MARINA_ARENA_FORECASTER=nowcast

# Per-family routing for MARINA_ARENA_FORECASTER=routed (or a literal route:… spec): one forecaster per tracker family, `skip` to leave a family unanswered (the board averages only answered rounds), `*` for the rest. Unset uses *=nowcast; every family is answered.
# MARINA_ARENA_ROUTES=civiqs=nowcast;economist_yougov=skip;*=nowcast
# MARINA_ARENA_MODEL_WEIGHT=0.5

# Earned routes: each route above is its family's DEFAULT; a challenger forecaster replaces it only after it beat the default on at least ROUTE_MIN_N resolved rounds both answered (our scored filings and the arena shadow ledger, outcomes public by then), with the paired gain's 95 % lower bound above 0 and past the fishing margin. `<family>=!<spec>` pins a family (never replaced); `skip` is always pinned. `on` (default) answers with an earned challenger and falls open to the default without one, `observe` records the pick only, `off` skips the evidence read. Every decision is recorded in the filing's detail; `bun run arena routes` shows them. SHADOW_CHALLENGERS lists the challengers `bun run arena shadow challengers <round|due>` runs per family (`<family>=<spec>|<spec>;…`) — nothing paid runs unless listed.
# MARINA_ARENA_ROUTING=on
# MARINA_ARENA_ROUTE_MIN_N=8
# MARINA_ARENA_SHADOW_CHALLENGERS=

# `research:wiki-events:<model>[@<retrievers>]` and `wiki-specialist:<model>[,…][@<retrievers>]` (Wikipedia top-N with scheduled events): the most articles a run may add to the statistical list (recency, or the specialist's projected weekly views) from mechanically verified events (0 = none, the statistical list only).
# MARINA_ARENA_WIKI_EVENTS_MAX_INSERT=3

# Start forecast for noisy weekly poll toplines (scalar rounds of economist_yougov, morning_consult and aaii): the average of persistence and the arena's EWMA null (alpha 0.4), sd half the rule's own recent one-step RMS error (floor 0.5), chosen by walk-forward backtest on mean per-round skill. `off` files the persistence-based baseline instead. Formations and research start from whichever is filed.
# MARINA_ARENA_POLL_LEVEL=on

# `off` stops the nowcast reading the live Civiqs dashboard for open rounds (rounds past their lock never do).
# MARINA_ARENA_CIVIQS_LIVE=on

# `on` counts a Google Trends basket's partial current week as its latest reading.
# MARINA_ARENA_TRENDS_PARTIAL=off

# Horizon-aware Civiqs nowcast (experimental, off until a backtest earns it): `drift` adds a damped local trend to the release day where the series' own history says trends persist, `sd` widens the spread to the h-day-ahead error plus revision noise, `both` does both. Applies wherever the nowcast is the start forecast (nowcast, formations, research). DAMPING is φ in (0, 1]. Measure with `bun run arena evaluate` or the `nowcast-drift:<φ>` / `horizon` signals before switching.
# MARINA_ARENA_NOWCAST_HORIZON=off
# MARINA_ARENA_NOWCAST_DAMPING=0.8

# Optional comma-separated Civiqs series ids to receive horizon correction (for example civiqs_net_econ_now). Unset applies the selected mode to all series; an empty list applies to none. Scope experimental corrections before extending them to other series or profile cells.
# MARINA_ARENA_NOWCAST_SERIES=civiqs_net_econ_now

# Research forecaster: retriever (default openrouter-web:google/gemini-3.1-pro-preview with OPENROUTER_API_KEY, else tavily:basic with TAVILY_API_KEY, else keyless asof), judge (jev, decisions or none; default jev, which without OPENROUTER_API_KEY uses the MARINA_DECISIONS backend or no judge) and the trust given to verified research lines. Retrievers: openrouter-web:<model> (any model with OpenRouter's web search) or sonar:<Perplexity model> (sonar, sonar-pro, sonar-pro-search, sonar-reasoning-pro, sonar-deep-research); tavily:basic or tavily:advanced calls Tavily's search API directly (needs TAVILY_API_KEY; its page text is used for citation checks); search[:<backends>] searches every brief query through a backend chain and quotes the pages it reads (see MARINA_RESEARCH_SEARCH_BACKENDS; not date-strict); asof[:<providers>] uses keyless date-strict engines (gdelt, wikipedia, hn, arxiv, wayback) bounded to the brief's cutoff; list several, comma-separated, to merge their reports.
# MARINA_ARENA_RESEARCH_RETRIEVER=openrouter-web:google/gemini-3.1-pro-preview
# MARINA_ARENA_RESEARCH_JUDGE=jev
# MARINA_ARENA_RESEARCH_TRUST=0.5

# Proposal judge for delphi and symbiosis formations that carry a verified research dossier: after the final revisions, the judge answers one yes/no question per member — is this member's move from the start supported by the verified dossier lines? — and the support weights the median move and multiplies the trust (DEFAULT_TRUST × agreement × mean support, so trust only drops). No verified lines or no moving proposal leaves the forecast as it was; a judge outage, timeout or spend-cap refusal files the unjudged aggregation (`forecast.judge.status = unavailable`). `on` (default) applies it, `observe` records the judged forecast without filing it, `off` skips the calls. Scalar rounds only. MODEL is any Decisions-API model id on OpenRouter (needs OPENROUTER_API_KEY; without one there is no judge), or `decisions` for the MARINA_DECISIONS backend. Calls are metered like every decision (daily spend cap, spend ledger).
# MARINA_ARENA_PROPOSAL_JUDGE=on
# MARINA_ARENA_PROPOSAL_JUDGE_MODEL=typesafe/jev-1.13

# Require configured arena research to succeed before analysts run: refuse closed-book, empty/unverified evidence, failed research loops, and an enabled read swarm with no successful reader. Applies to formation +research and research: routes. Existing accepted submissions remain intact on refusal.
# MARINA_ARENA_RESEARCH_REQUIRED=off

# Structured data in arena research dossiers (default off; same spec as MARINA_FORECAST_LOOKUPS, odds excluded): prediction-market prices for every round, and an official series only where the round has a close relative (src/arena/research/data-evidence.ts). Read as of the brief's cutoff, headed as evidence of CHANGES only — the round's own history sets the level.
# MARINA_ARENA_RESEARCH_LOOKUPS=off

# Additional explanatory series for Civiqs economic/household/inflation questions: `consumer` adds FRED GASREGW and ICSA to the existing related series. `off` preserves the control. These are changes in other quantities, never replacements for the target poll level.
# MARINA_ARENA_RESEARCH_SIGNALS=off

# Formation lesson recall through the same judged pool as general forecasting. Default `observe` records available lessons without showing them to models; `on` injects them, `off` skips recall. MARINA_LESSONS still caps injection. Recall is bounded to min(now, lock), never a future lock date.
# MARINA_ARENA_FORMATION_LESSONS=observe

# Lesson recall for the `research:` forecaster, the same judged pool and modes as MARINA_ARENA_FORMATION_LESSONS: `observe` (default) records the recalled lessons on the forecast, `on` also shows them to the analysts before the dossier, `off` skips recall. Bounded to min(now, lock).
# MARINA_ARENA_RESEARCH_LESSONS=observe

# Record a candidate forecaster hourly in shadow, never filed (`bun run arena shadow score`).
# MARINA_ARENA_SHADOW=

# Model that proposes signals for `arena discover`. Unset: anthropic/claude-opus-5-5 with ANTHROPIC_API_KEY, else openrouter/anthropic/claude-opus-5.5 when OPENROUTER_API_KEY is the only key.
# MARINA_ARENA_PROPOSER=anthropic/claude-opus-5-5

# Rehearsal overrides for the arena endpoint, audience and data repository. Production is the default.
# MARINA_ARENA_URL=https://social-simulation-arena.com
# MARINA_ARENA_AUDIENCE=ssa-production-v1
# MARINA_ARENA_DATA_URL=https://raw.githubusercontent.com/Social-Atoms/social-sim-arena/main

# ── TabH2O ───────────────────────────────────────────────────────────────────

# H2O.ai's hosted tabular foundation model, used by `market forecast`. Without a key the connector is seeded but inactive. The endpoint override is for self-hosted deployments.
# TABH2O_API_KEY=
# TABH2O_ENDPOINT=https://tabh2o.h2oai.com/api/v1/predict

# ── Prediction markets ───────────────────────────────────────────────────────

# `true` allows live order placement (Kalshi only). `position` is paper trading by default.
# @protected
# MARINA_TRADING_ENABLED=false

# Kalshi credentials for live trading (the key is a UUID; the secret is a base64-encoded RSA private key in PEM form) and an API base override.
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

# Polymarket market-data base overrides (gamma for markets, CLOB for price history). Market data works; live Polymarket orders are not implemented.
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# Reserved Polymarket credentials. Live Polymarket orders are NOT supported (no CLOB order signing): with MARINA_TRADING_ENABLED=true and all four set, orders fail closed with an error and nothing is sent; otherwise orders are paper.
# @internal
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=

# ── Memory ───────────────────────────────────────────────────────────────────

# Per-owner admission budgets for durable memory (world and standalone service), aggregated across spaces: logical bytes, sources, revisions and spaces. Unlimited under the local profile unless set; the values shown are the shared/public defaults. Existing data is never evicted, and reads and forgetting keep working at the limit.
# MARINA_MEMORY_MAX_BYTES=1073741824
# MARINA_MEMORY_MAX_SOURCES=100000
# MARINA_MEMORY_MAX_REVISIONS=100000
# MARINA_MEMORY_MAX_SPACES=256

# Operator-owned JSON file of explicit memory federation mounts. Each entry binds a local principal to a peer URL and space, and names the environment variable holding the peer credential (see docs/guides/memory-service.md).
# @restart
# MARINA_MEMORY_FEDERATION_CONFIG=

# Optional model-directed memory plans. URL and model must both be set; unset gives deterministic, model-free plans.
# @restart
# MARINA_MEMORY_PLANNER_URL=http://127.0.0.1:3300/v1
# MARINA_MEMORY_PLANNER_MODEL=marina
# MARINA_MEMORY_PLANNER_TOKEN=

# Memory embeddings: none (lexical only), local (pinned MiniLM through the optional extensions/local-embeddings), ollama (an operator-run /api/embed with a model and an immutable revision) or openai (any OpenAI-compatible /v1/embeddings; URL, model and revision required; API_KEY falls back to OPENROUTER_API_KEY / OPENAI_API_KEY only for those vendors' hosts; DIMENSIONS requests a Matryoshka-truncated vector). Evidence-gated: run `bun run qualify:paraphrase` first.
# @restart
# MARINA_MEMORY_EMBEDDINGS=none
# MARINA_MEMORY_EMBEDDING_CACHE=data/memory-models
# MARINA_MEMORY_EMBEDDING_LOCAL_ONLY=false
# MARINA_MEMORY_EMBEDDING_URL=http://127.0.0.1:11434
# MARINA_MEMORY_EMBEDDING_MODEL=
# MARINA_MEMORY_EMBEDDING_REVISION=

# Memory embeddings over an OpenAI-compatible endpoint (MARINA_MEMORY_EMBEDDINGS=openai): the bearer key (unset falls back to OPENROUTER_API_KEY / OPENAI_API_KEY for those vendors' own hosts only) and an optional Matryoshka dimension count requested from the server.
# @protected
# @restart
# MARINA_MEMORY_EMBEDDING_API_KEY=
# MARINA_MEMORY_EMBEDDING_DIMENSIONS=

# Per-input cap for remote memory embeddings (ollama, openai), in estimated tokens (UTF-8 bytes / 3, rounded up): a longer record is cut to its head before it is embedded, and its index job is labelled `input_truncated`; a provider that still rejects an input as too long gets it once more at half the length. Default 8192; set it below the model's own context (e.g. 32768 for a 40,960-token embedder); 0 = no cap. The local MiniLM extension chunks its input itself.
# @restart
# MARINA_MEMORY_EMBEDDING_MAX_TOKENS=8192

# Outcome learning (src/learning/): every verdict — a benchmark run scored, a forecast resolved, a Code Mode verification, an arena round — becomes a candidate lesson that the decision layer judges (grounded, general, leak-free, consistent); passing lessons are served by recall in pools `lessons:<domain>`, rejected ones stay as audit records. `on` (default) learns and injects; `observe` learns and records what recall WOULD inject without injecting (the ablation arm); `off` neither learns nor recalls. A lesson is never visible to work whose cutoff precedes the outcome it came from.
# MARINA_LESSONS=on

# Model that writes a lesson's rule. `marina/default` (default) asks this Marina's own /v1, i.e. whatever model the operator runs, local included; a provider/model id uses that vendor (falling back to marina/default when its key is missing); `none` keeps mechanical lessons only. No vendor key is ever required.
# MARINA_LESSONS_WRITER=marina/default

# The judge when no decision backend is configured: a chat-classifier on this model through this Marina's /v1, uncalibrated (one cut at 0.5) and labelled as such on every lesson it passes. With no model reachable, lessons are recorded unverified and never promoted.
# MARINA_LESSONS_JUDGE_MODEL=marina/default

# Outcomes processed per hour (writer + judge calls are bounded by it); excess outcomes are dropped and counted.
# MARINA_LESSONS_MAX_PER_HOUR=120

# Cross-board lessons. A trusted lesson whose scope is not `case` (method, config, budget, calibration, retrieval, infra, model) and that the judge finds `transferable` is mirrored into `lessons:meta`; every surface that recalls lessons (forecasting, verify, crew routing, Code Mode, opted-in passthru and resident agents) also serves meta lessons within a third of its budget, labelled `cross-board <scope>`. `on` (default) mirrors and serves; `observe` mirrors and records the ids without injecting; `off` neither. Capped by MARINA_LESSONS. The time rule and the measurement self-exclusion (`x-marina-eval`) apply.
# MARINA_LESSONS_META=on

# Resident agents' continuation prompt: `on` adds a [Lessons] section for the agent's focus every tenth cycle (judged lessons from every domain, cross-board included, labelled); `observe` logs the lesson ids it would show; `off` never asks. Default `on` (a lexical recall, no model call). Capped by MARINA_LESSONS.
# MARINA_LESSONS_RESIDENT=on

# Lessons from Marina's own tool work (src/learning/work.ts): agent tool errors (autonomous or request-driven) followed by a corrected call, calls that kept failing, run tool budgets reached, decision-gate holds, argument-check flags, challenge answers, task verdicts and verifier bounces, Code Mode exec denials, and an opted-in passthru conversation's recoveries (`x-marina-learn: on` or the `learn` member of its instrument stack, MARINA_PASSTHRU_STACK; bound keys only) are aggregated per tool and error class; an hourly job turns each recurring pattern into ONE judged `tools` (or `code`) lesson through the same writer, judge, leak guard and admission as every other outcome (at most 20 per hour, stopped at the daily spend cap). Work done for a person goes to that person's own lesson spaces and is served only to its own requests and agents; only world agents' work feeds the shared pools. `x-marina-eval` measurement requests teach too (their signals carry an `eval:<benchmark>` ref; the leak guard keeps item text, ids and answers out); a short-lived process flushes at shutdown and parks patterns still below their floor (counts, tool names and error classes only, for up to a day) for the next process. `observe` collects and logs counts per source with no model call; `on` learns; `off` collects nothing. Unset: `on` when a model provider is configured, else `observe`. Capped by MARINA_LESSONS.
# MARINA_LESSONS_FROM_WORK=

# Obligations ledger for Marina's own agent loops (residents, crews, Code Mode coders; src/obligations/): each request an agent owes work on is read into explicit obligations (one call on the agent's own model), and a successful matching tool call settles them. `observe` queues requests and counts tool calls with no model call (MARINA_OBLIGATIONS_OBSERVE_SAMPLE samples extraction for measurement) and logs counts only; `on` extracts and also lists open obligations in the continuation prompt and sends one follow-up when a run would end with an obligation still open (at most once per obligation). `off` makes no call and changes nothing. Unset: `on` while an agent works a Code Mode task (coders, `marina -p`), `observe` otherwise. The /v1 passthru never reads this: a request opts in itself with the model prefix `marina/obligations:<model>` or the header `x-marina-obligations: on|observe`, or gets the ledger from its instrument stack (MARINA_PASSTHRU_STACK). Spend counts against the daily cap; at the cap the ledger stops calling.
# MARINA_OBLIGATIONS=

# Fraction (0-1) of an agent loop's `observe`-mode obligations refreshes and pre-write reviews that make their model calls (request extraction, ambiguous-match judging, the review). Default 0: `observe` is free — requests are queued and still reach the argument check's judge as stated lines, tool calls are counted, and no model is called, since nothing observed is shown to the agent. Set e.g. 0.1 to measure what `on` would do on a sample of cycles; a sampled cycle runs exactly as `on` does but shows nothing. `on` is unaffected; the /v1 passthru never reads this. Junk or negative is 0; values above 1 are 1. Read live.
# MARINA_OBLIGATIONS_OBSERVE_SAMPLE=0

# Model for the passthru obligations ledger's own calls (extracting obligations from new requests, resolving ambiguous matches, the final-reply check when no decision backend is configured). Unset: the request's own model, so one model is enough. Under an operator passthru pin the pinned model is used. Agents always use their own model.
# MARINA_OBLIGATIONS_MODEL=

# Consent handling in the obligations ledger (passthru and Marina's own agent loops). The extractor, in the same call it already makes per request, notes when a new request explicitly approves an open obligation as the assistant last described it. `observe` (default) only counts: the `consented` and `reasks` counters (a final reply that asks again about an approved item) in the obligations header and log line; the model sees nothing new. `on` also shows the approval on the listed obligations ("approved in request N") and treats a re-ask after approval as still owed, so the one-time final-reply nudge names it: act now unless something material changed, and if a required detail is still missing ask only for that. Never blocks or rewrites a call; at most one nudge per obligation, as for every obligation. Read live.
# MARINA_OBLIGATIONS_CONSENT=observe

# Pre-write review in the obligations ledger (passthru and Marina's own agent loops; src/obligations/review.ts). Before a reply's state-changing call runs, ONE judge call (the decision backend when configured, else the ledger's model) asks the yes/no questions that apply: order — with two or more open requests, would carrying this out now prevent another or change its terms (amounts, limits, eligibility, fees, availability)?; evidence — does the call rely on a condition (eligibility, status, a balance or limit, identity, a rule's requirement) that no recent tool result shows?; requested — only when the conversation holds requests (never for a self-directed agent): is it an action nobody asked for, approved, or that the rules require (an add-on, upgrade or alternative chosen unasked)?; permitted — only when rule passages that name the call exist (MARINA_OBLIGATIONS_REVIEW_RULE_BYTES): do those rules, applied to the conversation's facts, forbid it or require a step first? At most 4 reviews per conversation; each kind is named at most once. `auto` decides per conversation whether the task warrants the review: no requests and no rule text means no (no model call); otherwise ONE decision question (would a mistaken action on someone's behalf be costly or hard to undo, with rules or several requests constraining it?) — warranted acts as `on`, not warranted or unjudged stays out entirely. This value is a CEILING: a passthru client may choose a lower mode with the header `x-marina-review: off|observe|auto|on`, and an agent with the loop preference `memory set review off|observe|auto|on`; neither can exceed it. `observe` asks and counts (`reviews=` / `review_flags=` in the obligations header, per-kind counts in the log line); the reply is untouched. `on` (with the ledger itself `on`) gives named concerns ONE retry on the passthru, or a one-time refusal in agent loops (the same call issued again runs), with a note that names each concern and never a fix. A judge failure lets the call run. `off` makes no call. Default `auto`. Spend counts against the daily cap.
# MARINA_OBLIGATIONS_REVIEW=auto

# UTF-8 bytes of rule passages the pre-write review's `permitted` question may show (argcheck's lexical selection: passages of the instructions and of documents in the conversation that name the tool, its action or its arguments; reference text framed as data). `0` never asks `permitted`. Default 3000.
# MARINA_OBLIGATIONS_REVIEW_RULE_BYTES=3000

# Argument check before writes for Marina's own agent loops (src/obligations/argcheck.ts): before a `mutate` or `consequential` tool call runs, each id, amount, date and short option in its arguments is looked up in the conversation (user messages and tool results count; the agent's own text and the instructions do not). A write to the caller's own record (its memory, notes, journal, skills) leaves the writer's own descriptors unchecked (operation, tags, importance, tier, type, title, its claim, an idempotency key); its ids, spaces and targets are still checked. A call with a value found nowhere first-hand gets one yes/no judgement ("are these arguments supported by the conversation?") from the decision backend when one is configured, else one call on the agent's own model. `observe` checks and logs counts only; `on` also refuses an unsupported call once, with the values named, and the same call issued again runs (at most once per call signature; arguments are never rewritten). A judge failure lets the call run (fail open, labelled `unjudged`). `off` makes no call and changes nothing. Default `on` (with the `flagged` trigger, so a call whose values were all stated first-hand costs nothing). The /v1 passthru never reads this: a request opts in itself with the model prefix `marina/argcheck:<model>` (combinable with `marina/obligations:` and `marina/lessons:`) or the header `x-marina-argcheck: on|observe`, or gets the check from its instrument stack (MARINA_PASSTHRU_STACK). Spend counts against the daily cap.
# MARINA_ARGCHECK=on

# Model for the passthru argument check's judge when no decision backend is configured. Unset: MARINA_OBLIGATIONS_MODEL, else the request's own model. Under an operator passthru pin the pinned model is used. Agents always use their own model.
# MARINA_ARGCHECK_MODEL=

# Which write calls the argument check's judge sees, for agent loops and opted-in passthru requests alike. `flagged` (default): only a call whose mechanical pass found a value not stated by the user or returned by a tool. `all-writes`: every state-changing call, with the mechanical findings shown to the judge as a free pre-signal; it can catch a real value that is not the one the user meant (another account, another option among several), but in offline replays it also judged 13-20 % of correct writes unsupported (above the 10 % bar for a default), so it is for measurement and `observe`. Costs one judge call per write.
# MARINA_ARGCHECK_TRIGGER=flagged

# UTF-8 bytes of rule passages the argument check's judge sees per call, for agent loops and opted-in passthru requests alike: the sections of the instructions and of the documents the conversation read (tool results) that name the tool (for a generic dispatcher call, the tool it runs), its action words or its argument names, prose only, framed as untrusted reference data. 0 (default) shows none; a held-out replay at 3000 found no gain in recall net of false alarms, so it is opt-in. Capped at 16000.
# MARINA_ARGCHECK_RULE_BYTES=0

# The /v1 passthru instrument stack (src/net/model-api/stack.ts) on `/v1/chat/completions` and `/v1/messages`. `identified` (default): a caller with its own identity — a key bound to an entity (`secret:entity`), an authorized name-map, or any non-internal caller under the local trust profile — gets lessons recall, the obligations ledger (`on`), the argument check (`on`, MARINA_ARGCHECK_TRIGGER) and lessons from its work (bound keys; needs MARINA_LESSONS_FROM_WORK) without asking. Anonymous and shared callers (a plain key, the open-API sentinel outside the local profile) get nothing and stay byte-identical. `all`: every non-internal caller gets the default stack. `off`: nothing by default; requests still opt in. A request may name its own set with `x-marina-stack: full|none|<lessons,obligations,argcheck,verify,context,learn,ensemble>` or the model prefix `marina/full:<model>` (`full` never includes `ensemble`, which multiplies upstream calls; see MARINA_ENSEMBLE_SIZE); a listed member that cannot run is refused (400 `unsupported_parameter`), `full` runs what it can and reports the rest, and the response's `x-marina-stack` header records what ran. A per-instrument header (`x-marina-obligations: off`, `x-marina-lessons: off`, `x-marina-argcheck: off`, `x-marina-learn: off`) opts out of a default. Marina's own agents (internal token) never get the passthru stack: their loops use MARINA_OBLIGATIONS / MARINA_ARGCHECK. Without tools the ledger and the check make no call. Spend counts against the daily cap.
# MARINA_PASSTHRU_STACK=identified

# Proposers for the passthru `ensemble` stack member (src/net/model-api/ensemble.ts): `x-marina-stack: ensemble` drafts the turn this many times on the request's model (tools included), a checker (MARINA_VERIFY_CHECKER_MODEL, else the earned `verify:checker` slot, else the model itself) picks ONE whole draft by number, and only that draft is returned — drafts are never merged, unanimous drafts skip the checker, and a checker outage returns the first draft of the strict-majority group that shares its state-changing calls (else the first draft), labelled in `x-marina-ensemble`. `marina/ensemble:<a>,<b>[,…]` names a 2–5 model panel instead. Opt-in only (never in the default stack or `full`); usage and cost are summed across every call. Clamped to 2–5; default 3.
# MARINA_ENSEMBLE_SIZE=3

# Memory admission ranking (src/memory/admission.ts): each curated write (lessons and their cross-board mirrors) is compared with its 8 nearest existing records — lexical search, hybrid when MARINA_MEMORY_EMBEDDINGS is configured — and ranked by ONE numbers-only decision call (relation, novelty, generality, evidence_fit, value; evidence strength is mechanical). `off` (default): today's behaviour. `observe`: the rank and the proposed action are stored on the record; writes and serving are unchanged. `on`: duplicates merge into the existing record (support, refs), refinements supersede it, a contradiction of a trusted record opens a resolve case and holds the new record unserved, and recall orders by trust, then rank, then recency. Needs a configured decision backend (MARINA_DECISIONS / MARINA_DECISION_ENGINE); without one it behaves as off. An uncalibrated backend gets one cut at 0.5, merges also need mechanical similarity, and contradictions are never auto-resolved. Spend counts against the daily cap; at the cap writes proceed as off.
# MARINA_MEMORY_RANKING=off

# Memory relevance gate (src/memory/relevance-gate.ts): after retrieval and before memories are served, every unified-context surface (continuation prompt, `recall <q> all|evidence`, GET /mem/context, MCP think context, passthru injection) asks whether each retrieved item bears on the query and drops the ones that do not. `off` (default): no call, nothing changes. `observe`: items are scored and the would-be drops are reported in the context's `relevance` block; what is served is unchanged. `on`: irrelevant items are dropped, and when nothing relevant is left every render says "no relevant memory found" instead of serving keyword noise. Drop only (never rewritten or reordered), at most 8 positively judged items kept (unanswered items and negative model judgments of incomplete excerpts are preserved), `core` and pinned memory never judged or dropped. The judge is the decision layer (MARINA_DECISIONS / MARINA_DECISION_ENGINE) when configured; otherwise one model through this Marina's /v1 (MARINA_MEMORY_RELEVANCE_GATE_MODEL) scores each batch in one call, uncalibrated (one cut at 0.5). A backend outage, an incomplete reply or the daily spend cap serves the ungated set, labelled `fail_open`. Spend counts against the daily cap.
# MARINA_MEMORY_RELEVANCE_GATE=off

# The relevance gate's single-LLM fallback when no decision backend is configured: any model this Marina's /v1 serves (default `marina/default`, the operator's own model). `none` uses the mechanical floor instead: an item must contain at least 40 % of the query's distinct terms.
# MARINA_MEMORY_RELEVANCE_GATE_MODEL=marina/default

# How long the relevance gate waits for its model backend, in milliseconds (default 30000). Past it the gate fails open and serves the ungated set, labelled `fail_open` with reason `timeout`. The single-LLM fallback asks an OpenRouter-routed model not to reason (`reasoning: { enabled: false }`, or a low effort for a model whose upstream says reasoning is mandatory), so a reasoning-by-default model answers within the bound.
# MARINA_MEMORY_RELEVANCE_GATE_TIMEOUT_MS=30000

# Ingest-time memory notes (src/memory/ingest-notes.ts): when a long record (2 KB or more) is written or revised through the memory service (/v1/memory, resident memory, durableMemory.run) or a source is captured, a few concise derived notes are written beside it in the same space, by the same writer, each linked to its source (`depends_on`, or `source_ids` for a captured source) and labelled `derived: ingest-note`. Notes are grounded: a line whose names, numbers, dates or identifiers are not in the source is dropped; exact duplicates are skipped. Forgetting a source erases its notes; revising it stales them. Served context labels a note as derived and adds an excerpt of its source when budget is left. `off` (default): nothing changes. `on`: notes are written in the background after the write returns, never blocking or failing it. A write can opt in or out itself with `ingest_notes: true|false`. Spend counts against the daily cap; at the cap notes are skipped.
# MARINA_MEMORY_INGEST_NOTES=off

# The ingest-note writer: one call of this model per 12 KB chunk of the source, through this Marina's /v1 (default `marina/default`, the operator's own model). `none` uses the mechanical extractor instead (headed sections, final-state lines, numbered steps, the last line); a failing model also falls back to it, labelled.
# MARINA_MEMORY_INGEST_NOTES_MODEL=marina/default

# Durable record search for unified memory context: `lexical` (default, FTS5) or `hybrid` (lexical fused with the memory vector index; needs MARINA_MEMORY_EMBEDDINGS and an indexed space). A missing provider or an incomplete index answers lexically and is labelled `semantic_degraded` on the evidence tier, never an error. Evidence-gated: measure before enabling (`bun run qualify:paraphrase`).
# MARINA_MEMORY_CONTEXT_SEARCH=lexical
# Learned bundles (marina.learned.v1, docs/guides/learned-bundles.md): `on` lets an operator import a signed bundle with `bun run learned import`. Imported lessons land in `upstream:*` spaces with trust `imported` and are never trusted until local outcomes confirm them; defaults seed only empty slots; ledger aggregates become down-weighted priors, never ledger rows. `off` (default) refuses every import and nothing changes.
# MARINA_UPSTREAM=off

# Publisher keys a learned bundle or revocation list must be signed by: comma-separated `label=<base64 SPKI>` or bare base64 Ed25519 public keys, added to the keys pinned in source. A bundle signed by any other key is refused; the key embedded in a bundle is never trusted on its own.
# @protected
# MARINA_LEARNED_PUBLISHER_KEYS=

# Dedicated Ed25519 key that signs exported learned bundles (base64 PKCS#8 DER, or PEM with escaped newlines; `bun run learned keygen <path>` makes one). Never the federation or arena key. Read only by `bun run learned export` and `bun run learned entitle`.
# @protected
# @internal
# MARINA_LEARNED_SIGNING_KEY=

# ── Passthru and prompt caching ──────────────────────────────────────────────

# Comma-separated pool names shared with passthru (external OpenAI-SDK) callers. Empty shares none.
# MARINA_PASSTHRU_SHARED_POOLS=

# Bytes of memory context injected into a proxied request for an identified passthru caller (clamped 256–65536). The entity property passthruInjectBytes overrides it per key.
# MARINA_PASSTHRU_INJECT_BYTES=2048

# Exact-match response cache for identified passthru callers. `on` applies only under the local profile; elsewhere a caller opts in with the entity property passthruResponseCache. Streaming, tool-call and non-2xx responses are never cached.
# MARINA_PASSTHRU_RESPONSE_CACHE=off
# MARINA_PASSTHRU_RESPONSE_CACHE_TTL_MS=3600000

# Keep a passthru conversation's earlier trailing notes (memory context, lessons, the obligations reminder, a nudge) in place on later turns, so an OpenAI-compatible upstream sees an append-only prompt and its prompt cache (which reuses a whole earlier prompt) keeps hitting. Notes are remembered in process per caller under a hash of the history they followed; a note identical to the latest one already in the history is not repeated. Claude models (direct or through OpenRouter) keep their breakpoints instead. `off` places a fresh trailing note every turn.
# MARINA_PASSTHRU_STICKY_NOTES=on

# Place ephemeral cache breakpoints on Anthropic passthru requests (direct, or anthropic/* via OpenRouter): the stable system block, the memory block, the last tool and a rolling breakpoint on the latest message, within Anthropic's limit of four. A client that sets its own markers keeps them and gets at most the stable-system breakpoint. Default true under the local profile, false otherwise.
# MARINA_ANTHROPIC_AUTO_CACHE=false

# `marina/verify:<proposer>[+<checker>]` model ids: the checker used when the id names none. Default: the proposer reviews its own draft.
# MARINA_VERIFY_CHECKER_MODEL=openai/gpt-6.1-sol

# `marina/verify:` revision rounds after a flagged draft (0 = review only and return the draft; max 3). Default 1.
# MARINA_VERIFY_ROUNDS=1

# `marina/verify:` drafts the checker reviews. `consequential` reviews every draft except one whose tool calls are all read-only lookups (the shared read/write classifier; an unplaced tool counts as a write), which goes out with `x-marina-verify: skipped-read-only`; `all` reviews every draft. Default consequential.
# MARINA_VERIFY_REVIEW=consequential

# `marina/verify:` checker reasoning effort. `inherit` copies the caller's own effort (`reasoning_effort`, `reasoning`, `thinking`, top level or inside a literal `extra_body`); `low`/`medium`/`high` send that `reasoning_effort`; `off` sends none (the checker model's default, no thinking for Claude). The upstream layer translates it per provider. Default inherit.
# MARINA_VERIFY_CHECKER_EFFORT=inherit

# Vision model for `canvas look` / `image describe` / `video describe` / `marina_see` when the agent's own model cannot read images. Unset: the agent's model, else Marina's default route.
# MARINA_VISION_MODEL=openai/gpt-6.1-sol

# Asset derivatives (thumbnails, video posters, PDF previews; src/engine/media/asset-library.ts). `on` (default) makes them in the background, one at a time; `sync` makes them before an upload returns (tests, short-lived scripts); `off` never starts `sharp`, `ffmpeg` or `pdftoppm` for assets (hashes and header dimensions are still recorded, and the backfill leaves derivatives for a later pass).
# MARINA_ASSET_DERIVATIVES=on

# Memory over media (src/engine/media/asset-memory.ts): text that describes or is inside an asset becomes canonical memory records in the asset owner's own memory, cited as `asset:<id>`, so `recall … all` and the agent's context find files by what they say. `text` (default) indexes the text an asset already has — caption, alt text, tags, generation prompt, PDF text via `pdftotext`, stored transcripts and OCR — with no model call; `vision` also asks a vision model once per raster image for a suggested caption and the text in it (spend recorded and capped by the daily spend cap, at most 1 call per pass and 60 per hour); `off` indexes nothing (records of deleted assets are still retired). Runs in the background asset job and reads only assets changed since the last pass; external tools follow MARINA_ASSET_DERIVATIVES.
# MARINA_MEDIA_MEMORY=text

# Byte cap on an image, PDF, video or text a vision call will load (max 100 MB). Default 20 MB.
# MARINA_VISION_MAX_BYTES=20971520

# How agents see images: `native` returns the image itself in the tool result for the agent's own model; `describe` asks a vision model for a text description (MARINA_VISION_MODEL); `auto` (default) is native when the agent's model accepts image input (for marina/default: its current upstream) and describe otherwise.
# MARINA_AGENT_VISION=auto

# Images kept in an agent's live transcript after native looks (1-32, default 4); older ones become a one-line placeholder the agent can reopen with marina_see. Image bytes are never journaled.
# MARINA_AGENT_VISION_MAX_IMAGES=4

# Comma-separated drop-in compatibility profiles whose model-id aliases appear in /v1/models (`openai` exposes `assistant`). Default all; `none` disables.
# MARINA_COMPAT=openai

# ── HTTP hardening ───────────────────────────────────────────────────────────

# Request body ceiling for JSON routes (enforced per route; pre-auth and key-management routes use a 64 KiB cap), and the separate cap on one asset upload (uploads are MIME-allowlisted and magic-byte checked).
# @restart
# MARINA_MAX_REQUEST_BODY_BYTES=8388608
# MARINA_MAX_UPLOAD_BYTES=52428800

# Deadline in milliseconds for one proxied upstream model call (response headers for a stream, the whole reply otherwise). A non-streaming call is also aborted when its client disconnects.
# MARINA_UPSTREAM_TIMEOUT_MS=300000

# While a first-party key (Anthropic, OpenAI, Google, xAI, Mistral, DeepSeek) reports a usage/quota limit, serve the SAME model via OpenRouter when OPENROUTER_API_KEY is set and OpenRouter's catalog lists it (labelled openrouter-served; back to the direct key when the limit lifts). Never a different model. `off` keeps the caller paused/refused until the reset instead. Default on.
# MARINA_PROVIDER_FALLBACK=on

# MCP session creations and login/auth tool calls per client IP per minute. 0 disables.
# MARINA_MCP_SESSIONS_PER_MIN=10

# Extra Host header values /mcp accepts (DNS-rebinding protection; validation is never off). Unset on a non-loopback bind: only loopback names, a specific bind address, the machine hostname and the BETTER_AUTH_URL / ALLOWED_ORIGINS hosts. List LAN IPs or other names clients use here.
# @protected
# MARINA_MCP_ALLOWED_HOSTS=mcp.example.com

# `true` lets outbound fetches proceed when DNS resolution fails, instead of refusing them (fail open). Only for restricted-DNS environments.
# @protected
# MARINA_URL_GUARD_DNS_FAIL_OPEN=false

# ── Schedules ────────────────────────────────────────────────────────────────

# Run due schedules (`schedule add …`: an owner's own command later or on a repeat,
# as that owner with its rank, gates and spend caps). `off` keeps schedules stored
# but never runs them. Default on.
# MARINA_SCHEDULES=on
# Most schedules one account may hold (0 = unlimited).
# MARINA_SCHEDULES_PER_ENTITY=20
# Shortest repeat a schedule may use (`every:` / `daily:`), as a duration.
# MARINA_SCHEDULE_MIN_INTERVAL=1m

# ── Retention ────────────────────────────────────────────────────────────────

# Override row-retention windows: comma-separated table=<duration|rows|0>, durations in s/m/h/d/w, a bare integer is a row count, 0 never prunes. Per-class defaults and the table list live in src/engine/retention.ts (Admin → Ops shows them); append-only tables can never be pruned.
# MARINA_RETENTION_OVERRIDES=primitive_usage=30d,feed_events=0

# Durable event_log rows kept (pruned hourly; clamped 10000–10000000).
# MARINA_EVENT_RETENTION=100000

# Structured application log rows kept in SQLite (maximum 1000000).
# @restart
# MARINA_LOG_RETENTION=10000

# ── Logging and OpenTelemetry ────────────────────────────────────────────────

# Console lines allowed per minute for one repeated message (same level, category and message, digits ignored); past it one summary line says how many were not printed. Only stdout/stderr (the journal) is limited — the SQLite log store and OpenTelemetry receive every entry. `0` or `off` prints every line.
# MARINA_LOG_REPEAT_LIMIT=10

# Log format (text or json) and minimum level (debug, info, warn, error; case-insensitive — an invalid level warns once and uses info).
# @restart
# LOG_FORMAT=text
# LOG_LEVEL=info

# `true` pushes completed structural spans to an OTLP/HTTP JSON collector. Prompts, outputs, tool arguments and credentials are excluded; a collector outage never blocks agents.
# @restart
# MARINA_OTLP_ENABLED=false

# `true` pushes logs over OTLP/HTTP JSON, independently of traces.
# @restart
# MARINA_OTLP_LOGS_ENABLED=false

# Shared OTLP base endpoint (Marina appends /v1/traces or /v1/logs), headers (comma-separated, percent-encoded key=value, never displayed), timeout (default 10s, clamped 100ms–60s) and protocol (only http/json is supported). Each has a per-signal OTEL_EXPORTER_OTLP_TRACES_* or OTEL_EXPORTER_OTLP_LOGS_* variant that wins; per-signal endpoints are used exactly as written.
# @restart
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TIMEOUT=10s
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=

# Resource identity attached to exported spans and logs.
# @restart
# OTEL_SERVICE_NAME=marina
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.namespace=my-team

# `true` allows a plaintext (http) collector on a non-loopback host.
# @protected
# @restart
# MARINA_OTLP_ALLOW_INSECURE=false

# Export batching: trace batch delay, log batch delay and log queue size.
# @restart
# MARINA_OTLP_BATCH_DELAY_MS=2000
# MARINA_OTLP_LOGS_BATCH_DELAY_MS=2000
# MARINA_OTLP_LOGS_MAX_QUEUE=2000

# ── Extensions ───────────────────────────────────────────────────────────────

# Comma-separated directories of trusted host extensions, each containing a marina-plugin.json (docs/guides/extending.md). Nothing is downloaded; empty loads none.
# @protected
# @restart
# MARINA_PLUGINS=./plugins/hello

# ── World Collective ─────────────────────────────────────────────────────────

# How long a child world may take to come up, in milliseconds (minimum 1000; the first boot applies every migration).
# MARINA_COLLECTIVE_START_TIMEOUT_MS=30000

# ── Command-line clients ─────────────────────────────────────────────────────

# Server URL for `marina connect`, `marina status`, the ACP bridge (scripts/acp.ts) and the routing CLIs. Read by those clients, not the server.
# @internal
# MARINA_URL=ws://localhost:3300

# Bearer token `marina status` and the routing CLIs send. Unset reuses the newest cached `marina connect` session for MARINA_URL.
# @internal
# MARINA_TOKEN=

# Folder launcher (`marina [dir]`, `bun run code`): `1` uses a throwaway database deleted on exit (same as --fresh) instead of ~/.marina/projects/<slug>/marina.db, and the one-shot `marina -p` timeout in milliseconds (on timeout it sends `code stop` and exits 2).
# @internal
# MARINA_CODE_FRESH=
# MARINA_CODE_TASK_TIMEOUT_MS=600000

# The one-shot `marina -p` verification requirement when --verification is not given: checks (the project's own checks), candidate (a Git snapshot) or delivery (default: each stated requirement mapped to a check that observes it, else the run is reported unverified).
# @internal
# MARINA_CODE_VERIFICATION=delivery

# ── Set by Marina (do not set) ───────────────────────────────────────────────

# The local profile's generated model-API key, loaded from <DB_PATH>.local-api-key at boot; ignored and dropped under shared/public. It also opens /mem with an X-Agent-Name header. Do not set it yourself.
# @internal
# @protected
# MARINA_LOCAL_API_KEY=

# Marks a World Collective child world, which lets `evolve trial` run there. Set by the collective manager; setting it on a parent world bypasses the trial fence.
# @internal
# @protected
# MARINA_COLLECTIVE_CHILD=
