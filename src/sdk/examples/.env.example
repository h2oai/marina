# ═══════════════════════════════════════════════════════════════════════════
# SDK example knobs (src/sdk/examples/*.ts)
#
# Read by the runnable examples, each its own process
# (`bun run src/sdk/examples/<name>.ts`), never by the Marina server. Export
# the ones you need in the example's shell or pass them inline. See README.md
# in this directory. Everything is optional except MARINA_MODEL for
# translator.ts.
#
# `marina:<name>` ids (marina:haiku, marina:sonnet, …) are model channels
# served by a provider crew you run yourself (for example provider.ts or
# translator.ts); nothing serves them out of the box. `NSED_*` names are the
# legacy spelling of the ensemble knobs; `ENSEMBLE_*` wins when both are set.
# ═══════════════════════════════════════════════════════════════════════════

# Shared by most examples
# WS_URL=ws://localhost:3300                 # Marina WebSocket the example logs into
# MARINA_ENDPOINT=http://localhost:3300      # Marina HTTP base (model API, /v1)
# MODEL_CHANNEL=model                        # channel the provider serves model_request on
# AGENT_NAME=<per-example default>           # in-world login name (Provider, Greeter, Explorer, …)
# COMMAND_DRAIN_MS=2500                      # ms to wait for command output before replying (blackboard 2500, ensemble-smart 2000)
# POLL_INTERVAL_MS=1500                      # task/queue poll cadence (task-worker 1500, world-coordinator 2000)
# PROJECT_NAME=benchmark-pursuit             # project the task-worker / coordinator / world-setup examples operate on
# SYSTEM_PROMPT=                             # extra system prompt for provider.ts / smart-provider.ts
#
# adaptive-provider.ts — council-then-escalate answering
# ADAPTIVE_COUNCIL=marina:haiku,marina:qwen,marina:gemma,marina:kimi   # council substrates (comma list)
# ADAPTIVE_TEMPS=0,0,0,0                     # per-council-member temperatures (defaults to 0 each)
# ADAPTIVE_STRONG=marina:sonnet              # escalation model when council agreement is low
# ADAPTIVE_THRESHOLD=0.75                    # agreement ratio below which the strong model is consulted
# ADAPTIVE_TRACE=false                       # true = verbose per-request trace on stderr
#
# benchmark-preflight.ts — sample a benchmark before a full run
# PREFLIGHT_MODEL=marina:gemini              # substrate to preflight
# PREFLIGHT_SAMPLE=5                         # items sampled per benchmark
# SEED=42                                    # sampling seed
#
# blackboard-provider.ts — shared-workspace roles + judge
# BLACKBOARD_ROLES=marina:haiku@scholar,marina:qwen@skeptic,marina:gemma@calculator,marina:kimi@domain   # substrate@role list
# BLACKBOARD_JUDGE=marina:haiku              # model that reads the board and writes the final answer
# BLACKBOARD_POOL_PREFIX=bench-q-            # pool name prefix for per-question blackboards
# BLACKBOARD_TEMPERATURE=0                   # sampling temperature for every role
# BLACKBOARD_TRACE=false
#
# debate-provider.ts — two proposers + judge
# DEBATE_PROPOSER_A=marina:haiku
# DEBATE_PROPOSER_B=marina:qwen
# DEBATE_JUDGE=marina:sonnet
# DEBATE_TEMPERATURE=0
# DEBATE_TRACE=false
#
# ensemble-provider.ts / ensemble-smart-provider.ts — deliberation/ensemble (legacy "NSED")
# ENSEMBLE_SUBSTRATES=marina:haiku,marina:haiku,marina:haiku,marina:haiku   # ensemble members (legacy: NSED_SUBSTRATES)
# ENSEMBLE_TEMPERATURES=0,0,0,0              # per-member temperatures (legacy: NSED_TEMPERATURES)
# ENSEMBLE_TRACE=false                       # legacy: NSED_TRACE
# NSED_SUBSTRATES=                           # legacy name for ENSEMBLE_SUBSTRATES — still honored
# NSED_TEMPERATURES=                         # legacy name for ENSEMBLE_TEMPERATURES — still honored
# NSED_TRACE=                                # legacy name for ENSEMBLE_TRACE — still honored
#
# ensemble-smart-provider.ts / smart-provider.ts / translator.ts — memory-aware providers
# MEMORY_LEARN=true                          # false = do not write reflections back to memory
# MEMORY_MAX_BYTES=6000                      # recalled-memory byte budget per request (translator: 2000)
# MEMORY_POOLS=                              # comma list of pools to recall from (empty = own notes only)
# MEMORY_MODE=reflect                        # smart-provider learning mode: reflect | qa
# MEMORY_TOPK=200                            # smart-provider recall candidates before ranking
# MEMORY_TRACE=false                         # log recalled memory per request
# REFLECTION_PROVIDER_URL=http://localhost:3300/v1   # OpenAI-compatible endpoint used to write reflections
# REFLECTION_PROVIDER_MODEL=marina:haiku     # model that writes reflections
# USE_TRANSLATOR=true                        # false = answer without the translator crew
# TRANSLATOR_CHANNEL=translator              # channel the translator listens on (synthesis: empty = off)
# TRANSLATOR_TIMEOUT_MS=8000                 # wait for a translator reply (synthesis: 15000)
#
# evolver.ts — self-evolving agent loop
# ADVISOR=                                   # entity name to consult each cycle (empty = none)
# CYCLE_SECS=60                              # seconds between evolution cycles
#
# foundry-provider.ts — worker/reviewer merge gate
# FOUNDRY_WORKER=marina:sonnet
# FOUNDRY_REVIEWER=marina:haiku
# FOUNDRY_MAX_ROUNDS=2                       # review rounds before the gate gives up
# FOUNDRY_TEMPERATURE=0
# FOUNDRY_TRACE=false
#
# meta-agent.ts — meta-level orchestration
# META_MODEL=marina:gemini                   # primary model
# META_MODEL_FALLBACK=marina:sonnet          # used when the primary fails
#
# pipeline-provider.ts — parse → reason → verify stages
# PIPELINE_PARSE=marina:haiku
# PIPELINE_REASON=marina:sonnet
# PIPELINE_VERIFY=marina:haiku
# PIPELINE_TEMPERATURE=0
# PIPELINE_TRACE=false
#
# provider.ts / smart-provider.ts — bridge an external OpenAI/Ollama-compatible LLM into a channel
# PROVIDER_URL=http://localhost:11434/v1     # upstream base URL (Ollama default)
# PROVIDER_MODEL=llama3                      # upstream model id
# PROVIDER_KEY=                              # upstream bearer key (empty for local Ollama)
# PROVIDER_FORMAT=openai                     # upstream wire format
#
# seed-pools.ts — seed domain knowledge pools
# SEED_MODEL=marina:sonnet                   # model that writes seed notes
# SEED_PER_DOMAIN=50                         # notes per domain
# SEED_POOL_PREFIX=seed:                     # pool name prefix (seed:math, seed:law, …)
# SEED_DOMAINS=                              # comma list of domain names (empty = built-in eight)
#
# spawner.ts
# BASE_URL=http://localhost:3300             # Marina HTTP base
#
# synthesis-provider.ts — council + strong-model synthesis with tools
# SYNTH_COUNCIL=marina:haiku,marina:qwen,marina:gemma
# SYNTH_STRONG=marina:gemini                 # synthesiser / escalation model
# SYNTH_CLASSIFIER=                          # optional question-classifier model (empty = heuristics)
# SYNTH_ESCALATE_T=0.75                      # council agreement below which the strong model answers
# SYNTH_CALCULATOR=true                      # false = disable the calculator tool
# SYNTH_CALCULATOR_TIMEOUT_MS=12000
# SYNTH_USE_WEB=true                         # false = disable web evidence
# SYNTH_MEMORY_MAX=8000                      # recalled-memory byte budget
# SYNTH_POOLS=seed:math,seed:law,…           # pools to recall from (default: seed:* + benchmark:* pools)
# SYNTH_TRACE=false
#
# task-worker.ts — claims and works project tasks
# WORKER_NAME=Worker1
# WORKER_SUBSTRATE=marina:haiku              # model the worker answers with
# WORKER_TRACE=false
# CLAIM_COOLDOWN_MS=500                      # pause after a claim before the next poll
#
# translator.ts — per-model translator crew member
# MARINA_MODEL=                              # REQUIRED — substrate to serve (marina:haiku, marina:gemini, …)
#
# world-coordinator-provider.ts — dispatches to workers, falls back to a model
# FALLBACK_SUBSTRATE=marina:sonnet           # answers when no worker replies within WORKER_TIMEOUT_MS
# WORKER_TIMEOUT_MS=60000
# COORDINATOR_TRACE=false
#
# world-setup.ts — seeds a benchmark world
# AGENT_COUNT=5                              # agents to spawn
# AGENT_MODELS=marina:haiku,marina:qwen,marina:deepseek,marina:gemini,marina:sonnet   # cycled across the agents
# SKIP_AGENTS=false                          # true = pools only
# SKIP_POOLS=false                           # true = agents only
