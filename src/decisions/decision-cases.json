  "route": {
    "routes": {
      "cheap": {
        "model": "openai/gpt-6-luna",
        "criteria": "Direct lookups, extraction and localized changes."
      },
      "coder": {
        "model": "anthropic/claude-sonnet-5",
        "criteria": "Writing or reviewing code across several files."
      },
      "powerful": {
        "model": "anthropic/claude-opus-5-5",
        "criteria": "Architecture, unclear failures and high-stakes decisions."
      }
    },
    "cases": [
      {
        "id": "readme",
        "goal": "Read the README and list the commands it mentions",
        "expect": "cheap"
      },
      {
        "id": "extract",
        "goal": "Pull the release date out of CHANGELOG.md",
        "expect": "cheap"
      },
      {
        "id": "typo",
        "goal": "Fix the typo in the help text of the look command",
        "expect": "cheap"
      },
      {
        "id": "tests",
        "goal": "Add unit tests for the task manager and fix the flaky ones",
        "expect": "coder"
      },
      {
        "id": "refactor",
        "goal": "Refactor the retention module into smaller files and update its imports",
        "expect": "coder"
      },
      {
        "id": "review",
        "goal": "Review the open pull request that changes the model API routing",
        "expect": "coder"
      },
      {
        "id": "intermittent",
        "goal": "Figure out why agents intermittently stop answering model requests and redesign the fix",
        "expect": "powerful"
      },
      {
        "id": "architecture",
        "goal": "Design how Marina should federate memory across instances with conflicting writes",
        "expect": "powerful"
      },
      {
        "id": "security",
        "goal": "Decide whether to expose the dashboard publicly and what must change first",
        "expect": "powerful"
      }
    ]
  }
}
