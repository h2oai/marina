# Memory-service example agents (examples/memory-service/*)
#
# Read by these example clients (and scripts/memory-mcp.ts), never by the
# Marina server. The qualification harnesses (scripts/qualify-memory-*.ts)
# provision temporary credentials and set them for you; set them yourself to
# point an example at your own memory service. See
# docs/guides/memory-service.md.

# Memory service base URL, a scoped credential, and the space to work in.
# MARINA_MEMORY_URL=http://127.0.0.1:3301
# MARINA_MEMORY_TOKEN=
# MARINA_MEMORY_SPACE=

# agent.py: `1` asks for hybrid (semantic) retrieval.
# MARINA_MEMORY_SEMANTIC=0

# workflow-agent.ts: optionally also join a resident world as this entity, so
# the continuity journal goes through the platform memory backend.
# MARINA_RESIDENT_URL=ws://localhost:3300
# MARINA_RESIDENT_NAME=

# Set by the qualification harness for a run, not by hand:
# MARINA_MEMORY_CYCLE / MARINA_MEMORY_PHASE (reliability-agent.ts) and
# MARINA_EVAL_CONDITION, MARINA_EVAL_MODEL, MARINA_EVAL_ROUTER_URL,
# MARINA_EVAL_ROUTER_TOKEN, MARINA_EVAL_AGENT_PROTOCOL and
# MARINA_EVAL_TOKEN_PARAMETER (task-agent.ts, workflow-agent.ts).
